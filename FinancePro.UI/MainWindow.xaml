<Window x:Class="FinancePro.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FinancePro ERP"
        Width="1440" Height="900"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/Images/logo.png"
        Background="#F4F7FB"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBrush" Color="#0B3B74"/>
        <SolidColorBrush x:Key="SidebarDarkBrush" Color="#0B3B74"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2F6FED"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>

        <Style x:Key="ItemNav" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EAF2FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="#1B5B9D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="#2F6FED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NavDisabled" TargetType="Border">
            <Setter Property="Margin" Value="10,1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Opacity" Value="0.42"/>
        </Style>

        <Style x:Key="TopIconButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DCE9FA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1B5B9D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="66"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Grid.RowSpan="3" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="74"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="84"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" Padding="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Resources/Images/logo-icon-transparent.png" Width="38" Height="38" Stretch="Uniform" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FinancePro" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock Text="ERP" Foreground="#67B7FF" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,0,12">
                        <Button x:Name="BtnDashboard" Style="{StaticResource ItemNav}" Click="Dashboard_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/><TextBlock Text="Dashboard" Style="{StaticResource NavText}"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnEmpresas" Style="{StaticResource ItemNav}" Click="Empresas_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE731;" Style="{StaticResource NavIcon}"/><TextBlock Text="Empresas" Style="{StaticResource NavText}"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnParceiros" Style="{StaticResource ItemNav}" Click="Parceiros_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" Style="{StaticResource NavIcon}"/><TextBlock Text="Clientes e Fornecedores" Style="{StaticResource NavText}"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnExercicios" Style="{StaticResource ItemNav}" Click="Exercicios_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" Style="{StaticResource NavIcon}"/><TextBlock Text="Exercícios Financeiros" Style="{StaticResource NavText}"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnMoedas" Style="{StaticResource ItemNav}" Click="Moedas_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C1;" Style="{StaticResource NavIcon}"/><TextBlock Text="Moedas" Style="{StaticResource NavText}"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnUtilizadores" Style="{StaticResource ItemNav}" Click="Utilizadores_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" Style="{StaticResource NavIcon}"/><TextBlock Text="Utilizadores" Style="{StaticResource NavText}"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnPerfis" Style="{StaticResource ItemNav}" Click="Perfis_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D7;" Style="{StaticResource NavIcon}"/><TextBlock Text="Perfis de Acesso" Style="{StaticResource NavText}"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnPermissoes" Style="{StaticResource ItemNav}" Click="Permissoes_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" Style="{StaticResource NavIcon}"/><TextBlock Text="Permissões" Style="{StaticResource NavText}"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnCaixa" Style="{StaticResource ItemNav}" Click="Caixa_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C7;" Style="{StaticResource NavIcon}"/><TextBlock Text="Caixa" Style="{StaticResource NavText}"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnBancos" Style="{StaticResource ItemNav}" Click="Bancos_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE825;" Style="{StaticResource NavIcon}"/><TextBlock Text="Bancos" Style="{StaticResource NavText}"/></StackPanel>
                        </Button>

                        <Border Height="1" Background="#2B6091" Margin="18,8"/>

                        <Button x:Name="BtnOrcamento" Style="{StaticResource ItemNav}" Click="Orcamento_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" Style="{StaticResource NavIcon}"/><TextBlock Text="Gestão Orçamental" Style="{StaticResource NavText}"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnTesouraria" Style="{StaticResource ItemNav}" Click="Tesouraria_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" Style="{StaticResource NavIcon}"/><TextBlock Text="Tesouraria" Style="{StaticResource NavText}"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnReceitas" Style="{StaticResource ItemNav}" Click="Receitas_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74A;" Style="{StaticResource NavIcon}"/><TextBlock Text="Receitas" Style="{StaticResource NavText}"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnDespesas" Style="{StaticResource ItemNav}" Click="Despesas_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74B;" Style="{StaticResource NavIcon}"/><TextBlock Text="Despesas" Style="{StaticResource NavText}"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnCompras" Style="{StaticResource ItemNav}" Click="Compras_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BF;" Style="{StaticResource NavIcon}"/><TextBlock Text="Compras" Style="{StaticResource NavText}"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnBens" Style="{StaticResource ItemNav}" Click="Bens_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE821;" Style="{StaticResource NavIcon}"/><TextBlock Text="Gestão Patrimonial" Style="{StaticResource NavText}"/></StackPanel>
                        </Button>

                        <Border Style="{StaticResource NavDisabled}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" Style="{StaticResource NavIcon}"/><TextBlock Text="Stocks" Style="{StaticResource NavText}"/></StackPanel></Border>
                        <Border Style="{StaticResource NavDisabled}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}"/><TextBlock Text="Investimentos" Style="{StaticResource NavText}"/></StackPanel></Border>
                        <Border Style="{StaticResource NavDisabled}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" Style="{StaticResource NavIcon}"/><TextBlock Text="Recursos Humanos" Style="{StaticResource NavText}"/></StackPanel></Border>
                        <Button x:Name="BtnContabilidade" Style="{StaticResource ItemNav}" Click="Contabilidade_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D4;" Style="{StaticResource NavIcon}"/><TextBlock Text="Contabilidade" Style="{StaticResource NavText}"/></StackPanel></Button>
                        <Border Style="{StaticResource NavDisabled}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" Style="{StaticResource NavIcon}"/><TextBlock Text="Demonstrações Financeiras" Style="{StaticResource NavText}"/></StackPanel></Border>
                        <Button x:Name="BtnRelatorios" Style="{StaticResource ItemNav}" Click="Relatorios_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9F9;" Style="{StaticResource NavIcon}"/><TextBlock Text="Relatórios" Style="{StaticResource NavText}"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnDocumentos" Style="{StaticResource ItemNav}" Click="Documentos_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource NavIcon}"/><TextBlock Text="Documentos" Style="{StaticResource NavText}"/></StackPanel>
                        </Button>
                        <Border Style="{StaticResource NavDisabled}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}"/><TextBlock Text="Auditoria" Style="{StaticResource NavText}"/></StackPanel></Border>

                        <Border Height="1" Background="#2B6091" Margin="18,8"/>
                        <Button x:Name="BtnWorkflow" Style="{StaticResource ItemNav}" Click="Workflow_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D7;" Style="{StaticResource NavIcon}"/><TextBlock Text="Centro de Tarefas" Style="{StaticResource NavText}"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnConfiguracoes" Style="{StaticResource ItemNav}" Click="Configuracoes_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/><TextBlock Text="Configurações" Style="{StaticResource NavText}"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnAdministracao" Style="{StaticResource ItemNav}" Click="Administracao_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" Style="{StaticResource NavIcon}"/><TextBlock Text="Administração" Style="{StaticResource NavText}"/></StackPanel></Button>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Margin="12" Background="#164E84" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Regulo, Lda" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Exercício 2026" Foreground="#CDE3FA" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Topbar -->
        <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource SidebarBrush}" BorderBrush="#0D4D8F" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource TopIconButton}" Content="&#xE700;" ToolTip="Menu"/>
                <Border Grid.Column="1" Width="320" Height="38" HorizontalAlignment="Center" Background="#123F73" BorderBrush="#35679A" BorderThickness="1" CornerRadius="9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#BFD3EA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White" VerticalContentAlignment="Center" FontSize="12" ToolTip="Pesquisa global"/>
                        <TextBlock Grid.Column="2" Text="Ctrl + K" Foreground="#9EB9D7" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TopIconButton}" Content="&#xE7ED;" ToolTip="Notificações"/>
                    <Button Style="{StaticResource TopIconButton}" Content="&#xE897;" ToolTip="Ajuda"/>
                    <Button x:Name="BtnTema" Style="{StaticResource TopIconButton}" Content="&#xE706;" Click="Tema_Click" ToolTip="Alternar tema"/>
                    <Border Width="34" Height="34" Background="#E4D8FF" CornerRadius="17" Margin="10,0,8,0">
                        <TextBlock Text="Z" Foreground="#5B21B6" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="UsuarioTexto" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Sessão ativa" Foreground="#AFC9E5" FontSize="10"/>
                    </StackPanel>
                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" Foreground="#DCE9FA" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Border Grid.Column="1" Grid.Row="1" Background="#F4F7FB">
            <ContentControl x:Name="ConteudoHost"/>
        </Border>

        <!-- Statusbar -->
        <Border Grid.Column="1" Grid.Row="2" Background="White" BorderBrush="#DCE5EF" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Servidor: (local)\SQLEXPRESS" Foreground="#475569" FontSize="10"/>
                    <Ellipse Width="7" Height="7" Fill="#22C55E" Margin="24,0,6,0"/>
                    <TextBlock Text="Base de dados ligada" Foreground="#475569" FontSize="10"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Versão 0.2.0" Foreground="#64748B" FontSize="10" Margin="0,0,24,0"/>
                    <TextBlock Text="© 2026 Zemael Jacinto da Silva. Todos os direitos reservados." Foreground="#64748B" FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
