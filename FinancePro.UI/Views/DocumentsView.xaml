<UserControl x:Class="FinancePro.UI.Views.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource FP.Page}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="24,20,24,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="FinancePro  ›  Motor de Documentos" Foreground="{DynamicResource FP.TextMuted}" FontSize="11"/>
                <TextBlock Text="Motor de Documentos" Style="{StaticResource FP.PageTitle}" Margin="0,8,0,0"/>
                <TextBlock Text="Gere documentos institucionais a partir de modelos padronizados." Style="{StaticResource FP.PageSubtitle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Limpar" Command="{Binding ClearCommand}" Style="{StaticResource FP.SecondaryButton}" Margin="0,0,8,0"/>
                <Button Content="Exportar TXT" Command="{Binding ExportTextCommand}" Style="{StaticResource FP.SecondaryButton}" Margin="0,0,8,0"/>
                <Button Content="Exportar HTML" Command="{Binding ExportHtmlCommand}" Style="{StaticResource FP.PrimaryButton}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,0,24,24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource FP.Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Modelo" FontWeight="SemiBold" Foreground="{DynamicResource TealDarkBrush}"/>
                        <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" Margin="0,7,0,6"/>
                        <TextBlock Text="{Binding TemplateDescription}" Foreground="{DynamicResource FP.TextMuted}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <Border Background="{DynamicResource FP.AccentSoft}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <TextBlock Text="{Binding FieldCount, StringFormat=Campos do modelo: {0}}" Foreground="{DynamicResource FP.Accent}" FontWeight="SemiBold"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource FP.Text}" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" Padding="9,6" TextWrapping="Wrap" AcceptsReturn="True"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Gerar documento" Command="{Binding GenerateCommand}" Style="{StaticResource FP.PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource FP.Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Pré-visualização" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TealDarkBrush}"/>
                        <TextBlock Text="Documento não editável" HorizontalAlignment="Right" Foreground="{DynamicResource FP.TextMuted}"/>
                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource FundoCartaoBrush}" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1" CornerRadius="8" Padding="28" Margin="0,14,0,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding Preview}" FontFamily="Segoe UI" FontSize="14" LineHeight="23" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{DynamicResource SucessoBrush}" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
