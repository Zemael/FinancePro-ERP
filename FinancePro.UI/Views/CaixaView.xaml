<UserControl x:Class="FinancePro.UI.Views.CaixaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource FundoJanelaBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24"
                    MaxWidth="1450"
                    HorizontalAlignment="Center">

            <!-- Cabeçalho -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tesouraria / Caixa"
                               Foreground="{DynamicResource TextoSecundarioBrush}"
                               FontSize="12"/>
                    <TextBlock Text="Gestão de Caixa"
                               Style="{StaticResource TituloModulo}"/>
                    <TextBlock Text="Cadastre caixas, abra a sessão diária e efetue o fecho com conferência de saldo."
                               Style="{StaticResource TextoSecundario}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <StackPanel Margin="0,2,14,0" HorizontalAlignment="Right">
                        <TextBlock Text="Última atualização" Foreground="{StaticResource FP.TextMuted}" FontSize="10" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding UltimaAtualizacao, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Foreground="{StaticResource FP.Text}" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Content="Novo"
                            Command="{Binding NovoCommand}"
                            Style="{StaticResource BotaoPrimario}"
                            Margin="0,0,8,0"/>
                    <Button Content="Editar"
                            Command="{Binding EditarCommand}"
                            Style="{StaticResource BotaoSecundario}"
                            Margin="0,0,8,0"/>
                    <Button Content="Desativar"
                            Command="{Binding EliminarCommand}"
                            Style="{StaticResource BotaoSecundario}"/>
                </StackPanel>
            </Grid>

            <!-- Indicadores -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="CAIXAS" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding TotalCaixas}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Total de caixas cadastradas" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="ATIVAS" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding CaixasAtivas}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Disponíveis para operações" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="SALDO INICIAL" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding SaldoInicialTotal, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Total cadastrado" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border>
                <Border Grid.Column="6" Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="SESSÃO" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding EstadoSessaoTexto}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Estado operacional atual" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border>
            </Grid>

            <!-- Estado da sessão -->
            <Border Style="{StaticResource Cartao}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Sessão atual" Style="{StaticResource RotuloSeccaoModulo}"/>
                        <TextBlock Text="{Binding EstadoSessaoTexto}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AzulPrimarioBrush}"/>
                        <TextBlock Text="{Binding SessaoAtual.CaixaNome, TargetNullValue='Sem caixa aberto'}"
                                   Style="{StaticResource TextoSecundario}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Saldo atual" Style="{StaticResource RotuloSeccaoModulo}"/>
                        <TextBlock Text="{Binding SessaoAtual.SaldoAtual, StringFormat='{}{0:N2} FCFA', TargetNullValue='0,00 FCFA'}"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SessaoAtual.OperadorNome, TargetNullValue='—'}"
                                   Style="{StaticResource TextoSecundario}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Abertura" Style="{StaticResource RotuloSeccaoModulo}"/>
                        <TextBlock Text="{Binding SessaoAtual.DataAbertura, StringFormat='{}{0:dd/MM/yyyy HH:mm}', TargetNullValue='—'}"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                        <Button Content="Atualizar estado"
                                Command="{Binding AtualizarSessaoCommand}"
                                Style="{StaticResource BotaoSecundario}"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Operação de abertura e fecho -->
            <Border Style="{StaticResource Cartao}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Caixa selecionada" Style="{StaticResource Rotulo}"/>
                            <ComboBox ItemsSource="{Binding Caixas}"
                                      SelectedItem="{Binding CaixaSelecionada, Mode=TwoWay}"
                                      DisplayMemberPath="Nome"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Saldo de abertura" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding SaldoAberturaTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Observação da sessão" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding ObservacaoSessao, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="5"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom"
                                    Margin="16,0,0,0">
                            <Button Content="Abrir Caixa"
                                    Command="{Binding AbrirCaixaCommand}"
                                    Style="{StaticResource BotaoPrimario}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Fechar Caixa"
                                    Command="{Binding FecharCaixaCommand}"
                                    Style="{StaticResource BotaoSecundario}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="Saldo contado no fecho" Style="{StaticResource Rotulo}"/>
                        <TextBox Text="{Binding SaldoContadoTexto, UpdateSourceTrigger=PropertyChanged}"
                                 Width="220"
                                 HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding MensagemErro}"
                       Foreground="#C62828"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>
            <TextBlock Text="{Binding MensagemInfo}"
                       Foreground="#2E7D32"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <!-- Pesquisa e exportação -->
            <Border Style="{StaticResource Cartao}" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}"
                             Width="360"
                             HorizontalAlignment="Left"
                             ToolTip="Pesquisar caixa"/>
                    <Button Grid.Column="1"
                            Content="Exportar CSV"
                            Command="{Binding ExportarCommand}"
                            Style="{StaticResource BotaoSecundario}"/>
                </Grid>
            </Border>

            <!-- Lista de caixas -->
            <Border Style="{StaticResource Cartao}" Padding="0" Margin="0,0,0,16">
                <DataGrid ItemsSource="{Binding Caixas}"
                          SelectedItem="{Binding CaixaSelecionada, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="38"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                        <DataGridTextColumn Header="Saldo inicial" Binding="{Binding SaldoInicial, Converter={StaticResource ValorMoeda}}" Width="150"/>
                        <DataGridTextColumn Header="Saldo mínimo" Binding="{Binding SaldoMinimo, Converter={StaticResource ValorMoeda}}" Width="150"/>
                        <DataGridCheckBoxColumn Header="Saldo negativo" Binding="{Binding PermiteSaldoNegativo}" Width="120"/>
                        <DataGridTemplateColumn Header="Estado" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Ativo, Converter={StaticResource AtivoParaTexto}}"
                                               Foreground="{Binding Ativo, Converter={StaticResource AtivoParaCor}}"
                                               FontWeight="SemiBold"
                                               Margin="8,0"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Cadastro -->
            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <TextBlock Text="Cadastro de Caixa" Style="{StaticResource RotuloSeccaoModulo}"/>
                    <Grid IsEnabled="{Binding EmEdicao}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nome" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Saldo inicial padrão" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding SaldoInicialTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Saldo mínimo" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding SaldoMinimoTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="Permite saldo negativo"
                              IsChecked="{Binding PermiteSaldoNegativo}"
                              IsEnabled="{Binding EmEdicao}"
                              Margin="0,12,0,0"/>
                    <Button Content="Guardar cadastro"
                            Command="{Binding GuardarCommand}"
                            Style="{StaticResource BotaoPrimario}"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
