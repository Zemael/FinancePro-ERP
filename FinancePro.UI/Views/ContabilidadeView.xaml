<UserControl x:Class="FinancePro.UI.Views.ContabilidadeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Background="{StaticResource FP.PageBackground}" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Contabilidade" Style="{StaticResource FP.PageTitle}"/><TextBlock Text="Plano de contas e lançamentos contabilísticos" Style="{StaticResource FP.PageSubtitle}"/></StackPanel>
<TabControl Grid.Row="1" Margin="0,20,0,0"><TabItem Header="Plano de Contas"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<DataGrid ItemsSource="{Binding Contas}" SelectedItem="{Binding Selecionada}" AutoGenerateColumns="False" Style="{StaticResource FP.DataGrid}"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="100"/><DataGridTextColumn Header="Conta" Binding="{Binding Nome}" Width="*"/><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="120"/><DataGridTextColumn Header="Natureza" Binding="{Binding Natureza}" Width="110"/></DataGrid.Columns></DataGrid>
<Border Grid.Column="1" Style="{StaticResource FP.Card}" Margin="16,0,0,0"><StackPanel><TextBlock Text="Cadastro de conta" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Código" Style="{StaticResource FP.FieldLabel}" Margin="0,14,0,4"/><TextBox Text="{Binding Codigo,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Nome" Style="{StaticResource FP.FieldLabel}" Margin="0,10,0,4"/><TextBox Text="{Binding Nome,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Tipo" Style="{StaticResource FP.FieldLabel}" Margin="0,10,0,4"/><ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding Tipo}"/><TextBlock Text="Natureza" Style="{StaticResource FP.FieldLabel}" Margin="0,10,0,4"/><ComboBox ItemsSource="{Binding Naturezas}" SelectedItem="{Binding Natureza}"/><CheckBox Content="Aceita lançamentos" IsChecked="{Binding AceitaLancamentos}" Margin="0,12"/><StackPanel Orientation="Horizontal"><Button Content="Novo" Command="{Binding NovoCommand}" Style="{StaticResource FP.SecondaryButton}"/><Button Content="Guardar" Command="{Binding GuardarCommand}" Style="{StaticResource FP.PrimaryButton}" Margin="8,0,0,0"/></StackPanel><TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border></Grid></TabItem>
<TabItem Header="Lançamentos"><DataGrid Margin="12" ItemsSource="{Binding Lancamentos}" AutoGenerateColumns="False" Style="{StaticResource FP.DataGrid}"><DataGrid.Columns><DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="140"/><DataGridTextColumn Header="Data" Binding="{Binding DataLancamento,StringFormat=d}" Width="100"/><DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/><DataGridTextColumn Header="Débito" Binding="{Binding TotalDebito,StringFormat=N2}" Width="120"/><DataGridTextColumn Header="Crédito" Binding="{Binding TotalCredito,StringFormat=N2}" Width="120"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/></DataGrid.Columns></DataGrid></TabItem></TabControl></Grid></UserControl>