<UserControl x:Class="FinancePro.UI.Views.ContabilidadeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource FP.Page}" FontFamily="Segoe UI">
<Grid Background="{StaticResource FP.Page}"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="22,20" MaxWidth="1500" HorizontalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock Text="Contabilidade" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource FP.Text}"/><TextBlock Text="Plano de contas, lançamentos e controlo contabilístico." Foreground="{StaticResource FP.TextMuted}" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Border Background="White" BorderBrush="{StaticResource FP.Border}" BorderThickness="1" CornerRadius="9" Height="40" Padding="14,0" Margin="0,0,10,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Accent}" Margin="0,0,8,0"/><StackPanel><TextBlock Text="Última atualização" FontSize="9" Foreground="{StaticResource FP.TextMuted}"/><TextBlock Text="{Binding UltimaAtualizacao}" FontSize="11" FontWeight="SemiBold"/></StackPanel></StackPanel></Border><Button Command="{Binding AtualizarCommand}" Style="{StaticResource FP.SecondaryButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="Atualizar"/></StackPanel></Button></StackPanel></Grid>
<UniformGrid Grid.Row="2" Columns="4"><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="TOTAL DE CONTAS" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding TotalContas}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Estrutura contabilística" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="CONTAS ATIVAS" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding ContasAtivas}" Style="{StaticResource FP.KpiValue}" Foreground="{StaticResource FP.Success}"/><TextBlock Text="Disponíveis no plano" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="CONTAS ANALÍTICAS" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding ContasAnaliticas}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Aceitam lançamentos" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="LANÇAMENTOS" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding TotalLancamentos}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Registos contabilísticos" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border></UniformGrid>
<TabControl Grid.Row="4" Background="Transparent" BorderThickness="0"><TabItem Header="Plano de Contas"><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="18,15,18,12"><StackPanel><TextBlock Text="Plano de contas" Style="{StaticResource FP.SectionTitle}"/><TextBlock Text="Pesquise e selecione uma conta para editar." Style="{StaticResource FP.KpiHint}"/></StackPanel><Grid Width="270" HorizontalAlignment="Right"><TextBox Text="{Binding Pesquisa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FilterTextBox}" Padding="36,8,12,8"/><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource FP.TextMuted}" IsHitTestVisible="False"/></Grid></Grid><DataGrid Grid.Row="1" ItemsSource="{Binding Contas}" SelectedItem="{Binding Selecionada}" Style="{StaticResource FP.DataGrid}"><DataGrid.Columns><DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="110"/><DataGridTextColumn Header="CONTA" Binding="{Binding Nome}" Width="2*"/><DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="120"/><DataGridTextColumn Header="NATUREZA" Binding="{Binding Natureza}" Width="115"/><DataGridCheckBoxColumn Header="LANÇA" Binding="{Binding AceitaLancamentos}" Width="75"/></DataGrid.Columns></DataGrid></Grid></Border><Border Grid.Column="2" Style="{StaticResource FP.Card}"><StackPanel><TextBlock Text="Cadastro de conta" Style="{StaticResource FP.SectionTitle}"/><TextBlock Text="Dados da conta contabilística." Style="{StaticResource FP.KpiHint}" Margin="0,0,0,14"/><TextBlock Text="Código" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Codigo,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Nome" Style="{StaticResource FP.FieldLabel}" Margin="0,10,0,0"/><TextBox Text="{Binding Nome,UpdateSourceTrigger=PropertyChanged}"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tipo" Style="{StaticResource FP.FieldLabel}"/><ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding Tipo}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Natureza" Style="{StaticResource FP.FieldLabel}"/><ComboBox ItemsSource="{Binding Naturezas}" SelectedItem="{Binding Natureza}"/></StackPanel></Grid><CheckBox Content="Aceita lançamentos" IsChecked="{Binding AceitaLancamentos}" Margin="0,14,0,0"/><TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Foreground="{StaticResource FP.TextMuted}" Margin="0,12,0,0"/><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="Novo" Command="{Binding NovoCommand}" Style="{StaticResource FP.SecondaryButton}"/><Button Content="Guardar" Command="{Binding GuardarCommand}" Style="{StaticResource FP.PrimaryButton}" Margin="10,0,0,0"/></StackPanel></StackPanel></Border></Grid></TabItem>
<TabItem Header="Lançamentos"><Border Style="{StaticResource FP.Card}" Margin="0,14,0,0" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="18,15,18,12"><TextBlock Text="Lançamentos contabilísticos" Style="{StaticResource FP.SectionTitle}"/><TextBlock Text="Histórico de movimentos processados pelo núcleo contabilístico." Style="{StaticResource FP.KpiHint}"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Lancamentos}" Style="{StaticResource FP.DataGrid}"><DataGrid.Columns><DataGridTextColumn Header="NÚMERO" Binding="{Binding Numero}" Width="145"/><DataGridTextColumn Header="DATA" Binding="{Binding DataLancamento,StringFormat=dd/MM/yyyy}" Width="105"/><DataGridTextColumn Header="DESCRIÇÃO" Binding="{Binding Descricao}" Width="2*"/><DataGridTextColumn Header="DÉBITO" Binding="{Binding TotalDebito,Converter={StaticResource ValorMoeda}}" Width="130"/><DataGridTextColumn Header="CRÉDITO" Binding="{Binding TotalCredito,Converter={StaticResource ValorMoeda}}" Width="130"/><DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="115"/></DataGrid.Columns></DataGrid></Grid></Border></TabItem></TabControl>
</Grid></ScrollViewer></Grid></UserControl>
