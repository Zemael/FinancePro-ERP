<UserControl x:Class="FinancePro.UI.Views.StockView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24"><StackPanel>
<Grid Margin="0,0,0,16"><TextBlock Text="Stocks e Produtos" FontSize="16" FontWeight="Bold" Foreground="#0E4C5E"/><Button Content="Atualizar" Command="{Binding AtualizarCommand}" HorizontalAlignment="Right" Width="110" Height="40"/></Grid>
<Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#DCEAF0" BorderThickness="1" Padding="18"><StackPanel><TextBlock Text="Novo produto" FontWeight="Bold" Foreground="#0E4C5E" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Código"/><TextBox Text="{Binding Codigo}"/><TextBlock Text="Categoria" Margin="0,10,0,0"/><TextBox Text="{Binding Categoria}"/><TextBlock Text="Stock mínimo" Margin="0,10,0,0"/><TextBox Text="{Binding Minimo}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Nome"/><TextBox Text="{Binding Nome}"/><TextBlock Text="Unidade" Margin="0,10,0,0"/><TextBox Text="{Binding Unidade}"/><TextBlock Text="Localização" Margin="0,10,0,0"/><TextBox Text="{Binding Localizacao}"/></StackPanel></Grid><Button Content="Criar produto" Command="{Binding CriarProdutoCommand}" Width="130" Height="40" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border>
<Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#DCEAF0" BorderThickness="1" Padding="18"><StackPanel><TextBlock Text="Movimentar stock" FontWeight="Bold" Foreground="#0E4C5E" Margin="0,0,0,12"/><TextBlock Text="Produto"/><ComboBox ItemsSource="{Binding Produtos}" SelectedItem="{Binding ProdutoSelecionado}" DisplayMemberPath="Nome"/><TextBlock Text="Tipo" Margin="0,10,0,0"/><ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding Tipo}"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Quantidade"/><TextBox Text="{Binding Quantidade}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Custo unitário"/><TextBox Text="{Binding Custo}"/></StackPanel></Grid><TextBlock Text="Documento / referência" Margin="0,10,0,0"/><TextBox Text="{Binding Documento}"/><Button Content="Registar movimento" Command="{Binding MovimentarCommand}" Width="150" Height="40" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border></Grid>
<TextBlock Text="{Binding Mensagem}" Margin="0,0,0,12" Foreground="#156082"/>
<Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="White" CornerRadius="10" BorderBrush="#DCEAF0" BorderThickness="1" Padding="16"><StackPanel><TextBlock Text="Valor do stock" Foreground="#595959"/><TextBlock Text="{Binding ValorTotalStock, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold" Foreground="#0E4C5E"/></StackPanel></Border><Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#DCEAF0" BorderThickness="1" Padding="16"><StackPanel><TextBlock Text="Alertas de stock mínimo" Foreground="#595959"/><TextBlock Text="{Binding Alertas}" FontSize="20" FontWeight="Bold" Foreground="#C00000"/></StackPanel></Border></Grid>
<Border Background="White" CornerRadius="10" BorderBrush="#DCEAF0" BorderThickness="1" Padding="0" Margin="0,0,0,14"><DataGrid ItemsSource="{Binding Produtos}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="34" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="90"/><DataGridTextColumn Header="Produto" Binding="{Binding Nome}" Width="*"/><DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="130"/><DataGridTextColumn Header="Un." Binding="{Binding Unidade}" Width="55"/><DataGridTextColumn Header="Stock" Binding="{Binding StockAtual}" Width="80"/><DataGridTextColumn Header="Mínimo" Binding="{Binding StockMinimo}" Width="80"/><DataGridTextColumn Header="Custo médio" Binding="{Binding CustoMedio, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Valor" Binding="{Binding ValorStock, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Localização" Binding="{Binding Localizacao}" Width="120"/></DataGrid.Columns></DataGrid></Border>
<TextBlock Text="Últimos movimentos" FontWeight="Bold" Foreground="#0E4C5E" Margin="0,4,0,8"/><Border Background="White" CornerRadius="10" BorderBrush="#DCEAF0" BorderThickness="1"><DataGrid ItemsSource="{Binding Movimentos}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="34" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/><DataGridTextColumn Header="Produto" Binding="{Binding Produto}" Width="*"/><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="100"/><DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade}" Width="90"/><DataGridTextColumn Header="Custo" Binding="{Binding CustoUnitario, StringFormat=N2}" Width="90"/><DataGridTextColumn Header="Saldo" Binding="{Binding SaldoApos}" Width="80"/><DataGridTextColumn Header="Documento" Binding="{Binding DocumentoReferencia}" Width="140"/></DataGrid.Columns></DataGrid></Border>
</StackPanel></ScrollViewer></UserControl>
