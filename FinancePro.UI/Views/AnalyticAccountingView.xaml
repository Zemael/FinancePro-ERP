<UserControl x:Class="FinancePro.UI.Views.AnalyticAccountingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24"><StackPanel><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Contabilidade Analítica" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TealDarkBrush}"/><TextBlock Text="Centros de custo, departamentos, orçamento, execução e rentabilidade" Foreground="{DynamicResource FP.TextMuted}"/></StackPanel><Button Grid.Column="1" Content="Atualizar" Command="{Binding RefreshCommand}" Style="{StaticResource FP.SecondaryButton}"/></Grid>
<UniformGrid Columns="7" Margin="0,0,0,16"><Border Style="{StaticResource FP.KpiCard}" Margin="3"><StackPanel><TextBlock Text="Orçado"/><TextBlock Text="{Binding Budgeted,StringFormat=N2}" FontSize="18" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="3"><StackPanel><TextBlock Text="Comprometido"/><TextBlock Text="{Binding Committed,StringFormat=N2}" FontSize="18" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="3"><StackPanel><TextBlock Text="Realizado"/><TextBlock Text="{Binding Realized,StringFormat=N2}" FontSize="18" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="3"><StackPanel><TextBlock Text="Receitas"/><TextBlock Text="{Binding Revenue,StringFormat=N2}" FontSize="18" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="3"><StackPanel><TextBlock Text="Despesas"/><TextBlock Text="{Binding Expense,StringFormat=N2}" FontSize="18" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="3"><StackPanel><TextBlock Text="Resultado"/><TextBlock Text="{Binding Result,StringFormat=N2}" FontSize="18" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="3"><StackPanel><TextBlock Text="Desvio"/><TextBlock Text="{Binding Variance,StringFormat=N2}" FontSize="18" FontWeight="Bold"/></StackPanel></Border></UniformGrid>
<TabControl><TabItem Header="Análise por Centro"><StackPanel Margin="12"><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><DatePicker SelectedDate="{Binding From}" Width="150"/><DatePicker SelectedDate="{Binding To}" Width="150" Margin="8,0"/><Button Content="Gerar análise" Command="{Binding GenerateCommand}" Style="{StaticResource BaseButton}"/></StackPanel><DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding Performance}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="430"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding CostCenterCode}" Width="Auto"/><DataGridTextColumn Header="Centro de custo" Binding="{Binding CostCenterName}" Width="*"/><DataGridTextColumn Header="Departamento" Binding="{Binding Department}" Width="Auto"/><DataGridTextColumn Header="Orçado" Binding="{Binding Budgeted,StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Comprom." Binding="{Binding Committed,StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Realizado" Binding="{Binding Realized,StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Receita" Binding="{Binding Revenue,StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Despesa" Binding="{Binding Expense,StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Resultado" Binding="{Binding Result,StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Desvio" Binding="{Binding Variance,StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Execução" Binding="{Binding ExecutionRate,StringFormat={}{0:N1}%}" Width="Auto"/></DataGrid.Columns></DataGrid></StackPanel></TabItem>
<TabItem Header="Departamentos"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Cartao}"><StackPanel><TextBlock Text="Departamento" FontWeight="Bold" FontSize="16"/><TextBlock Text="Código" Margin="0,12,0,3"/><TextBox Text="{Binding Code}"/><TextBlock Text="Designação" Margin="0,8,0,3"/><TextBox Text="{Binding Name}"/><Button Content="Guardar" Command="{Binding SaveDepartmentCommand}" Style="{StaticResource BaseButton}" Margin="0,12,0,0"/><Separator Margin="0,18"/><TextBlock Text="Associar centro de custo" FontWeight="Bold"/><ComboBox ItemsSource="{Binding CostCenters}" SelectedItem="{Binding SelectedCostCenter}" DisplayMemberPath="Name" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}" DisplayMemberPath="Name" Margin="0,8,0,0"/><Button Content="Associar" Command="{Binding AssignDepartmentCommand}" Style="{StaticResource BaseButton}" Margin="0,10,0,0"/></StackPanel></Border><DataGrid Style="{StaticResource FP.DataGrid}" Grid.Column="2" ItemsSource="{Binding Departments}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="Auto"/><DataGridTextColumn Header="Departamento" Binding="{Binding Name}" Width="*"/><DataGridCheckBoxColumn ElementStyle="{StaticResource FP.DataGridCheckBox}" EditingElementStyle="{StaticResource FP.DataGridCheckBox}" Header="Ativo" Binding="{Binding Active}" Width="Auto"/><DataGridTemplateColumn Header="Ações" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.EditDepartmentCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}" Width="36" Height="36" ToolTip="Editar"/><Button Content="&#xE8D8;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.ToggleDepartmentCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}" Width="36" Height="36" Margin="6,0,0,0" ToolTip="Ativar/Desativar"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></TabItem></TabControl><TextBlock Text="{Binding Message}" Foreground="{DynamicResource SucessoBrush}" Margin="0,12,0,0"/></StackPanel></ScrollViewer></UserControl>
