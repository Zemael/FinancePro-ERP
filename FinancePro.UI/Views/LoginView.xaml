<Window x:Class="FinancePro.UI.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FinancePro ERP — Iniciar sessão"
        Width="1280"
        Height="760"
        MinWidth="1080"
        MinHeight="680"
        Icon="pack://application:,,,/Resources/Images/logo.png"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="#EEF4FA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="28"
                          ShadowDepth="8"
                          Opacity="0.14"
                          Color="#18314F"/>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#233247"/>
            <Setter Property="Background" Value="#F8FAFD"/>
            <Setter Property="BorderBrush" Value="#D5DFEA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#0F4C81"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#2E75B6"/>
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="InputBorder" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#233247"/>
            <Setter Property="Background" Value="#F8FAFD"/>
            <Setter Property="BorderBrush" Value="#D5DFEA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#2E75B6"/>
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="InputBorder" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#0F4C81"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0B3F6D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#082F52"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#9FB4C8"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#48647F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WindowButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WindowButtonBorder" Property="Background" Value="#E7EEF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Barra superior personalizada -->
        <Border Grid.Row="0" Background="#F7FAFD" BorderBrush="#DCE5EE" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="BarraTitulo_MouseLeftButtonDown">
            <Grid Margin="18,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/Images/logo.png"
                           Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="FinancePro ERP" FontWeight="SemiBold" FontSize="13"
                               Foreground="#20364E" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="—" Style="{StaticResource WindowButtonStyle}" Click="Minimizar_Click"/>
                    <Button Content="□" Style="{StaticResource WindowButtonStyle}" Click="Maximizar_Click"/>
                    <Button Content="✕" Style="{StaticResource WindowButtonStyle}" Click="Fechar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteúdo principal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.12*"/>
                <ColumnDefinition Width="0.88*"/>
            </Grid.ColumnDefinitions>

            <!-- Painel institucional -->
            <Border Grid.Column="0" Background="#0F4C81">
                <Grid>
                    <Ellipse Width="520" Height="520" Fill="#174F7D" Opacity="0.42"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-230,0,0,-280"/>
                    <Ellipse Width="400" Height="400" Fill="#2E75B6" Opacity="0.20"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-230,-170,0"/>

                    <Grid Margin="72,48,58,48">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <Border Width="62" Height="62" CornerRadius="15" Background="White"
                                    HorizontalAlignment="Left" Padding="9" Margin="0,0,0,20">
                                <Image Source="pack://application:,,,/Resources/Images/logo-240.png"
                                       Stretch="Uniform"/>
                            </Border>
                            <TextBlock FontSize="34" FontWeight="Bold" Foreground="White">
                                <Run Text="Finance"/><Run Text="Pro" Foreground="#65B7FF"/><Run Text=" ERP"/>
                            </TextBlock>
                            <TextBlock Text="Gestão financeira clara, segura e integrada."
                                       FontSize="17" Foreground="#D8E9F8" Margin="0,10,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="520"
                                    HorizontalAlignment="Left">
                            <TextBlock Text="Tudo o que precisa para gerir melhor."
                                       FontSize="25" FontWeight="SemiBold" Foreground="White"
                                       Margin="0,0,0,26"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="✓  Gestão Orçamental"
                                           Foreground="#EAF5FF" FontSize="14" Margin="0,0,20,18"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="✓  Tesouraria"
                                           Foreground="#EAF5FF" FontSize="14" Margin="0,0,0,18"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="✓  Receitas e Despesas"
                                           Foreground="#EAF5FF" FontSize="14" Margin="0,0,20,18"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="✓  Gestão Patrimonial"
                                           Foreground="#EAF5FF" FontSize="14" Margin="0,0,0,18"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="✓  Contabilidade"
                                           Foreground="#EAF5FF" FontSize="14" Margin="0,0,20,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="✓  Relatórios Executivos"
                                           Foreground="#EAF5FF" FontSize="14"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="FinancePro ERP v0.3"
                                       Foreground="#BBD6EB" FontSize="12"/>
                            <TextBlock Text="Desenvolvido por Zemael Jacinto da Silva"
                                       Foreground="#BBD6EB" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Painel de autenticação -->
            <Border Grid.Column="1" Background="#EEF4FA">
                <Grid Margin="48,32,48,32">
                    <Border MaxWidth="455" Background="White" CornerRadius="18" Padding="42,34"
                            Effect="{StaticResource CardShadow}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Bem-vindo" FontSize="28" FontWeight="Bold"
                                       Foreground="#20364E"/>
                            <TextBlock Text="Entre com as suas credenciais para continuar."
                                       Foreground="#73879A" FontSize="13" Margin="0,8,0,28"/>

                            <Border Background="#F0F6FC" BorderBrush="#D8E6F2" BorderThickness="1"
                                    CornerRadius="9" Padding="13,10" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Empresa" FontSize="11" Foreground="#6D8296"/>
                                        <TextBlock Text="DGCI" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#20364E" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="Exercício" FontSize="11" Foreground="#6D8296"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="2026" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#20364E" Margin="0,3,0,0"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="Utilizador ou email" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#3A5066" Margin="0,0,0,7"/>
                            <TextBox x:Name="EmailBox"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding AAutenticar, Converter={StaticResource InversorBool}}"/>

                            <TextBlock Text="Palavra-passe" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#3A5066" Margin="0,18,0,7"/>
                            <PasswordBox x:Name="SenhaBox"
                                         Style="{StaticResource InputPasswordStyle}"
                                         KeyDown="SenhaBox_KeyDown"
                                         IsEnabled="{Binding AAutenticar, Converter={StaticResource InversorBool}}"/>

                            <Grid Margin="0,14,0,0">
                                <CheckBox Content="Lembrar acesso" Foreground="#536B82" FontSize="12"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="Recuperar palavra-passe"
                                           Foreground="#0F4C81" FontWeight="SemiBold" FontSize="12"
                                           HorizontalAlignment="Right" Cursor="Hand"/>
                            </Grid>

                            <Border Background="#FFF2F2" BorderBrush="#F2C6C6" BorderThickness="1"
                                    CornerRadius="7" Padding="10" Margin="0,15,0,0"
                                    Visibility="{Binding MensagemErro, Converter={StaticResource TextoParaVisibilidade}}">
                                <TextBlock Text="{Binding MensagemErro}" Foreground="#B42318" FontSize="12"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Button x:Name="EntrarButton"
                                    Content="{Binding AAutenticar, Converter={StaticResource OcupadoParaTexto}}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="Entrar_Click"
                                    IsEnabled="{Binding AAutenticar, Converter={StaticResource InversorBool}}"
                                    Margin="0,24,0,0"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        Margin="0,22,0,0">
                                <TextBlock Text="PT" Foreground="#0F4C81" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Text="  •  " Foreground="#A4B4C3" FontSize="11"/>
                                <TextBlock Text="Tema claro" Foreground="#6C8093" FontSize="11"/>
                                <TextBlock Text="  •  " Foreground="#A4B4C3" FontSize="11"/>
                                <TextBlock Text="Ajuda" Foreground="#6C8093" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Rodapé -->
        <Border Grid.Row="2" Background="#F7FAFD" BorderBrush="#DCE5EE" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#21A366" Margin="0,0,7,0"/>
                    <TextBlock Text="SQL Server ligado" Foreground="#61778C" FontSize="11"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="   •   Base de dados FinancePro" Foreground="#8A9CAD"
                               FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="© 2026 Zemael Jacinto da Silva — Todos os direitos reservados."
                           Foreground="#73879A" FontSize="11" HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
