<UserControl x:Class="FinancePro.UI.Views.ReceitasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="BorderBrush" Value="#DCEAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#595959"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="BotaoLink" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Receitas" FontSize="18" FontWeight="Bold" Foreground="#0E4C5E" Margin="0,0,0,4"/>
                    <TextBlock Text="Contas a receber de clientes — ao registar o recebimento, gera automaticamente um movimento de Tesouraria"
                               FontSize="12" Foreground="#595959" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Atualizar" Command="{Binding AtualizarCommand}"
                        MinWidth="100" Height="40" VerticalAlignment="Top" Margin="16,0,0,0"
                        Style="{StaticResource BaseButton}"/>
            </Grid>

            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Descrição" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Valor (FCFA)" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding ValorTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cliente (opcional)" Style="{StaticResource Rotulo}"/>
                            <ComboBox ItemsSource="{Binding Clientes}" SelectedItem="{Binding ClienteSelecionado}" DisplayMemberPath="Nome"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Categoria" Style="{StaticResource Rotulo}"/>
                            <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSelecionada}" DisplayMemberPath="Nome"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Vencimento" Style="{StaticResource Rotulo}"/>
                            <DatePicker SelectedDate="{Binding DataVencimento}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Forma de pagamento" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding FormaPagamento, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Centro de custo" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding CentroCusto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding MensagemErro}" Foreground="#C00000" FontSize="12"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding MensagemErro, Converter={StaticResource TextoParaVisibilidade}}"/>
                    <TextBlock Text="{Binding MensagemSucesso}" Foreground="#0F6E56" FontSize="12" FontWeight="SemiBold"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding MensagemSucesso, Converter={StaticResource TextoParaVisibilidade}}"/>

                    <Button Style="{StaticResource BotaoPrimario}" Command="{Binding CriarCommand}"
                            Content="{Binding AGuardar, Converter={StaticResource OcupadoParaTexto}, ConverterParameter=Adicionar}"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,20,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Contas a Receber" FontSize="14" FontWeight="Bold" Foreground="#0E4C5E" VerticalAlignment="Center"/>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Receber para:" Style="{StaticResource Rotulo}"/>
                        <ComboBox ItemsSource="{Binding Origens}" SelectedItem="{Binding OrigemRecebimentoSelecionada}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nome}"/>
                                        <TextBlock Text="{Binding MotivoIndisponibilidade}" FontSize="10" Foreground="#C00000"
                                                   Visibility="{Binding Disponivel, Converter={StaticResource BoolParaVisibilidade}, ConverterParameter=Inverso}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data" Style="{StaticResource Rotulo}"/>
                        <DatePicker SelectedDate="{Binding DataRecebimento}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <TextBlock Text="{Binding MensagemErro}" Foreground="#C00000" FontSize="12" FontWeight="SemiBold"
                       Margin="0,0,0,8" TextWrapping="Wrap"
                       Visibility="{Binding MensagemErro, Converter={StaticResource TextoParaVisibilidade}}"/>
            <TextBlock Text="{Binding MensagemSucesso}" Foreground="#0F6E56" FontSize="12" FontWeight="SemiBold"
                       Margin="0,0,0,8" TextWrapping="Wrap"
                       Visibility="{Binding MensagemSucesso, Converter={StaticResource TextoParaVisibilidade}}"/>

            <Border Style="{StaticResource Cartao}" Padding="0">
                <DataGrid ItemsSource="{Binding Contas}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="36" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80"/>
                        <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="120"/>
                        <DataGridTextColumn Header="Categoria" Binding="{Binding CategoriaNome}" Width="110"/>
                        <DataGridTextColumn Header="Vencimento" Binding="{Binding DataVencimento, StringFormat=dd/MM/yyyy}" Width="90"/>
                        <DataGridTextColumn Header="Valor" Binding="{Binding Valor, Converter={StaticResource ValorMoeda}}" Width="120"/>
                        <DataGridTemplateColumn Header="Estado" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EstadoExibicao}" Foreground="{Binding EstadoExibicao, Converter={StaticResource EstadoContaParaCor}}"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Receber" Style="{StaticResource BotaoLink}" Foreground="#0F6E56"
                                                Visibility="{Binding PodeReceber, Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.ReceberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Cancelar" Style="{StaticResource BotaoLink}" Foreground="#C00000"
                                                Visibility="{Binding PodeCancelar, Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.CancelarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
