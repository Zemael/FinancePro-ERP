<UserControl x:Class="FinancePro.UI.Views.ReceitasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource FP.Page}" FontFamily="Segoe UI">
    <Grid Background="{StaticResource FP.Page}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="22,20" MaxWidth="1500" HorizontalAlignment="Center">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel><TextBlock Text="Receitas" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource FP.Text}"/><TextBlock Text="Contas a receber, recebimentos e integração automática com a Tesouraria." Foreground="{StaticResource FP.TextMuted}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Border Background="White" BorderBrush="{StaticResource FP.Border}" BorderThickness="1" CornerRadius="9" Height="40" Padding="14,0" Margin="0,0,10,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Accent}" Margin="0,0,8,0"/><StackPanel><TextBlock Text="Última atualização" Foreground="{StaticResource FP.TextMuted}" FontSize="9"/><TextBlock Text="{Binding UltimaAtualizacao}" Foreground="{StaticResource FP.Text}" FontSize="11" FontWeight="SemiBold"/></StackPanel></StackPanel></Border>
                        <Button Command="{Binding AtualizarCommand}" Style="{StaticResource FP.SecondaryButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="Atualizar"/></StackPanel></Button>
                    </StackPanel>
                </Grid>
                <UniformGrid Grid.Row="2" Columns="4">
                    <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="40" Height="40" Background="#EAF2FF" CornerRadius="9"><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Accent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="EM ABERTO" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding TotalAberto, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="{Binding QuantidadeAberta, StringFormat={}{0} títulos pendentes}" Style="{StaticResource FP.KpiHint}"/></StackPanel></Grid></Border>
                    <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="40" Height="40" Background="{StaticResource FP.DangerSoft}" CornerRadius="9"><TextBlock Text="&#xE814;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Danger}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="VENCIDO" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding TotalVencido, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Necessita cobrança" Style="{StaticResource FP.KpiHint}"/></StackPanel></Grid></Border>
                    <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="40" Height="40" Background="{StaticResource FP.WarningSoft}" CornerRadius="9"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Warning}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="VENCE HOJE" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding TotalHoje, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Prioridade do dia" Style="{StaticResource FP.KpiHint}"/></StackPanel></Grid></Border>
                    <Border Style="{StaticResource FP.KpiCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="40" Height="40" Background="{StaticResource FP.SuccessSoft}" CornerRadius="9"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Success}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="ORIGENS DISPONÍVEIS" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding Origens.Count}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Caixas e contas bancárias" Style="{StaticResource FP.KpiHint}"/></StackPanel></Grid></Border>
                </UniformGrid>
                <Border Grid.Row="4" Style="{StaticResource FP.Card}" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="160"/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><Grid><TextBox Text="{Binding Pesquisa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FilterTextBox}" Padding="38,8,12,8" ToolTip="Código, descrição ou cliente"/><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.TextMuted}" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid><ComboBox Grid.Column="2" ItemsSource="{Binding Estados}" SelectedItem="{Binding EstadoSelecionado}"/><Button Grid.Column="4" Content="Filtrar" Command="{Binding FiltrarCommand}" Style="{StaticResource FP.PrimaryButton}"/></Grid></Border>
                <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource FP.Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="18,15,18,12"><StackPanel><TextBlock Text="Contas a receber" Style="{StaticResource FP.SectionTitle}"/><TextBlock Text="Receba ou cancele títulos diretamente na lista." Style="{StaticResource FP.KpiHint}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ComboBox Width="180" ItemsSource="{Binding Origens}" SelectedItem="{Binding OrigemRecebimentoSelecionada}" DisplayMemberPath="Nome"/><DatePicker Width="125" Margin="10,0,0,0" SelectedDate="{Binding DataRecebimento}"/></StackPanel></Grid><DataGrid Grid.Row="1" ItemsSource="{Binding Contas}" Style="{StaticResource FP.DataGrid}"><DataGrid.Columns><DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="90"/><DataGridTextColumn Header="DESCRIÇÃO" Binding="{Binding Descricao}" Width="2*"/><DataGridTextColumn Header="CLIENTE" Binding="{Binding ClienteNome}" Width="*"/><DataGridTextColumn Header="VENCIMENTO" Binding="{Binding DataVencimento, StringFormat=dd/MM/yyyy}" Width="105"/><DataGridTextColumn Header="VALOR" Binding="{Binding Valor, Converter={StaticResource ValorMoeda}}" Width="120"/><DataGridTextColumn Header="ESTADO" Binding="{Binding EstadoExibicao}" Width="100"/><DataGridTemplateColumn Header="AÇÕES" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Receber" Command="{Binding DataContext.ReceberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.LinkButton}" Foreground="{StaticResource FP.Success}"/><Button Content="Cancelar" Command="{Binding DataContext.CancelarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.LinkButton}" Foreground="{StaticResource FP.Danger}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></Border>
                    <Border Grid.Column="2" Style="{StaticResource FP.Card}"><StackPanel><TextBlock Text="Novo título a receber" Style="{StaticResource FP.SectionTitle}"/><TextBlock Text="Registe a obrigação do cliente." Style="{StaticResource FP.KpiHint}" Margin="0,0,0,14"/><TextBlock Text="Descrição" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Valor (FCFA)" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding ValorTexto, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Vencimento" Style="{StaticResource FP.FieldLabel}"/><DatePicker SelectedDate="{Binding DataVencimento}"/></StackPanel></Grid><TextBlock Text="Cliente" Style="{StaticResource FP.FieldLabel}" Margin="0,10,0,0"/><ComboBox ItemsSource="{Binding Clientes}" SelectedItem="{Binding ClienteSelecionado}" DisplayMemberPath="Nome"/><TextBlock Text="Categoria" Style="{StaticResource FP.FieldLabel}" Margin="0,10,0,0"/><ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSelecionada}" DisplayMemberPath="Nome"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Forma de pagamento" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding FormaPagamento}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Centro de custo" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding CentroCusto}"/></StackPanel></Grid><TextBlock Text="{Binding MensagemErro}" Foreground="{StaticResource FP.Danger}" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="{Binding MensagemSucesso}" Foreground="{StaticResource FP.Success}" TextWrapping="Wrap" Margin="0,6,0,0"/><Button Content="Guardar título" Command="{Binding CriarCommand}" Style="{StaticResource FP.PrimaryButton}" Margin="0,16,0,0" HorizontalAlignment="Stretch"/></StackPanel></Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
