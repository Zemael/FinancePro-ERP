<Window x:Class="FinancePro.UI.Views.SobreView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sobre o FinancePro" Width="420" Height="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource FundoPrincipalBrush}" FontFamily="Segoe UI">
    <StackPanel Margin="28" HorizontalAlignment="Center">
        <Image Source="pack://application:,,,/Resources/Images/logo-icon-transparent.png" Width="64" Height="64" Stretch="Uniform" Margin="0,0,0,14"/>
        <TextBlock Text="FinancePro ERP" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TealDarkBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="Versão 6.74.0" Foreground="{DynamicResource GrayTextBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,18"/>

        <Border Style="{StaticResource Cartao}" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Suporte" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource GrayTextBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="regulom26@gmail.com" FontSize="12.5" Margin="0,0,0,3"/>
                <TextBlock Text="+245 955 456 000" FontSize="12.5"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Cartao}" Padding="16">
            <StackPanel>
                <TextBlock Text="Atalhos úteis" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource GrayTextBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="Ctrl + K — Pesquisa global" FontSize="12.5" Margin="0,0,0,3"/>
                <TextBlock Text="☰ (canto superior esquerdo) — expandir/colapsar menu" FontSize="12.5" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Text="© 2026 Zemael Jacinto da Silva. Todos os direitos reservados." Foreground="{DynamicResource GrayTextBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,20,0,0" TextWrapping="Wrap" TextAlignment="Center"/>

        <Button Content="Fechar" Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Center" Margin="0,16,0,0" Click="Fechar_Click"/>
    </StackPanel>
</Window>
