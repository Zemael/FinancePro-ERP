<UserControl x:Class="FinancePro.UI.Views.BancosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <TextBlock Text="Cadastros Mestres / Bancos" FontSize="11" Foreground="{DynamicResource GrayTextBrush}" Margin="0,0,0,2"/>
            <TextBlock Text="Bancos" Style="{StaticResource TituloModulo}" Margin="0,0,0,4"/>
            <TextBlock Text="Catálogo de bancos e contas bancárias da empresa"
                       Style="{StaticResource TextoSecundario}" Margin="0,0,0,16"/>

            <TextBlock Text="Catálogo de bancos" Style="{StaticResource FP.SectionTitle}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nome do banco" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding NomeBanco, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Sigla" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding SiglaBanco, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" CharacterCasing="Upper" Height="38"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Código SWIFT" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding SwiftBanco, UpdateSourceTrigger=PropertyChanged}" MaxLength="11" CharacterCasing="Upper" Height="38"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Endereço" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding EnderecoBanco, UpdateSourceTrigger=PropertyChanged}" MaxLength="250" Height="38"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Contacto" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding ContactoBanco, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Height="38"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding MensagemErroBanco}" Foreground="{DynamicResource PerigoBrush}" FontSize="12"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding MensagemErroBanco, Converter={StaticResource TextoParaVisibilidade}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource BotaoPrimario}" Command="{Binding CriarBancoCommand}"
                                HorizontalAlignment="Left" Height="38" Content="{Binding TextoAcaoBanco}"/>
                        <Button Style="{StaticResource BotaoSecundario}" Command="{Binding NovoBancoCommand}"
                                HorizontalAlignment="Left" Height="38" Margin="8,0,0,0" Content="Cancelar edição"
                                Visibility="{Binding EmEdicaoBanco, Converter={StaticResource BoolParaVisibilidade}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Cartao}" Padding="0" Margin="0,10,0,0">
                <DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding Bancos}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Banco" Binding="{Binding Nome}" Width="2*" MinWidth="150"/>
                        <DataGridTextColumn Header="Sigla" Binding="{Binding Sigla}" Width="90" MinWidth="70"/>
                        <DataGridTextColumn Header="SWIFT" Binding="{Binding CodigoSwift}" Width="120" MinWidth="100"/>
                        <DataGridTextColumn Header="Endereço" Binding="{Binding Endereco}" Width="2*" MinWidth="160"/>
                        <DataGridTextColumn Header="Contacto" Binding="{Binding Contacto}" Width="140" MinWidth="115"/>
                        <DataGridTemplateColumn Header="Ações" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                            Command="{Binding DataContext.EditarBancoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}"
                                            Width="36" Height="36" ToolTip="Editar banco"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock Text="Contas bancárias da empresa" Style="{StaticResource FP.SectionTitle}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Banco" Style="{StaticResource Rotulo}"/>
                            <ComboBox ItemsSource="{Binding Bancos}" SelectedItem="{Binding BancoSelecionado}" DisplayMemberPath="Nome"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Número de conta" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding NumeroConta, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="IBAN (opcional)" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding IBAN, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Titular" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding Titular, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Saldo inicial (FCFA)" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding SaldoInicialTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding MensagemErroConta}" Foreground="{DynamicResource PerigoBrush}" FontSize="12"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding MensagemErroConta, Converter={StaticResource TextoParaVisibilidade}}"/>
                    <Button Style="{StaticResource BotaoPrimario}" Command="{Binding CriarContaCommand}"
                            HorizontalAlignment="Left" Margin="0,10,0,0"
                            Content="{Binding AGuardarConta, Converter={StaticResource OcupadoParaTexto}, ConverterParameter=Adicionar}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Cartao}" Padding="0" Margin="0,10,0,0">
                <DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding Contas}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Banco" Binding="{Binding BancoNome}" Width="Auto"/>
                        <DataGridTextColumn Header="Nº de conta" Binding="{Binding NumeroConta}" Width="Auto"/>
                        <DataGridTextColumn Header="Titular" Binding="{Binding Titular}" Width="*"/>
                        <DataGridTextColumn Header="Saldo inicial" Binding="{Binding SaldoInicial, Converter={StaticResource ValorMoeda}}" Width="Auto"/>
                        <DataGridTemplateColumn Header="Estado" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Ativo, Converter={StaticResource AtivoParaTexto}}"
                                               Foreground="{Binding Ativo, Converter={StaticResource AtivoParaCor}}"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Ações" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                                Command="{Binding DataContext.EditarContaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}"
                                                Width="36" Height="36" ToolTip="Editar conta"/>
                                        <Button Content="&#xE8D8;" FontFamily="Segoe MDL2 Assets"
                                                Command="{Binding DataContext.AlternarAtivoContaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}"
                                                Width="36" Height="36" Margin="6,0,0,0" ToolTip="Ativar/Desativar"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
