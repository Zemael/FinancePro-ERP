<UserControl x:Class="FinancePro.UI.Views.BancosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="BorderBrush" Value="#DCEAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#595959"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <TextBlock Text="Bancos" FontSize="18" FontWeight="Bold" Foreground="#0E4C5E" Margin="0,0,0,4"/>
            <TextBlock Text="Catálogo de bancos e contas bancárias da empresa"
                       FontSize="12" Foreground="#595959" Margin="0,0,0,16"/>

            <TextBlock Text="Catálogo de bancos" FontSize="14" FontWeight="Bold" Foreground="#0E4C5E" Margin="0,0,0,10"/>
            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nome do banco" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding NomeBanco, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Código SWIFT" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding SwiftBanco, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding MensagemErroBanco}" Foreground="#C00000" FontSize="12"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding MensagemErroBanco, Converter={StaticResource TextoParaVisibilidade}}"/>
                    <Button Style="{StaticResource BotaoPrimario}" Command="{Binding CriarBancoCommand}"
                            Content="{Binding AGuardarBanco, Converter={StaticResource OcupadoParaTexto}, ConverterParameter=Adicionar}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Cartao}" Padding="0" Margin="0,10,0,0">
                <DataGrid ItemsSource="{Binding Bancos}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Banco" Binding="{Binding Nome}" Width="*"/>
                        <DataGridTextColumn Header="SWIFT" Binding="{Binding CodigoSwift}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock Text="Contas bancárias da empresa" FontSize="14" FontWeight="Bold" Foreground="#0E4C5E" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Banco" Style="{StaticResource Rotulo}"/>
                            <ComboBox ItemsSource="{Binding Bancos}" SelectedItem="{Binding BancoSelecionado}" DisplayMemberPath="Nome"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Número de conta" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding NumeroConta, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="IBAN (opcional)" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding IBAN, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Titular" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding Titular, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Saldo inicial (FCFA)" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding SaldoInicialTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding MensagemErroConta}" Foreground="#C00000" FontSize="12"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding MensagemErroConta, Converter={StaticResource TextoParaVisibilidade}}"/>
                    <Button Style="{StaticResource BotaoPrimario}" Command="{Binding CriarContaCommand}"
                            Content="{Binding AGuardarConta, Converter={StaticResource OcupadoParaTexto}, ConverterParameter=Adicionar}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Cartao}" Padding="0" Margin="0,10,0,0">
                <DataGrid ItemsSource="{Binding Contas}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="36" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Banco" Binding="{Binding BancoNome}" Width="130"/>
                        <DataGridTextColumn Header="Nº de conta" Binding="{Binding NumeroConta}" Width="130"/>
                        <DataGridTextColumn Header="Titular" Binding="{Binding Titular}" Width="*"/>
                        <DataGridTextColumn Header="Saldo inicial" Binding="{Binding SaldoInicial, Converter={StaticResource ValorMoeda}}" Width="130"/>
                        <DataGridTemplateColumn Header="Estado" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Ativo, Converter={StaticResource AtivoParaTexto}}"
                                               Foreground="{Binding Ativo, Converter={StaticResource AtivoParaCor}}"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Ativo, Converter={StaticResource AtivoParaAcaoTexto}}"
                                            Command="{Binding DataContext.AlternarAtivoContaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Foreground="#156082" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
