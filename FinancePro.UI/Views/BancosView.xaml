<UserControl x:Class="FinancePro.UI.Views.BancosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource FP.Page}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" MaxWidth="1450" HorizontalAlignment="Center">
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Tesouraria / Cadastros" Foreground="{StaticResource FP.TextMuted}" FontSize="11"/>
                    <TextBlock Text="Bancos e Contas Bancárias" Style="{StaticResource TituloModulo}"/>
                    <TextBlock Text="Centralize o catálogo bancário, acompanhe as contas da empresa e mantenha os saldos iniciais organizados." Style="{StaticResource TextoSecundario}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <StackPanel Margin="0,2,14,0" HorizontalAlignment="Right">
                        <TextBlock Text="Última atualização" Foreground="{StaticResource FP.TextMuted}" FontSize="10" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding UltimaAtualizacao, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Foreground="{StaticResource FP.Text}" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Command="{Binding AtualizarCommand}" Style="{StaticResource FP.SecondaryButton}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="Atualizar"/></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="BANCOS" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding TotalBancos}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Instituições cadastradas" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="CONTAS" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding TotalContas}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Contas bancárias da empresa" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="CONTAS ATIVAS" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding ContasAtivas}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Disponíveis para movimentos" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border>
                <Border Grid.Column="6" Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="SALDO INICIAL" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding SaldoInicialTotal, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Total informado nas contas" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource FP.Card}" Padding="0" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="18,16,18,12"><TextBlock Text="Contas bancárias" Style="{StaticResource FP.SectionTitle}"/><TextBlock Text="Lista consolidada das contas da empresa" Foreground="{StaticResource FP.TextMuted}" FontSize="10" VerticalAlignment="Bottom" HorizontalAlignment="Right"/></Grid>
                            <DataGrid ItemsSource="{Binding Contas}" Style="{StaticResource FP.DataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Banco" Binding="{Binding BancoNome}" Width="145"/>
                                    <DataGridTextColumn Header="Nº de conta" Binding="{Binding NumeroConta}" Width="135"/>
                                    <DataGridTextColumn Header="Titular" Binding="{Binding Titular}" Width="*"/>
                                    <DataGridTextColumn Header="Saldo inicial" Binding="{Binding SaldoInicial, Converter={StaticResource ValorMoeda}}" Width="140"/>
                                    <DataGridTemplateColumn Header="Estado" Width="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource FP.StatusActive}" HorizontalAlignment="Left"><TextBlock Text="{Binding Ativo, Converter={StaticResource AtivoParaTexto}}" Foreground="{Binding Ativo, Converter={StaticResource AtivoParaCor}}" FontWeight="SemiBold" FontSize="10"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Ação" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Ativo, Converter={StaticResource AtivoParaAcaoTexto}}" Command="{Binding DataContext.AlternarAtivoContaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.SecondaryButton}" Padding="9,4" MinHeight="28"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FP.Card}" Padding="0">
                        <StackPanel>
                            <TextBlock Text="Catálogo de bancos" Style="{StaticResource FP.SectionTitle}" Margin="18,16,18,10"/>
                            <DataGrid ItemsSource="{Binding Bancos}" Style="{StaticResource FP.DataGrid}" MaxHeight="260">
                                <DataGrid.Columns><DataGridTextColumn Header="Banco" Binding="{Binding Nome}" Width="*"/><DataGridTextColumn Header="Código SWIFT" Binding="{Binding CodigoSwift}" Width="170"/></DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource FP.Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Adicionar banco" Style="{StaticResource FP.SectionTitle}" Margin="0,0,0,14"/>
                            <TextBlock Text="Nome do banco" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding NomeBanco, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FormTextBox}"/>
                            <TextBlock Text="Código SWIFT" Style="{StaticResource FP.FieldLabel}" Margin="0,12,0,5"/><TextBox Text="{Binding SwiftBanco, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FormTextBox}"/>
                            <TextBlock Text="{Binding MensagemErroBanco}" Foreground="{StaticResource FP.Danger}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="{Binding MensagemErroBanco, Converter={StaticResource TextoParaVisibilidade}}"/>
                            <Button Command="{Binding CriarBancoCommand}" Style="{StaticResource FP.PrimaryButton}" Margin="0,14,0,0" HorizontalAlignment="Stretch" Content="{Binding AGuardarBanco, Converter={StaticResource OcupadoParaTexto}, ConverterParameter=Adicionar banco}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FP.Card}">
                        <StackPanel>
                            <TextBlock Text="Nova conta bancária" Style="{StaticResource FP.SectionTitle}" Margin="0,0,0,14"/>
                            <TextBlock Text="Banco" Style="{StaticResource FP.FieldLabel}"/><ComboBox ItemsSource="{Binding Bancos}" SelectedItem="{Binding BancoSelecionado}" DisplayMemberPath="Nome" Style="{StaticResource FP.FilterComboBox}"/>
                            <TextBlock Text="Número da conta" Style="{StaticResource FP.FieldLabel}" Margin="0,12,0,5"/><TextBox Text="{Binding NumeroConta, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FormTextBox}"/>
                            <TextBlock Text="IBAN" Style="{StaticResource FP.FieldLabel}" Margin="0,12,0,5"/><TextBox Text="{Binding IBAN, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FormTextBox}"/>
                            <TextBlock Text="Titular" Style="{StaticResource FP.FieldLabel}" Margin="0,12,0,5"/><TextBox Text="{Binding Titular, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FormTextBox}"/>
                            <TextBlock Text="Saldo inicial (FCFA)" Style="{StaticResource FP.FieldLabel}" Margin="0,12,0,5"/><TextBox Text="{Binding SaldoInicialTexto, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FormTextBox}"/>
                            <TextBlock Text="{Binding MensagemErroConta}" Foreground="{StaticResource FP.Danger}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="{Binding MensagemErroConta, Converter={StaticResource TextoParaVisibilidade}}"/>
                            <Button Command="{Binding CriarContaCommand}" Style="{StaticResource FP.PrimaryButton}" Margin="0,14,0,0" HorizontalAlignment="Stretch" Content="{Binding AGuardarConta, Converter={StaticResource OcupadoParaTexto}, ConverterParameter=Adicionar conta}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
