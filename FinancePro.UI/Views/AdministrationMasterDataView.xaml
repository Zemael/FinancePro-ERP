<UserControl x:Class="FinancePro.UI.Views.AdministrationMasterDataView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24"><StackPanel>
<Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Administração" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TealDarkBrush}"/><TextBlock Text="Dados mestres, plano de contas e sequências documentais" Foreground="{DynamicResource GrayTextBrush}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Atualizar" Command="{Binding RefreshCommand}" Style="{StaticResource FP.SecondaryButton}"/></Grid>
<UniformGrid Columns="5" Margin="0,0,0,16">
<Border Style="{StaticResource Cartao}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Centros ativos" Foreground="{DynamicResource GrayTextBrush}"/><TextBlock Text="{Binding ActiveCostCenters}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource TealDarkBrush}"/></StackPanel></Border>
<Border Style="{StaticResource Cartao}" Margin="6,0"><StackPanel><TextBlock Text="Taxas ativas" Foreground="{DynamicResource GrayTextBrush}"/><TextBlock Text="{Binding ActiveTaxRates}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource TealDarkBrush}"/></StackPanel></Border>
<Border Style="{StaticResource Cartao}" Margin="6,0"><StackPanel><TextBlock Text="Contas ativas" Foreground="{DynamicResource GrayTextBrush}"/><TextBlock Text="{Binding ActiveAccounts}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource TealDarkBrush}"/></StackPanel></Border>
<Border Style="{StaticResource Cartao}" Margin="6,0,0,0"><StackPanel><TextBlock Text="Sequências ativas" Foreground="{DynamicResource GrayTextBrush}"/><TextBlock Text="{Binding ActiveSequences}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource TealDarkBrush}"/></StackPanel></Border><Border Style="{StaticResource Cartao}" Margin="6,0,0,0"><StackPanel><TextBlock Text="Obrigações pendentes" Foreground="{DynamicResource GrayTextBrush}"/><TextBlock Text="{Binding PendingFiscalObligations}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource AvisoBrush}"/></StackPanel></Border></UniformGrid>
<TabControl>
<TabItem Header="Centros de custo"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Cartao}"><StackPanel><TextBlock Text="Centro de custo" FontSize="16" FontWeight="Bold"/><TextBlock Text="Código" Margin="0,12,0,3"/><TextBox Text="{Binding CostCode}"/><TextBlock Text="Designação" Margin="0,10,0,3"/><TextBox Text="{Binding CostName}"/><Button Content="Guardar" Command="{Binding SaveCostCenterCommand}" Style="{StaticResource BaseButton}" Margin="0,14,0,0"/></StackPanel></Border><DataGrid Style="{StaticResource FP.DataGrid}" Grid.Column="2" ItemsSource="{Binding CostCenters}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="Auto"/><DataGridTextColumn Header="Designação" Binding="{Binding Name}" Width="*"/><DataGridCheckBoxColumn ElementStyle="{StaticResource FP.DataGridCheckBox}" EditingElementStyle="{StaticResource FP.DataGridCheckBox}" Header="Ativo" Binding="{Binding Active}" Width="Auto"/><DataGridTemplateColumn Header="Ações" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.EditCostCenterCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}" Width="36" Height="36" ToolTip="Editar"/><Button Content="&#xE8D8;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.ToggleCostCenterCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}" Width="36" Height="36" Margin="6,0,0,0" ToolTip="Ativar/Desativar"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></TabItem>
<TabItem Header="Taxas de IVA"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Cartao}"><StackPanel><TextBlock Text="Taxa de IVA" FontSize="16" FontWeight="Bold"/><TextBlock Text="Código" Margin="0,12,0,3"/><TextBox Text="{Binding TaxCode}"/><TextBlock Text="Designação" Margin="0,10,0,3"/><TextBox Text="{Binding TaxName}"/><TextBlock Text="Taxa (%)" Margin="0,10,0,3"/><TextBox Text="{Binding TaxRate}"/><Button Content="Guardar" Command="{Binding SaveTaxRateCommand}" Style="{StaticResource BaseButton}" Margin="0,14,0,0"/></StackPanel></Border><DataGrid Style="{StaticResource FP.DataGrid}" Grid.Column="2" ItemsSource="{Binding TaxRates}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="Auto"/><DataGridTextColumn Header="Designação" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Taxa" Binding="{Binding Rate,StringFormat={}{0:N2}%}" Width="Auto"/><DataGridCheckBoxColumn ElementStyle="{StaticResource FP.DataGridCheckBox}" EditingElementStyle="{StaticResource FP.DataGridCheckBox}" Header="Ativo" Binding="{Binding Active}" Width="Auto"/><DataGridTemplateColumn Header="Ações" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.EditTaxRateCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}" Width="36" Height="36" ToolTip="Editar"/><Button Content="&#xE8D8;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.ToggleTaxRateCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}" Width="36" Height="36" Margin="6,0,0,0" ToolTip="Ativar/Desativar"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></TabItem>
<TabItem Header="Plano de Contas"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Cartao}"><StackPanel><TextBlock Text="Conta contabilística" FontSize="16" FontWeight="Bold"/><TextBlock Text="Código" Margin="0,12,0,3"/><TextBox Text="{Binding AccountCode}"/><TextBlock Text="Designação" Margin="0,8,0,3"/><TextBox Text="{Binding AccountName}"/><TextBlock Text="Tipo" Margin="0,8,0,3"/><ComboBox ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding AccountType}"/><TextBlock Text="Natureza" Margin="0,8,0,3"/><ComboBox ItemsSource="{Binding AccountNatures}" SelectedItem="{Binding AccountNature}"/><CheckBox Content="Aceita lançamentos" IsChecked="{Binding AccountAllowsPosting}" Margin="0,10,0,0"/><CheckBox Content="Centro de custo obrigatório" IsChecked="{Binding AccountRequiresCostCenter}" Margin="0,6,0,0"/><Button Content="Guardar conta" Command="{Binding SaveChartAccountCommand}" Style="{StaticResource BaseButton}" Margin="0,14,0,0"/></StackPanel></Border><DataGrid Style="{StaticResource FP.DataGrid}" Grid.Column="2" ItemsSource="{Binding ChartAccounts}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="Auto"/><DataGridTextColumn Header="Conta" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Tipo" Binding="{Binding AccountType}" Width="Auto"/><DataGridTextColumn Header="Natureza" Binding="{Binding Nature}" Width="Auto"/><DataGridCheckBoxColumn ElementStyle="{StaticResource FP.DataGridCheckBox}" EditingElementStyle="{StaticResource FP.DataGridCheckBox}" Header="Lança" Binding="{Binding AllowsPosting}" Width="Auto"/><DataGridCheckBoxColumn ElementStyle="{StaticResource FP.DataGridCheckBox}" EditingElementStyle="{StaticResource FP.DataGridCheckBox}" Header="Ativo" Binding="{Binding Active}" Width="Auto"/><DataGridTemplateColumn Header="Ações" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.EditChartAccountCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}" Width="36" Height="36" ToolTip="Editar"/><Button Content="&#xE8D8;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.ToggleChartAccountCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}" Width="36" Height="36" Margin="6,0,0,0" ToolTip="Ativar/Desativar"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></TabItem>
<TabItem Header="Sequências Documentais"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Cartao}"><StackPanel><TextBlock Text="Sequência documental" FontSize="16" FontWeight="Bold"/><TextBlock Text="Exercício" Margin="0,12,0,3"/><TextBox Text="{Binding SequenceYear}"/><TextBlock Text="Módulo" Margin="0,8,0,3"/><TextBox Text="{Binding SequenceModule}"/><TextBlock Text="Prefixo" Margin="0,8,0,3"/><TextBox Text="{Binding SequencePrefix}"/><TextBlock Text="Número atual" Margin="0,8,0,3"/><TextBox Text="{Binding SequenceCurrentNumber}"/><TextBlock Text="Dígitos" Margin="0,8,0,3"/><TextBox Text="{Binding SequenceDigits}"/><CheckBox Content="Reiniciar anualmente" IsChecked="{Binding SequenceRestartAnnually}" Margin="0,10,0,0"/><Button Content="Guardar sequência" Command="{Binding SaveSequenceCommand}" Style="{StaticResource BaseButton}" Margin="0,14,0,0"/></StackPanel></Border><DataGrid Style="{StaticResource FP.DataGrid}" Grid.Column="2" ItemsSource="{Binding DocumentSequences}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Ano" Binding="{Binding FiscalYear}" Width="Auto"/><DataGridTextColumn Header="Módulo" Binding="{Binding Module}" Width="Auto"/><DataGridTextColumn Header="Prefixo" Binding="{Binding Prefix}" Width="Auto"/><DataGridTextColumn Header="Atual" Binding="{Binding CurrentNumber}" Width="Auto"/><DataGridTextColumn Header="Dígitos" Binding="{Binding Digits}" Width="Auto"/><DataGridCheckBoxColumn ElementStyle="{StaticResource FP.DataGridCheckBox}" EditingElementStyle="{StaticResource FP.DataGridCheckBox}" Header="Anual" Binding="{Binding RestartAnnually}" Width="Auto"/><DataGridCheckBoxColumn ElementStyle="{StaticResource FP.DataGridCheckBox}" EditingElementStyle="{StaticResource FP.DataGridCheckBox}" Header="Ativo" Binding="{Binding Active}" Width="Auto"/><DataGridTemplateColumn Header="Ações" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.EditSequenceCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}" Width="36" Height="36" ToolTip="Editar"/><Button Content="&#xE8D8;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.ToggleSequenceCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}" Width="36" Height="36" Margin="6,0,0,0" ToolTip="Ativar/Desativar"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></TabItem>

<TabItem Header="Calendário Fiscal"><StackPanel Margin="12">
<UniformGrid Columns="4" Margin="0,0,0,12">
<Border Style="{StaticResource Cartao}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Atrasadas" Foreground="{DynamicResource GrayTextBrush}"/><TextBlock Text="{Binding OverdueFiscalObligations}" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource PerigoBrush}"/></StackPanel></Border>
<Border Style="{StaticResource Cartao}" Margin="6,0"><StackPanel><TextBlock Text="Vencem em 7 dias" Foreground="{DynamicResource GrayTextBrush}"/><TextBlock Text="{Binding DueSoonFiscalObligations}" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource AvisoBrush}"/></StackPanel></Border>
<Border Style="{StaticResource Cartao}" Margin="6,0"><StackPanel><TextBlock Text="Cumpridas" Foreground="{DynamicResource GrayTextBrush}"/><TextBlock Text="{Binding CompletedFiscalObligations}" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource SucessoBrush}"/></StackPanel></Border>
<Border Style="{StaticResource Cartao}" Margin="6,0,0,0"><StackPanel><TextBlock Text="Conformidade" Foreground="{DynamicResource GrayTextBrush}"/><TextBlock Text="{Binding FiscalComplianceRate}" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource TealDarkBrush}"/></StackPanel></Border>
</UniformGrid>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Cartao}"><StackPanel><TextBlock Text="Nova obrigação fiscal" FontSize="16" FontWeight="Bold"/><TextBlock Text="Código" Margin="0,12,0,3"/><TextBox Text="{Binding FiscalCode}"/><TextBlock Text="Designação" Margin="0,8,0,3"/><TextBox Text="{Binding FiscalName}"/><TextBlock Text="Categoria" Margin="0,8,0,3"/><ComboBox ItemsSource="{Binding FiscalCategories}" SelectedItem="{Binding FiscalCategory}"/><TextBlock Text="Vencimento" Margin="0,8,0,3"/><DatePicker SelectedDate="{Binding FiscalDueDate}"/><TextBlock Text="Periodicidade" Margin="0,8,0,3"/><ComboBox ItemsSource="{Binding FiscalFrequencies}" SelectedItem="{Binding FiscalFrequency}"/><TextBlock Text="Estado" Margin="0,8,0,3"/><ComboBox ItemsSource="{Binding FiscalStatuses}" SelectedItem="{Binding FiscalStatus}"/><TextBlock Text="Observações" Margin="0,8,0,3"/><TextBox Text="{Binding FiscalNotes}" AcceptsReturn="True" Height="58"/><Button Content="Guardar obrigação" Command="{Binding SaveFiscalObligationCommand}" Style="{StaticResource BaseButton}" Margin="0,14,0,0"/></StackPanel></Border><DataGrid Style="{StaticResource FP.DataGrid}" Grid.Column="2" ItemsSource="{Binding FiscalObligations}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="Auto"/><DataGridTextColumn Header="Obrigação" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="Auto"/><DataGridTextColumn Header="Vencimento" Binding="{Binding DueDate,StringFormat=dd/MM/yyyy}" Width="Auto"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="Auto"/><DataGridCheckBoxColumn ElementStyle="{StaticResource FP.DataGridCheckBox}" EditingElementStyle="{StaticResource FP.DataGridCheckBox}" Header="Ativo" Binding="{Binding Active}" Width="Auto"/><DataGridTemplateColumn Header="Ações" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Cumprida" Command="{Binding DataContext.MarkFiscalCompletedCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SucessoBrush}"/><Button Content="Pendente" Command="{Binding DataContext.MarkFiscalPendingCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AvisoBrush}" Margin="8,0,0,0"/><Button Content="Ativar/Inativar" Command="{Binding DataContext.ToggleFiscalObligationCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Margin="8,0,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid>
</StackPanel></TabItem>
</TabControl><TextBlock Text="{Binding Message}" Foreground="{DynamicResource SucessoBrush}" Margin="0,12,0,0"/></StackPanel></ScrollViewer></UserControl>
