<UserControl x:Class="FinancePro.UI.Views.AdministrationMasterDataView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24"><StackPanel>
<Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Administração" FontSize="22" FontWeight="Bold" Foreground="#0E4C5E"/><TextBlock Text="Dados mestres, plano de contas e sequências documentais" Foreground="#595959" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Atualizar" Command="{Binding RefreshCommand}" Style="{StaticResource BaseButton}" Padding="18,8"/></Grid>
<UniformGrid Columns="4" Margin="0,0,0,16">
<Border Style="{StaticResource Cartao}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Centros ativos" Foreground="#595959"/><TextBlock Text="{Binding ActiveCostCenters}" FontSize="25" FontWeight="Bold" Foreground="#0E4C5E"/></StackPanel></Border>
<Border Style="{StaticResource Cartao}" Margin="6,0"><StackPanel><TextBlock Text="Taxas ativas" Foreground="#595959"/><TextBlock Text="{Binding ActiveTaxRates}" FontSize="25" FontWeight="Bold" Foreground="#0E4C5E"/></StackPanel></Border>
<Border Style="{StaticResource Cartao}" Margin="6,0"><StackPanel><TextBlock Text="Contas ativas" Foreground="#595959"/><TextBlock Text="{Binding ActiveAccounts}" FontSize="25" FontWeight="Bold" Foreground="#0E4C5E"/></StackPanel></Border>
<Border Style="{StaticResource Cartao}" Margin="6,0,0,0"><StackPanel><TextBlock Text="Sequências ativas" Foreground="#595959"/><TextBlock Text="{Binding ActiveSequences}" FontSize="25" FontWeight="Bold" Foreground="#0E4C5E"/></StackPanel></Border></UniformGrid>
<TabControl>
<TabItem Header="Centros de custo"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Cartao}"><StackPanel><TextBlock Text="Novo centro" FontSize="16" FontWeight="Bold"/><TextBlock Text="Código" Margin="0,12,0,3"/><TextBox Text="{Binding CostCode}"/><TextBlock Text="Designação" Margin="0,10,0,3"/><TextBox Text="{Binding CostName}"/><Button Content="Guardar" Command="{Binding SaveCostCenterCommand}" Style="{StaticResource BaseButton}" Margin="0,14,0,0"/></StackPanel></Border><DataGrid Grid.Column="2" ItemsSource="{Binding CostCenters}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="110"/><DataGridTextColumn Header="Designação" Binding="{Binding Name}" Width="*"/><DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Active}" Width="70"/><DataGridTemplateColumn Header="" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Alternar" Command="{Binding DataContext.ToggleCostCenterCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></TabItem>
<TabItem Header="Taxas de IVA"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Cartao}"><StackPanel><TextBlock Text="Nova taxa" FontSize="16" FontWeight="Bold"/><TextBlock Text="Código" Margin="0,12,0,3"/><TextBox Text="{Binding TaxCode}"/><TextBlock Text="Designação" Margin="0,10,0,3"/><TextBox Text="{Binding TaxName}"/><TextBlock Text="Taxa (%)" Margin="0,10,0,3"/><TextBox Text="{Binding TaxRate}"/><Button Content="Guardar" Command="{Binding SaveTaxRateCommand}" Style="{StaticResource BaseButton}" Margin="0,14,0,0"/></StackPanel></Border><DataGrid Grid.Column="2" ItemsSource="{Binding TaxRates}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="100"/><DataGridTextColumn Header="Designação" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Taxa" Binding="{Binding Rate,StringFormat={}{0:N2}%}" Width="80"/><DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Active}" Width="70"/></DataGrid.Columns></DataGrid></Grid></TabItem>
<TabItem Header="Plano de Contas"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Cartao}"><StackPanel><TextBlock Text="Nova conta" FontSize="16" FontWeight="Bold"/><TextBlock Text="Código" Margin="0,12,0,3"/><TextBox Text="{Binding AccountCode}"/><TextBlock Text="Designação" Margin="0,8,0,3"/><TextBox Text="{Binding AccountName}"/><TextBlock Text="Tipo" Margin="0,8,0,3"/><ComboBox ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding AccountType}"/><TextBlock Text="Natureza" Margin="0,8,0,3"/><ComboBox ItemsSource="{Binding AccountNatures}" SelectedItem="{Binding AccountNature}"/><CheckBox Content="Aceita lançamentos" IsChecked="{Binding AccountAllowsPosting}" Margin="0,10,0,0"/><CheckBox Content="Centro de custo obrigatório" IsChecked="{Binding AccountRequiresCostCenter}" Margin="0,6,0,0"/><Button Content="Guardar conta" Command="{Binding SaveChartAccountCommand}" Style="{StaticResource BaseButton}" Margin="0,14,0,0"/></StackPanel></Border><DataGrid Grid.Column="2" ItemsSource="{Binding ChartAccounts}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="110"/><DataGridTextColumn Header="Conta" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Tipo" Binding="{Binding AccountType}" Width="90"/><DataGridTextColumn Header="Natureza" Binding="{Binding Nature}" Width="90"/><DataGridCheckBoxColumn Header="Lança" Binding="{Binding AllowsPosting}" Width="60"/><DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Active}" Width="60"/></DataGrid.Columns></DataGrid></Grid></TabItem>
<TabItem Header="Sequências Documentais"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Cartao}"><StackPanel><TextBlock Text="Nova sequência" FontSize="16" FontWeight="Bold"/><TextBlock Text="Exercício" Margin="0,12,0,3"/><TextBox Text="{Binding SequenceYear}"/><TextBlock Text="Módulo" Margin="0,8,0,3"/><TextBox Text="{Binding SequenceModule}"/><TextBlock Text="Prefixo" Margin="0,8,0,3"/><TextBox Text="{Binding SequencePrefix}"/><TextBlock Text="Número atual" Margin="0,8,0,3"/><TextBox Text="{Binding SequenceCurrentNumber}"/><TextBlock Text="Dígitos" Margin="0,8,0,3"/><TextBox Text="{Binding SequenceDigits}"/><CheckBox Content="Reiniciar anualmente" IsChecked="{Binding SequenceRestartAnnually}" Margin="0,10,0,0"/><Button Content="Guardar sequência" Command="{Binding SaveSequenceCommand}" Style="{StaticResource BaseButton}" Margin="0,14,0,0"/></StackPanel></Border><DataGrid Grid.Column="2" ItemsSource="{Binding DocumentSequences}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Ano" Binding="{Binding FiscalYear}" Width="65"/><DataGridTextColumn Header="Módulo" Binding="{Binding Module}" Width="110"/><DataGridTextColumn Header="Prefixo" Binding="{Binding Prefix}" Width="100"/><DataGridTextColumn Header="Atual" Binding="{Binding CurrentNumber}" Width="85"/><DataGridTextColumn Header="Dígitos" Binding="{Binding Digits}" Width="65"/><DataGridCheckBoxColumn Header="Anual" Binding="{Binding RestartAnnually}" Width="60"/><DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Active}" Width="60"/></DataGrid.Columns></DataGrid></Grid></TabItem>
</TabControl><TextBlock Text="{Binding Message}" Foreground="#0E6B4F" Margin="0,12,0,0"/></StackPanel></ScrollViewer></UserControl>
