<UserControl x:Class="FinancePro.UI.Views.ProjectsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource FundoPrincipalBrush}">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="Financeiro / Projetos" FontSize="11" Foreground="{DynamicResource GrayTextBrush}" Margin="0,0,0,2"/><TextBlock Text="Projetos e Ordens de Trabalho" Style="{StaticResource TituloModulo}" Margin="0"/><TextBlock Text="Planeamento, execução, custos, receitas e rentabilidade por projeto" Style="{StaticResource TextoSecundario}" Margin="0,4,0,0"/></StackPanel><Button HorizontalAlignment="Right" Style="{StaticResource FP.SecondaryButton}" Content="Atualizar" Command="{Binding RefreshCommand}"/></Grid>
  <UniformGrid Columns="4" Margin="0,0,0,16">
   <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource FP.AccentSoft}"><TextBlock Text="&#xECA5;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FP.Accent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Projetos Ativos" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding ActiveProjects}" Style="{StaticResource FP.CompanyKpiValue}" TextWrapping="NoWrap"/></Viewbox></Grid></Grid></Border>
   <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource SucessoSuaveBrush}"><TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SucessoBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Receita Real" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:N0} FCFA}" Style="{StaticResource FP.CompanyKpiValue}" TextWrapping="NoWrap"/></Viewbox></Grid></Grid></Border>
   <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource PerigoSuaveBrush}"><TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource PerigoBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Custo Real" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding TotalCost, StringFormat={}{0:N0} FCFA}" Style="{StaticResource FP.CompanyKpiValue}" TextWrapping="NoWrap"/></Viewbox></Grid></Grid></Border>
   <Border Style="{StaticResource FP.KpiCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource RoxoSuaveBrush}"><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource RoxoBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Resultado" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding TotalResult, StringFormat={}{0:N0} FCFA}" Style="{StaticResource FP.CompanyKpiValue}" TextWrapping="NoWrap"/></Viewbox></Grid></Grid></Border>
  </UniformGrid>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Novo projeto" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,10,10"><TextBlock Text="Código"/><TextBox Text="{Binding Code}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,10"><TextBlock Text="Designação"/><TextBox Text="{Binding Name}"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,10,10"><TextBlock Text="Cliente"/><ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding Client}" DisplayMemberPath="Name"/></StackPanel><StackPanel Grid.Column="3" Margin="0,0,0,10"><TextBlock Text="Centro de custo"/><ComboBox ItemsSource="{Binding CostCenters}" SelectedItem="{Binding CostCenter}" DisplayMemberPath="Name"/></StackPanel>
   <StackPanel Grid.Row="1" Margin="0,0,10,0"><TextBlock Text="Início"/><DatePicker SelectedDate="{Binding Start}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Receita orçada"/><TextBox Text="{Binding BudgetRevenue}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Custo orçado"/><TextBox Text="{Binding BudgetCost}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="3"><TextBlock Text="Estado"/><ComboBox ItemsSource="{Binding ProjectStatuses}" SelectedItem="{Binding Status}"/></StackPanel></Grid><Button Content="Guardar projeto" Command="{Binding SaveProjectCommand}" HorizontalAlignment="Right" Margin="0,12,0,0"/></StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Carteira de projetos" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/><DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" AutoGenerateColumns="False" IsReadOnly="True" Height="260"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Code}"/><DataGridTextColumn Header="Projeto" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Cliente" Binding="{Binding Client}"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}"/><DataGridTextColumn Header="Orç. receita" Binding="{Binding BudgetRevenue, StringFormat=N0}"/><DataGridTextColumn Header="Orç. custo" Binding="{Binding BudgetCost, StringFormat=N0}"/><DataGridTextColumn Header="Receita" Binding="{Binding Revenue, StringFormat=N0}"/><DataGridTextColumn Header="Custo" Binding="{Binding Cost, StringFormat=N0}"/><DataGridTextColumn Header="Resultado" Binding="{Binding Result, StringFormat=N0}"/><DataGridTextColumn Header="Margem %" Binding="{Binding Margin, StringFormat=N1}"/><DataGridTemplateColumn Header="Ações" Width="72"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.EditProjectCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}" Width="36" Height="36" ToolTip="Editar projeto"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ordens de trabalho" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Selecione um projeto acima para filtrar e criar ordens" Foreground="{DynamicResource GrayTextBrush}" Margin="0,3,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,8"><TextBlock Text="Número"/><TextBox Text="{Binding WorkNumber}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,8"><TextBlock Text="Descrição"/><TextBox Text="{Binding WorkDescription}"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,10,8"><TextBlock Text="Custo estimado"/><TextBox Text="{Binding WorkEstimated}"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Estado"/><ComboBox ItemsSource="{Binding WorkStatuses}" SelectedItem="{Binding WorkStatus}"/></StackPanel></Grid><Button Content="Guardar ordem" Command="{Binding SaveWorkOrderCommand}" HorizontalAlignment="Right" Margin="0,4,0,10"/><DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding WorkOrders}" AutoGenerateColumns="False" IsReadOnly="True" Height="210"><DataGrid.Columns><DataGridTextColumn Header="Número" Binding="{Binding Number}"/><DataGridTextColumn Header="Projeto" Binding="{Binding Project}" Width="*"/><DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="2*"/><DataGridTextColumn Header="Data" Binding="{Binding OrderDate, StringFormat=dd/MM/yyyy}"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}"/><DataGridTextColumn Header="Estimado" Binding="{Binding EstimatedCost, StringFormat=N0}"/><DataGridTextColumn Header="Real" Binding="{Binding ActualCost, StringFormat=N0}"/><DataGridTemplateColumn Header="Ações" Width="72"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.EditWorkOrderCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}" Width="36" Height="36" ToolTip="Editar ordem"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></StackPanel></Border>
  <TextBlock Text="{Binding Message}" Foreground="{DynamicResource AvisoBrush}" Margin="0,12,0,0"/>
 </StackPanel></ScrollViewer>
</UserControl>
