<UserControl x:Class="FinancePro.UI.Views.BemView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource FP.Page}" FontFamily="Segoe UI"><Grid Background="{StaticResource FP.Page}"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="22,20" MaxWidth="1500" HorizontalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="Património" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource FP.Text}"/><TextBlock Text="Cadastro, valorização, localização e histórico dos bens patrimoniais." Foreground="{StaticResource FP.TextMuted}" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Border Background="White" BorderBrush="{StaticResource FP.Border}" BorderThickness="1" CornerRadius="9" Height="40" Padding="14,0" Margin="0,0,10,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Accent}" Margin="0,0,8,0"/><StackPanel><TextBlock Text="Última atualização" Foreground="{StaticResource FP.TextMuted}" FontSize="9"/><TextBlock Text="{Binding UltimaAtualizacao}" FontSize="11" FontWeight="SemiBold"/></StackPanel></StackPanel></Border><Button Command="{Binding AtualizarCommand}" Style="{StaticResource FP.SecondaryButton}" Content="Atualizar"/></StackPanel></Grid><UniformGrid Grid.Row="2" Columns="4"><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="TOTAL DE BENS" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding TotalBens}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Itens cadastrados" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="BENS ATIVOS" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding BensAtivos}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Disponíveis em inventário" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="VALOR DE AQUISIÇÃO" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding ValorPatrimonio, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Valor histórico" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="VALOR LÍQUIDO" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding ValorLiquido, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Após depreciação" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border></UniformGrid><Border Grid.Row="4" Style="{StaticResource FP.Card}" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><TextBox Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FilterTextBox}" Padding="38,8,12,8" ToolTip="Número patrimonial ou descrição"/><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.TextMuted}" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="Novo" Command="{Binding NovoCommand}" Style="{StaticResource FP.PrimaryButton}"/><Button Content="Editar" Command="{Binding EditarCommand}" Style="{StaticResource FP.SecondaryButton}" Margin="8,0,0,0"/><Button Content="Exportar" Command="{Binding ExportarCommand}" Style="{StaticResource FP.SecondaryButton}" Margin="8,0,0,0"/></StackPanel></Grid></Border><Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.Card}" Padding="0"><DataGrid ItemsSource="{Binding Bens}" SelectedItem="{Binding BemSelecionado}" Style="{StaticResource FP.DataGrid}"><DataGrid.Columns><DataGridTextColumn Header="Nº PATRIMONIAL" Binding="{Binding NumeroPatrimonial}" Width="120"/><DataGridTextColumn Header="DESCRIÇÃO" Binding="{Binding Descricao}" Width="*"/><DataGridTextColumn Header="CATEGORIA" Binding="{Binding Categoria}" Width="115"/><DataGridTextColumn Header="LOCALIZAÇÃO" Binding="{Binding Localizacao}" Width="120"/><DataGridTextColumn Header="RESPONSÁVEL" Binding="{Binding Responsavel}" Width="120"/><DataGridTextColumn Header="AQUISIÇÃO" Binding="{Binding ValorAquisicao, Converter={StaticResource ValorMoeda}}" Width="120"/><DataGridTextColumn Header="VALOR LÍQUIDO" Binding="{Binding ValorLiquidoAtual, Converter={StaticResource ValorMoeda}}" Width="120"/><DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="90"/></DataGrid.Columns></DataGrid></Border><Border Grid.Column="2" Style="{StaticResource FP.Card}"><StackPanel><TextBlock Text="Dados do bem" Style="{StaticResource FP.SectionTitle}"/><TextBlock Text="Registe ou atualize a ficha patrimonial." Style="{StaticResource FP.KpiHint}" Margin="0,0,0,14"/><TextBlock Text="Número patrimonial" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding NumeroPatrimonial}"/><TextBlock Text="Descrição" Style="{StaticResource FP.FieldLabel}" Margin="0,10,0,0"/><TextBox Text="{Binding Descricao}"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Categoria" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Categoria}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Marca" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Marca}"/></StackPanel></Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Modelo" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Modelo}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Série" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Serie}"/></StackPanel></Grid><TextBlock Text="Localização" Style="{StaticResource FP.FieldLabel}" Margin="0,10,0,0"/><TextBox Text="{Binding Localizacao}"/><TextBlock Text="Responsável" Style="{StaticResource FP.FieldLabel}" Margin="0,10,0,0"/><TextBox Text="{Binding Responsavel}"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Data aquisição" Style="{StaticResource FP.FieldLabel}"/><DatePicker SelectedDate="{Binding DataAquisicao}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Valor aquisição" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding ValorAquisicaoTexto}"/></StackPanel></Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Vida útil (anos)" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding VidaUtilAnosTexto}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Depreciação" Style="{StaticResource FP.FieldLabel}"/><ComboBox ItemsSource="{Binding MetodosDisponiveis}" SelectedItem="{Binding MetodoDepreciacaoSelecionado}"/></StackPanel></Grid><TextBlock Text="{Binding MensagemErro}" Foreground="{StaticResource FP.Danger}" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="{Binding MensagemInfo}" Foreground="{StaticResource FP.Success}" TextWrapping="Wrap" Margin="0,6,0,0"/><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="Guardar" Command="{Binding GuardarCommand}" Style="{StaticResource FP.PrimaryButton}" Width="120"/><Button Content="Eliminar/Abater" Command="{Binding EliminarCommand}" Style="{StaticResource FP.SecondaryButton}" Foreground="{StaticResource FP.Danger}" Margin="8,0,0,0" Visibility="{Binding PodeEliminar, Converter={StaticResource BoolParaVisibilidade}}"/></StackPanel></StackPanel></Border></Grid></Grid></ScrollViewer></Grid></UserControl>