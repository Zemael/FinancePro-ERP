<UserControl x:Class="FinancePro.UI.Views.BemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FundoCartaoBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BordaBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource GrayTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="TituloModulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TealDarkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="TextoSecundario" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource GrayTextBrush}"/>
        </Style>
        <Style x:Key="TextoDica" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{DynamicResource GraySubBrush}"/>
        </Style>
        <Style x:Key="CabecalhoTabelaSpec" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="CelulaTabelaSpec" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoPrincipalBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <TextBlock Text="Gestão Patrimonial" Style="{StaticResource TituloModulo}"/>
            <TextBlock Text="Bens patrimoniais da empresa, com depreciação estimada e histórico de auditoria"
                       Style="{StaticResource TextoSecundario}" Margin="0,0,0,14"/>

            <!-- Toolbar -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Novo" Style="{StaticResource BotaoToolbar}" Command="{Binding NovoCommand}"/>
                <Button Content="Editar" Style="{StaticResource BotaoToolbar}" Command="{Binding EditarCommand}"/>
                <Button Content="Guardar" Style="{StaticResource BotaoToolbar}" Command="{Binding GuardarCommand}"/>
                <Button Content="Eliminar" Style="{StaticResource BotaoToolbarPerigo}" Command="{Binding EliminarCommand}"
                        Visibility="{Binding PodeEliminar, Converter={StaticResource BoolParaVisibilidade}}"/>
                <Button Content="Exportar" Style="{StaticResource BotaoToolbar}" Command="{Binding ExportarCommand}"/>
                <TextBlock Text="(Eliminar requer perfil Administrador ou Gestor)" Style="{StaticResource TextoDica}"
                           VerticalAlignment="Center" Margin="4,0,0,0"
                           Visibility="{Binding PodeEliminar, Converter={StaticResource BoolParaVisibilidade}, ConverterParameter=Inverso}"/>
            </StackPanel>

            <!-- Filtros e pesquisa -->
            <Border Style="{StaticResource Cartao}" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Pesquisar (nº patrimonial ou descrição):" VerticalAlignment="Center" Style="{StaticResource TextoSecundario}" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}" Width="280" Height="30"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding MensagemErro}" Foreground="#C00000" FontSize="10.5"
                       Margin="0,0,0,10" TextWrapping="Wrap"
                       Visibility="{Binding MensagemErro, Converter={StaticResource TextoParaVisibilidade}}"/>
            <TextBlock Text="{Binding MensagemInfo}" Foreground="#0F6E56" FontSize="10.5"
                       Margin="0,0,0,10" TextWrapping="Wrap"
                       Visibility="{Binding MensagemInfo, Converter={StaticResource TextoParaVisibilidade}}"/>

            <!-- DataGrid principal -->
            <TextBlock Text="Bens" Style="{StaticResource RotuloSeccaoModulo}"/>
            <Border Style="{StaticResource Cartao}" Padding="0" Margin="0,0,0,16">
                <DataGrid ItemsSource="{Binding Bens}" SelectedItem="{Binding BemSelecionado, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="32" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nº Patrim." Binding="{Binding NumeroPatrimonial}" Width="90"/>
                        <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
                        <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="100"/>
                        <DataGridTextColumn Header="Responsável" Binding="{Binding Responsavel}" Width="110"/>
                        <DataGridTextColumn Header="Aquisição" Binding="{Binding ValorAquisicao, Converter={StaticResource ValorMoeda}}" Width="110"/>
                        <DataGridTextColumn Header="Valor Líquido" Binding="{Binding ValorLiquidoAtual, Converter={StaticResource ValorMoeda}}" Width="110"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Detalhes · Histórico · Anexos · Auditoria · Campos Propostos -->
            <TextBlock Text="Detalhes · Histórico · Anexos · Auditoria · Campos Propostos" Style="{StaticResource RotuloSeccaoModulo}"/>
            <Border Style="{StaticResource Cartao}">
                <TabControl>
                    <TabItem Header="Detalhes">
                        <StackPanel Margin="0,12,0,0">
                            <Grid IsEnabled="{Binding EmEdicao}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Número patrimonial" Style="{StaticResource Rotulo}"/>
                                    <TextBox Text="{Binding NumeroPatrimonial, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Descrição" Style="{StaticResource Rotulo}"/>
                                    <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Categoria" Style="{StaticResource Rotulo}"/>
                                    <TextBox Text="{Binding Categoria, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0" IsEnabled="{Binding EmEdicao}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Marca" Style="{StaticResource Rotulo}"/>
                                    <TextBox Text="{Binding Marca, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Modelo" Style="{StaticResource Rotulo}"/>
                                    <TextBox Text="{Binding Modelo, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Série" Style="{StaticResource Rotulo}"/>
                                    <TextBox Text="{Binding Serie, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0" IsEnabled="{Binding EmEdicao}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Localização" Style="{StaticResource Rotulo}"/>
                                    <TextBox Text="{Binding Localizacao, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Responsável" Style="{StaticResource Rotulo}"/>
                                    <TextBox Text="{Binding Responsavel, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0" IsEnabled="{Binding EmEdicao}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Data de aquisição" Style="{StaticResource Rotulo}"/>
                                    <DatePicker SelectedDate="{Binding DataAquisicao}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Valor de aquisição (FCFA)" Style="{StaticResource Rotulo}"/>
                                    <TextBox Text="{Binding ValorAquisicaoTexto, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Vida útil (anos)" Style="{StaticResource Rotulo}"/>
                                    <TextBox Text="{Binding VidaUtilAnosTexto, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,14,0,0" IsEnabled="{Binding EmEdicao}">
                                <TextBlock Text="Método de depreciação" Style="{StaticResource Rotulo}"/>
                                <ComboBox ItemsSource="{Binding MetodosDisponiveis}" SelectedItem="{Binding MetodoDepreciacaoSelecionado}" Width="220" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <TextBlock Text="Clique em &quot;Novo&quot; para criar, ou selecione uma linha e clique em &quot;Editar&quot;."
                                       Style="{StaticResource TextoDica}" Margin="0,14,0,0"
                                       Visibility="{Binding EmEdicao, Converter={StaticResource BoolParaVisibilidade}, ConverterParameter=Inverso}"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Histórico">
                        <TextBlock Text="Em breve — histórico de valores anteriores campo a campo." Style="{StaticResource TextoSecundario}" Margin="0,16,0,0"/>
                    </TabItem>

                    <TabItem Header="Anexos">
                        <TextBlock Text="Em breve — anexar documentos (fatura, garantia, fotos) a este bem." Style="{StaticResource TextoSecundario}" Margin="0,16,0,0"/>
                    </TabItem>

                    <TabItem Header="Auditoria">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Sem registos de auditoria para este bem." Style="{StaticResource TextoDica}" Margin="0,0,0,8"
                                       Visibility="{Binding HistoricoAuditoria.Count, Converter={StaticResource ContagemParaVisibilidade}, ConverterParameter=Inverso}"/>
                            <ItemsControl ItemsSource="{Binding HistoricoAuditoria}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BordaBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Acao}" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource TealDarkBrush}"/>
                                                    <TextBlock Text=" · " FontSize="10.5" Foreground="{DynamicResource GraySubBrush}"/>
                                                    <TextBlock Text="{Binding UtilizadorNome}" FontSize="10.5" Foreground="{DynamicResource GrayTextBrush}"/>
                                                    <TextBlock Text=" · " FontSize="10.5" Foreground="{DynamicResource GraySubBrush}"/>
                                                    <TextBlock Text="{Binding Data, StringFormat=dd/MM/yyyy HH:mm}" FontSize="10.5" Foreground="{DynamicResource GraySubBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detalhe}" FontSize="10" Foreground="{DynamicResource GrayTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Campos Propostos">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Especificação de referência para este módulo — Campo = cabeçalho da tabela, Tipo = tipo de dados real da coluna, Obrigatório = informação indispensável."
                                       Style="{StaticResource TextoDica}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <Border BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource TealBrush}" Padding="10,7"><TextBlock Text="Campo" Style="{StaticResource CabecalhoTabelaSpec}"/></Border>
                                        <Border Grid.Column="1" Background="{DynamicResource TealBrush}" Padding="10,7"><TextBlock Text="Tipo (coluna real)" Style="{StaticResource CabecalhoTabelaSpec}"/></Border>
                                        <Border Grid.Column="2" Background="{DynamicResource TealBrush}" Padding="10,7"><TextBlock Text="Obrigatório" Style="{StaticResource CabecalhoTabelaSpec}"/></Border>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding CamposPropostos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Padding="10,7" Background="{DynamicResource FundoCartaoBrush}"><TextBlock Text="{Binding Campo}" Style="{StaticResource CelulaTabelaSpec}"/></Border>
                                                    <Border Grid.Column="1" Padding="10,7" Background="{DynamicResource FundoCartaoBrush}"><TextBlock Text="{Binding Tipo}" Style="{StaticResource CelulaTabelaSpec}"/></Border>
                                                    <Border Grid.Column="2" Padding="10,7" Background="{DynamicResource FundoCartaoBrush}"><TextBlock Text="{Binding Obrigatorio}" Style="{StaticResource CelulaTabelaSpec}"/></Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
