<UserControl x:Class="FinancePro.UI.Views.CompraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="BorderBrush" Value="#DCEAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#595959"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="BotaoLink" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Compras" FontSize="16" FontWeight="Bold" Foreground="#0E4C5E" Margin="0,0,0,4"/>
                    <TextBlock Text="Pedidos de compra a fornecedores, com fluxo de aprovação"
                               FontSize="10.5" Foreground="#595959"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Atualizar" Command="{Binding AtualizarCommand}"
                        Height="40" Padding="14,0" VerticalAlignment="Top"
                        Background="#EAF4F7" Foreground="#156082" BorderBrush="#BFD9E2"
                        FontWeight="SemiBold"/>
            </Grid>

            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Fornecedor" Style="{StaticResource Rotulo}"/>
                            <ComboBox ItemsSource="{Binding Fornecedores}" SelectedItem="{Binding FornecedorSelecionado}" DisplayMemberPath="Nome"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Data" Style="{StaticResource Rotulo}"/>
                            <DatePicker SelectedDate="{Binding Data}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Prioridade" Style="{StaticResource Rotulo}"/>
                            <ComboBox ItemsSource="{Binding PrioridadesDisponiveis}" SelectedItem="{Binding Prioridade}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Departamento" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding Departamento, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Centro de custo" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding CentroCusto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Valor total" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding ValorTotalTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Projeto" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding Projeto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Comprador" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding Comprador, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding MensagemErro}" Foreground="#C00000" FontSize="10.5"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding MensagemErro, Converter={StaticResource TextoParaVisibilidade}}"/>
                    <TextBlock Text="{Binding MensagemSucesso}" Foreground="#0F6E56" FontSize="10.5"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding MensagemSucesso, Converter={StaticResource TextoParaVisibilidade}}"/>

                    <Button Content="{Binding AGuardar, Converter={StaticResource OcupadoParaTexto}, ConverterParameter=Criar pedido}"
                            Command="{Binding CriarCommand}"
                            Width="150" Height="40" HorizontalAlignment="Left" Margin="0,16,0,0"
                            Background="#156082" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Pedidos de Compra" FontSize="13" FontWeight="Bold" Foreground="#0E4C5E" Margin="0,20,0,10"/>

            <Border Style="{StaticResource Cartao}" Padding="0">
                <DataGrid ItemsSource="{Binding Compras}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nº Pedido" Binding="{Binding NumeroPedido}" Width="90"/>
                        <DataGridTextColumn Header="Fornecedor" Binding="{Binding FornecedorNome}" Width="*"/>
                        <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy}" Width="85"/>
                        <DataGridTextColumn Header="Prioridade" Binding="{Binding Prioridade}" Width="80"/>
                        <DataGridTextColumn Header="Valor" Binding="{Binding ValorTotal, Converter={StaticResource ValorMoeda}}" Width="110"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90"/>
                        <DataGridTextColumn Header="Cotação" Binding="{Binding NumeroCotacao}" Width="90"/>
                        <DataGridTextColumn Header="Ordem" Binding="{Binding NumeroOrdemCompra}" Width="90"/>
                        <DataGridTemplateColumn Header="Fluxo" Width="390">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <WrapPanel>
                                        <Button Content="Cotar" Style="{StaticResource BotaoLink}" Foreground="#156082"
                                                Visibility="{Binding PodeCotar, Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.CotarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <Button Content="Aprovar" Style="{StaticResource BotaoLink}" Foreground="#0F6E56"
                                                Visibility="{Binding PodeAprovar, Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.AprovarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Rejeitar" Style="{StaticResource BotaoLink}" Foreground="#E97132"
                                                Visibility="{Binding PodeRejeitar, Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.RejeitarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Cancelar" Style="{StaticResource BotaoLink}" Foreground="#C00000"
                                                Visibility="{Binding PodeCancelar, Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.CancelarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                                                            <Button Content="Emitir ordem" Style="{StaticResource BotaoLink}" Foreground="#156082"
                                                Visibility="{Binding PodeEmitirOrdem, Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.EmitirOrdemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <Button Content="Receber" Style="{StaticResource BotaoLink}" Foreground="#0F6E56"
                                                Visibility="{Binding PodeReceber, Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.ReceberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <Button Content="Faturar" Style="{StaticResource BotaoLink}" Foreground="#7030A0"
                                                Visibility="{Binding PodeFaturar, Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.FaturarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </WrapPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
