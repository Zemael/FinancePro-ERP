<UserControl x:Class="FinancePro.UI.Views.CompraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Financeiro / Compras" FontSize="11" Foreground="{DynamicResource GrayTextBrush}" Margin="0,0,0,2"/>
                    <TextBlock Text="Compras" Style="{StaticResource TituloModulo}" Margin="0,0,0,4"/>
                    <TextBlock Text="Pedidos de compra a fornecedores, com fluxo de aprovação"
                               Style="{StaticResource TextoSecundario}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Atualizar" Command="{Binding AtualizarCommand}"
                        Style="{StaticResource FP.SecondaryButton}" VerticalAlignment="Top"/>
            </Grid>

            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Fornecedor" Style="{StaticResource Rotulo}"/>
                            <ComboBox ItemsSource="{Binding Fornecedores}" SelectedItem="{Binding FornecedorSelecionado}" DisplayMemberPath="Nome"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Data" Style="{StaticResource Rotulo}"/>
                            <DatePicker SelectedDate="{Binding Data}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Prioridade" Style="{StaticResource Rotulo}"/>
                            <ComboBox ItemsSource="{Binding PrioridadesDisponiveis}" SelectedItem="{Binding Prioridade}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Departamento" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding Departamento, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Centro de custo" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding CentroCusto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Valor total" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding ValorTotalTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Projeto" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding Projeto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Comprador" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding Comprador, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding MensagemErro}" Foreground="{DynamicResource PerigoBrush}" FontSize="10.5"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding MensagemErro, Converter={StaticResource TextoParaVisibilidade}}"/>
                    <TextBlock Text="{Binding MensagemSucesso}" Foreground="{DynamicResource SucessoBrush}" FontSize="10.5"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding MensagemSucesso, Converter={StaticResource TextoParaVisibilidade}}"/>

                    <Button Style="{StaticResource BotaoPrimario}" Content="{Binding AGuardar, Converter={StaticResource OcupadoParaTexto}, ConverterParameter=Criar pedido}"
                            Command="{Binding CriarCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Pedidos de Compra" Style="{StaticResource FP.SectionTitle}" Margin="0,20,0,10"/>

            <Border Style="{StaticResource Cartao}" Padding="0">
                <DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding Compras}" SelectedItem="{Binding CompraSelecionada}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nº Pedido" Binding="{Binding NumeroPedido}" Width="Auto"/>
                        <DataGridTextColumn Header="Fornecedor" Binding="{Binding FornecedorNome}" Width="*"/>
                        <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy}" Width="Auto"/>
                        <DataGridTextColumn Header="Prioridade" Binding="{Binding Prioridade}" Width="Auto"/>
                        <DataGridTextColumn Header="Valor" Binding="{Binding ValorTotal, Converter={StaticResource ValorMoeda}}" Width="Auto"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="Auto"/>
                        <DataGridTextColumn Header="Cotação" Binding="{Binding NumeroCotacao}" Width="Auto"/>
                        <DataGridTextColumn Header="Ordem" Binding="{Binding NumeroOrdemCompra}" Width="Auto"/>
                        <DataGridTemplateColumn Header="Fluxo" Width="390">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <WrapPanel>
                                        <Button Content="Cotar" Style="{StaticResource BotaoLink}" Foreground="{DynamicResource TealBrush}"
                                                Visibility="{Binding PodeCotar, Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.CotarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <Button Content="Aprovar" Style="{StaticResource BotaoLink}" Foreground="{DynamicResource SucessoBrush}"
                                                Visibility="{Binding PodeAprovar, Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.AprovarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Rejeitar" Style="{StaticResource BotaoLink}" Foreground="{DynamicResource AvisoBrush}"
                                                Visibility="{Binding PodeRejeitar, Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.RejeitarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Cancelar" Style="{StaticResource BotaoLink}" Foreground="{DynamicResource PerigoBrush}"
                                                Visibility="{Binding PodeCancelar, Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.CancelarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                                                            <Button Content="Emitir ordem" Style="{StaticResource BotaoLink}" Foreground="{DynamicResource TealBrush}"
                                                Visibility="{Binding PodeEmitirOrdem, Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.EmitirOrdemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <Button Content="Receber" Style="{StaticResource BotaoLink}" Foreground="{DynamicResource SucessoBrush}"
                                                Visibility="{Binding PodeReceber, Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.ReceberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <Button Content="Faturar" Style="{StaticResource BotaoLink}" Foreground="{DynamicResource FP.Accent}"
                                                Visibility="{Binding PodeFaturar, Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.FaturarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </WrapPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock Text="Itens do pedido selecionado" Style="{StaticResource FP.SectionTitle}" Margin="0,20,0,10"/>
            <Border Style="{StaticResource Cartao}"><StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding ProdutosItens}" SelectedItem="{Binding ProdutoItemSelecionado}" DisplayMemberPath="Nome"/>
                    <TextBox Grid.Column="2" Text="{Binding QuantidadeItem}" ToolTip="Quantidade"/><TextBox Grid.Column="4" Text="{Binding PrecoItem}" ToolTip="Preço unitário"/><TextBox Grid.Column="6" Text="{Binding DescontoItem}" ToolTip="Desconto %"/><TextBox Grid.Column="8" Text="{Binding IvaItem}" ToolTip="IVA %"/>
                    <Button Grid.Column="10" Content="Adicionar" Style="{StaticResource BotaoPrimario}" Command="{Binding AdicionarItemCommand}"/>
                </Grid>
                <DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding Itens}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,12,0,0" Height="170"><DataGrid.Columns><DataGridTextColumn Header="Produto" Binding="{Binding ProdutoNome}" Width="*"/><DataGridTextColumn Header="Qtd." Binding="{Binding Quantidade}" Width="Auto"/><DataGridTextColumn Header="Preço" Binding="{Binding PrecoUnitario}" Width="Auto"/><DataGridTextColumn Header="Desc.%" Binding="{Binding DescontoPercentual}" Width="Auto"/><DataGridTextColumn Header="IVA%" Binding="{Binding IvaPercentual}" Width="Auto"/><DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="Auto"/><DataGridTemplateColumn Header="" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Remover" Style="{StaticResource BotaoLink}" Foreground="{DynamicResource PerigoBrush}" Command="{Binding DataContext.RemoverItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
            </StackPanel></Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
