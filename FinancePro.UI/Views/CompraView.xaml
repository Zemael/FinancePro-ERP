<UserControl x:Class="FinancePro.UI.Views.CompraView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource FP.Page}" FontFamily="Segoe UI">
<Grid Background="{StaticResource FP.Page}"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="22,20" MaxWidth="1500" HorizontalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock Text="Compras" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource FP.Text}"/><TextBlock Text="Pedidos, aprovações e controlo de aquisições a fornecedores." Foreground="{StaticResource FP.TextMuted}" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Border Background="White" BorderBrush="{StaticResource FP.Border}" BorderThickness="1" CornerRadius="9" Height="40" Padding="14,0" Margin="0,0,10,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Accent}" Margin="0,0,8,0"/><StackPanel><TextBlock Text="Última atualização" Foreground="{StaticResource FP.TextMuted}" FontSize="9"/><TextBlock Text="{Binding UltimaAtualizacao}" FontSize="11" FontWeight="SemiBold"/></StackPanel></StackPanel></Border><Button Command="{Binding AtualizarCommand}" Style="{StaticResource FP.SecondaryButton}" Content="Atualizar"/></StackPanel></Grid>
<UniformGrid Grid.Row="2" Columns="4"><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="TOTAL DE PEDIDOS" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding TotalPedidos}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Pedidos registados" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="PENDENTES" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding PedidosPendentes}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Aguardam decisão" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="APROVADOS" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding PedidosAprovados}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Pedidos autorizados" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="VALOR TOTAL" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding ValorPedidos, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Volume solicitado" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border></UniformGrid>
<Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="18,15,18,12"><TextBlock Text="Pedidos de compra" Style="{StaticResource FP.SectionTitle}"/><TextBlock Text="Aprove, rejeite ou cancele pedidos diretamente na lista." Style="{StaticResource FP.KpiHint}"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Compras}" Style="{StaticResource FP.DataGrid}"><DataGrid.Columns><DataGridTextColumn Header="Nº PEDIDO" Binding="{Binding NumeroPedido}" Width="95"/><DataGridTextColumn Header="FORNECEDOR" Binding="{Binding FornecedorNome}" Width="*"/><DataGridTextColumn Header="DATA" Binding="{Binding Data, StringFormat=dd/MM/yyyy}" Width="90"/><DataGridTextColumn Header="PRIORIDADE" Binding="{Binding Prioridade}" Width="90"/><DataGridTextColumn Header="VALOR" Binding="{Binding ValorTotal, Converter={StaticResource ValorMoeda}}" Width="120"/><DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="100"/><DataGridTemplateColumn Header="AÇÕES" Width="175"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Aprovar" Style="{StaticResource FP.LinkButton}" Foreground="{StaticResource FP.Success}" Visibility="{Binding PodeAprovar, Converter={StaticResource BoolParaVisibilidade}}" Command="{Binding DataContext.AprovarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Content="Rejeitar" Style="{StaticResource FP.LinkButton}" Foreground="{StaticResource FP.Warning}" Visibility="{Binding PodeRejeitar, Converter={StaticResource BoolParaVisibilidade}}" Command="{Binding DataContext.RejeitarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Content="Cancelar" Style="{StaticResource FP.LinkButton}" Foreground="{StaticResource FP.Danger}" Visibility="{Binding PodeCancelar, Converter={StaticResource BoolParaVisibilidade}}" Command="{Binding DataContext.CancelarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></Border>
<Border Grid.Column="2" Style="{StaticResource FP.Card}"><StackPanel><TextBlock Text="Novo pedido" Style="{StaticResource FP.SectionTitle}"/><TextBlock Text="Registe os dados essenciais da aquisição." Style="{StaticResource FP.KpiHint}" Margin="0,0,0,14"/><TextBlock Text="Fornecedor" Style="{StaticResource FP.FieldLabel}"/><ComboBox ItemsSource="{Binding Fornecedores}" SelectedItem="{Binding FornecedorSelecionado}" DisplayMemberPath="Nome"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Data" Style="{StaticResource FP.FieldLabel}"/><DatePicker SelectedDate="{Binding Data}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Prioridade" Style="{StaticResource FP.FieldLabel}"/><ComboBox ItemsSource="{Binding PrioridadesDisponiveis}" SelectedItem="{Binding Prioridade}"/></StackPanel></Grid><TextBlock Text="Departamento" Style="{StaticResource FP.FieldLabel}" Margin="0,10,0,0"/><TextBox Text="{Binding Departamento}"/><TextBlock Text="Centro de custo" Style="{StaticResource FP.FieldLabel}" Margin="0,10,0,0"/><TextBox Text="{Binding CentroCusto}"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Projeto" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Projeto}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Comprador" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Comprador}"/></StackPanel></Grid><TextBlock Text="Valor total" Style="{StaticResource FP.FieldLabel}" Margin="0,10,0,0"/><TextBox Text="{Binding ValorTotalTexto}"/><TextBlock Text="{Binding MensagemErro}" Foreground="{StaticResource FP.Danger}" TextWrapping="Wrap" Margin="0,12,0,0"/><Button Content="Criar pedido" Command="{Binding CriarCommand}" Style="{StaticResource FP.PrimaryButton}" Margin="0,16,0,0" HorizontalAlignment="Stretch"/></StackPanel></Border></Grid>
</Grid></ScrollViewer></Grid></UserControl>