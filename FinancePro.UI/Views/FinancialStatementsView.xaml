<UserControl x:Class="FinancePro.UI.Views.FinancialStatementsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource FP.Page}">
 <Grid Margin="26,22,26,26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="Contabilidade  ›  Demonstrações Financeiras" Foreground="{DynamicResource FP.TextMuted}" FontSize="11"/>
    <TextBlock Text="Demonstrações Financeiras" Foreground="{DynamicResource FP.Text}" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/>
    <TextBlock Text="Posição patrimonial, desempenho, fluxos financeiros e balancete de suporte." Foreground="{DynamicResource FP.TextMuted}" FontSize="12" Margin="0,5,0,0"/>
   </StackPanel>
   <Button Grid.Column="1" Content="Atualizar tudo" Command="{Binding RefreshCommand}" Style="{StaticResource FP.PrimaryButton}" VerticalAlignment="Center"/>
  </Grid>

  <Border Grid.Row="2" Style="{StaticResource FP.Card}">
   <TabControl>
    <TabItem Header="Balanço Patrimonial">
     <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal"><StackPanel><TextBlock Text="Data do balanço" Foreground="{DynamicResource FP.TextMuted}" FontSize="11"/><DatePicker SelectedDate="{Binding ReportTo}" Margin="0,5,10,0"/></StackPanel><StackPanel><TextBlock Text="Comparativo" Foreground="{DynamicResource FP.TextMuted}" FontSize="11"/><DatePicker SelectedDate="{Binding PreviousReportTo}" Margin="0,5,10,0"/></StackPanel><Button Content="Gerar Balanço" Command="{Binding LoadBalanceSheetCommand}" Style="{StaticResource FP.PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,8,0"/><Button Content="Exportar CSV" Command="{Binding ExportBalanceSheetCommand}" Style="{StaticResource FP.SecondaryButton}" VerticalAlignment="Bottom"/></StackPanel>
      <UniformGrid Grid.Row="2" Columns="4"><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Total do Ativo" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding BalanceAssets, StringFormat=N2}" FontSize="20" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Total do Passivo" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding BalanceLiabilities, StringFormat=N2}" FontSize="20" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Património Líquido" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding BalanceEquity, StringFormat=N2}" FontSize="20" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="Diferença de controlo" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding BalanceDifference, StringFormat=N2}" FontSize="20" FontWeight="Bold"/></StackPanel></Border></UniformGrid>
      <DataGrid Grid.Row="4" ItemsSource="{Binding BalanceSheetRows}" Style="{StaticResource FP.DataGrid}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding AccountCode}" Width="Auto"/><DataGridTextColumn Header="Conta" Binding="{Binding AccountName}" Width="*"/><DataGridTextColumn Header="Secção" Binding="{Binding Section}" Width="Auto"/><DataGridTextColumn Header="Atual" Binding="{Binding CurrentAmount, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Comparativo" Binding="{Binding PreviousAmount, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Variação" Binding="{Binding Variation, StringFormat=N2}" Width="Auto"/></DataGrid.Columns></DataGrid>
     </Grid>
    </TabItem>

    <TabItem Header="Demonstração de Resultados">
     <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal"><StackPanel><TextBlock Text="Período atual" Foreground="{DynamicResource FP.TextMuted}" FontSize="11"/><DatePicker SelectedDate="{Binding ReportFrom}" Margin="0,5,6,0"/></StackPanel><DatePicker SelectedDate="{Binding ReportTo}" VerticalAlignment="Bottom" Margin="0,0,14,0"/><StackPanel><TextBlock Text="Comparativo" Foreground="{DynamicResource FP.TextMuted}" FontSize="11"/><DatePicker SelectedDate="{Binding PreviousReportFrom}" Margin="0,5,6,0"/></StackPanel><DatePicker SelectedDate="{Binding PreviousReportTo}" VerticalAlignment="Bottom" Margin="0,0,14,0"/><Button Content="Gerar DRE" Command="{Binding LoadIncomeStatementCommand}" Style="{StaticResource FP.PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,8,0"/><Button Content="Exportar CSV" Command="{Binding ExportIncomeStatementCommand}" Style="{StaticResource FP.SecondaryButton}" VerticalAlignment="Bottom"/></StackPanel>
      <UniformGrid Grid.Row="2" Columns="4"><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Receita líquida" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding NetRevenue, StringFormat=N2}" FontSize="20" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Lucro bruto" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding GrossProfit, StringFormat=N2}" FontSize="20" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Resultado operacional" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding OperatingResult, StringFormat=N2}" FontSize="20" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="Resultado líquido" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding NetResult, StringFormat=N2}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SucessoBrush}"/><TextBlock Text="{Binding NetMargin, StringFormat='Margem: {0:N1}%'}" Foreground="{DynamicResource FP.TextMuted}" FontSize="10"/></StackPanel></Border></UniformGrid>
      <DataGrid Grid.Row="4" ItemsSource="{Binding IncomeStatementRows}" Style="{StaticResource FP.DataGrid}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="Auto"/><DataGridTextColumn Header="Conta" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Grupo" Binding="{Binding LineType}" Width="Auto"/><DataGridTextColumn Header="Período atual" Binding="{Binding CurrentAmount, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Anterior" Binding="{Binding PreviousAmount, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Variação" Binding="{Binding Variation, StringFormat=N2}" Width="Auto"/></DataGrid.Columns></DataGrid>
     </Grid>
    </TabItem>

    <TabItem Header="Fluxo de Caixa">
     <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal"><DatePicker SelectedDate="{Binding ReportFrom}" Margin="0,0,8,0"/><DatePicker SelectedDate="{Binding ReportTo}" Margin="0,0,14,0"/><ComboBox ItemsSource="{Binding CashFlowMethods}" SelectedItem="{Binding CashFlowMethodSelected}" MinWidth="150" Margin="0,0,14,0"/><Button Content="Gerar Fluxo" Command="{Binding LoadCashFlowCommand}" Style="{StaticResource FP.PrimaryButton}" Margin="0,0,8,0"/><Button Content="Exportar CSV" Command="{Binding ExportCashFlowCommand}" Style="{StaticResource FP.SecondaryButton}"/></StackPanel>
      <UniformGrid Grid.Row="2" Columns="5"><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Saldo inicial" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding CashOpeningBalance, StringFormat=N2}" FontSize="19" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Operacional" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding CashOperatingNet, StringFormat=N2}" FontSize="19" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Investimento" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding CashInvestingNet, StringFormat=N2}" FontSize="19" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Financiamento" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding CashFinancingNet, StringFormat=N2}" FontSize="19" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="Saldo final" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding CashClosingBalance, StringFormat=N2}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource SucessoBrush}"/></StackPanel></Border></UniformGrid>
      <DataGrid Grid.Row="4" ItemsSource="{Binding CashFlowRows}" Style="{StaticResource FP.DataGrid}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="Auto"/><DataGridTextColumn Header="Documento" Binding="{Binding DocumentNumber}" Width="Auto"/><DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Atividade" Binding="{Binding Activity}" Width="Auto"/><DataGridTextColumn Header="Entradas" Binding="{Binding Inflow, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Saídas" Binding="{Binding Outflow, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Líquido" Binding="{Binding NetAmount, StringFormat=N2}" Width="Auto"/></DataGrid.Columns></DataGrid>
     </Grid>
    </TabItem>

    <TabItem Header="Balancete de suporte">
     <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal"><DatePicker SelectedDate="{Binding ReportFrom}" Margin="0,0,8,0"/><DatePicker SelectedDate="{Binding ReportTo}" Margin="0,0,14,0"/><Button Content="Gerar Balancete" Command="{Binding LoadTrialBalanceCommand}" Style="{StaticResource FP.PrimaryButton}" Margin="0,0,8,0"/><Button Content="Exportar CSV" Command="{Binding ExportTrialBalanceCommand}" Style="{StaticResource FP.SecondaryButton}"/></StackPanel>
      <UniformGrid Grid.Row="2" Columns="4"><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Débitos do período" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding TrialPeriodDebit, StringFormat=N2}" FontSize="19" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Créditos do período" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding TrialPeriodCredit, StringFormat=N2}" FontSize="19" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Saldo final débito" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding TrialClosingDebit, StringFormat=N2}" FontSize="19" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="Saldo final crédito" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding TrialClosingCredit, StringFormat=N2}" FontSize="19" FontWeight="Bold"/></StackPanel></Border></UniformGrid>
      <DataGrid Grid.Row="4" ItemsSource="{Binding TrialBalanceRows}" Style="{StaticResource FP.DataGrid}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding AccountCode}" Width="Auto"/><DataGridTextColumn Header="Conta" Binding="{Binding AccountName}" Width="*"/><DataGridTextColumn Header="Inicial D" Binding="{Binding OpeningDebit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Inicial C" Binding="{Binding OpeningCredit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Débitos" Binding="{Binding PeriodDebit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Créditos" Binding="{Binding PeriodCredit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Final D" Binding="{Binding ClosingDebit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Final C" Binding="{Binding ClosingCredit, StringFormat=N2}" Width="Auto"/></DataGrid.Columns></DataGrid>
     </Grid>
    </TabItem>
   </TabControl>
  </Border>
  <TextBlock Grid.Row="3" Text="{Binding Message}" Foreground="{DynamicResource FP.Accent}" TextWrapping="Wrap" Margin="0,10,0,0"/>
 </Grid>
</UserControl>
