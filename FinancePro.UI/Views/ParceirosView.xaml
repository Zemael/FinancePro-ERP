<UserControl x:Class="FinancePro.UI.Views.ParceirosView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="{DynamicResource FP.Page}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
  <Grid Margin="24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock Text="Cadastros Mestres  ›  Parceiros de Negócio" Foreground="{DynamicResource FP.TextMuted}" FontSize="11"/><TextBlock Text="Parceiros de Negócio" Style="{StaticResource FP.PageTitle}" Margin="0,8,0,0"/><TextBlock Text="Clientes e fornecedores num único cadastro mestre" Style="{StaticResource FP.PageSubtitle}"/></StackPanel><Button Content="Atualizar" Command="{Binding AtualizarCommand}" Style="{StaticResource FP.SecondaryButton}" HorizontalAlignment="Right"/></Grid>
   <Border Grid.Row="2" Style="{StaticResource FP.Card}" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="180"/><ColumnDefinition Width="14"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Pesquisar" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Pesquisa, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Tipo" Style="{StaticResource FP.FieldLabel}"/><ComboBox ItemsSource="{Binding FiltrosTipo}" SelectedItem="{Binding FiltroTipo}"/></StackPanel><Button Grid.Column="4" Content="Pesquisar" Command="{Binding AtualizarCommand}" Style="{StaticResource FP.PrimaryButton}" VerticalAlignment="Bottom"/></Grid></Border>
   <Border Grid.Row="4" Style="{StaticResource FP.Card}" Padding="0"><DataGrid ItemsSource="{Binding Parceiros}" SelectedItem="{Binding Selecionado}" Style="{StaticResource FP.DataGrid}"><DataGrid.Columns><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="Auto"/><DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="2*"/><DataGridTextColumn Header="NIF" Binding="{Binding NIF}" Width="*"/><DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="*"/><DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*"/><DataGridTemplateColumn Header="Estado" Width="72"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Ativo, Converter={StaticResource AtivoParaTexto}}" Foreground="{Binding Ativo, Converter={StaticResource AtivoParaCor}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Ações" Width="116"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource FP.IconButton}" Margin="0,0,6,0"/><Button Content="&#xE8D8;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.AlternarAtivoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border>
  </Grid>
  <Border Grid.Column="1" Background="{DynamicResource FundoCartaoBrush}" BorderBrush="{DynamicResource FP.Border}" BorderThickness="1,0,0,0"><ScrollViewer><StackPanel Margin="22"><TextBlock Text="Detalhes do Parceiro" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource FP.Text}"/><Border Height="1" Background="{DynamicResource FP.Border}" Margin="0,18"/><TextBlock Text="Tipo" Style="{StaticResource FP.FieldLabel}"/><ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding Tipo}" Margin="0,0,0,12"/><TextBlock Text="Nome" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/><TextBlock Text="NIF" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding NIF}" Margin="0,0,0,12"/><TextBlock Text="Telefone" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Telefone}" Margin="0,0,0,12"/><TextBlock Text="Email" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Email}" Margin="0,0,0,12"/><TextBlock Text="Morada" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Morada}" Height="72" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,14"/><Border Background="{DynamicResource FP.AccentSoft}" CornerRadius="8" Padding="10" Margin="0,0,0,14" Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade}}"><TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Foreground="{DynamicResource FP.Accent}"/></Border><Button Content="Guardar Parceiro" Command="{Binding GuardarCommand}" Style="{StaticResource FP.PrimaryButton}" HorizontalAlignment="Stretch"/><Button Content="Novo" Command="{Binding NovoCommand}" Style="{StaticResource FP.SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/></StackPanel></ScrollViewer></Border>
 </Grid>
</UserControl>
