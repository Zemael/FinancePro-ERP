                       FontSize="10.5" Foreground="#595959" Margin="0,0,0,16" TextWrapping="Wrap"/>

            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Descrição" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Valor (FCFA)" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding ValorTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Fornecedor (opcional)" Style="{StaticResource Rotulo}"/>
                            <ComboBox ItemsSource="{Binding Fornecedores}" SelectedItem="{Binding FornecedorSelecionado}" DisplayMemberPath="Nome"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Rubrica (categoria)" Style="{StaticResource Rotulo}"/>
                            <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSelecionada}" DisplayMemberPath="Nome"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Vencimento" Style="{StaticResource Rotulo}"/>
                            <DatePicker SelectedDate="{Binding DataVencimento}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Forma de pagamento" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding FormaPagamento, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Centro de custo" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding CentroCusto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding MensagemErro}" Foreground="#C00000" FontSize="10.5"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding MensagemErro, Converter={StaticResource TextoParaVisibilidade}}"/>
                    <TextBlock Text="{Binding MensagemSucesso}" Foreground="#0F6E56" FontSize="10.5"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding MensagemSucesso, Converter={StaticResource TextoParaVisibilidade}}"/>

                    <Button Style="{StaticResource BotaoPrimario}" Command="{Binding CriarCommand}"
                            Content="{Binding AGuardar, Converter={StaticResource OcupadoParaTexto}, ConverterParameter=Adicionar}"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,20,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Contas a Pagar" FontSize="13" FontWeight="Bold" Foreground="#0E4C5E" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Pagar a partir de:" Style="{StaticResource Rotulo}"/>
                    <ComboBox ItemsSource="{Binding Origens}" SelectedItem="{Binding OrigemPagamentoSelecionada}" DisplayMemberPath="Nome"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Data do pagamento" Style="{StaticResource Rotulo}"/>
                    <DatePicker SelectedDate="{Binding DataPagamento}"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Cartao}" Padding="0">
                <DataGrid ItemsSource="{Binding Contas}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80"/>
                        <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
                        <DataGridTextColumn Header="Fornecedor" Binding="{Binding FornecedorNome}" Width="110"/>
                        <DataGridTextColumn Header="Vencimento" Binding="{Binding DataVencimento, StringFormat=dd/MM/yyyy}" Width="90"/>
                        <DataGridTextColumn Header="Valor" Binding="{Binding Valor, Converter={StaticResource ValorMoeda}}" Width="110"/>
                        <DataGridTemplateColumn Header="Estado" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EstadoExibicao}" Foreground="{Binding EstadoExibicao, Converter={StaticResource EstadoContaParaCor}}"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Pagar" Style="{StaticResource BotaoLink}" Foreground="#0F6E56"
                                                Visibility="{Binding PodePagar, Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.PagarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Cancelar" Style="{StaticResource BotaoLink}" Foreground="#C00000"
                                                Visibility="{Binding PodeCancelar, Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.CancelarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
