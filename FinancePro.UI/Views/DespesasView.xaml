<UserControl x:Class="FinancePro.UI.Views.DespesasView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource FP.Page}" FontFamily="Segoe UI">
<Grid Background="{StaticResource FP.Page}"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="22,20" MaxWidth="1500" HorizontalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock Text="Despesas" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource FP.Text}"/><TextBlock Text="Contas a pagar, pagamentos e controlo de obrigações com fornecedores." Foreground="{StaticResource FP.TextMuted}" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Border Background="White" BorderBrush="{StaticResource FP.Border}" BorderThickness="1" CornerRadius="9" Height="40" Padding="14,0" Margin="0,0,10,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Accent}" Margin="0,0,8,0"/><StackPanel><TextBlock Text="Última atualização" FontSize="9" Foreground="{StaticResource FP.TextMuted}"/><TextBlock Text="{Binding UltimaAtualizacao}" FontSize="11" FontWeight="SemiBold"/></StackPanel></StackPanel></Border><Button Command="{Binding AtualizarCommand}" Style="{StaticResource FP.SecondaryButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="Atualizar"/></StackPanel></Button></StackPanel></Grid>
<UniformGrid Grid.Row="2" Columns="4"><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="EM ABERTO" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding TotalAberto, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="{Binding QuantidadeAberta, StringFormat={}{0} títulos pendentes}" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="VENCIDO" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding TotalVencido, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.KpiValue}" Foreground="{StaticResource FP.Danger}"/><TextBlock Text="Exige regularização" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="VENCE HOJE" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding TotalHoje, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.KpiValue}" Foreground="{StaticResource FP.Warning}"/><TextBlock Text="Prioridade do dia" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="PAGO" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding TotalPago, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.KpiValue}" Foreground="{StaticResource FP.Success}"/><TextBlock Text="Total liquidado" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border></UniformGrid>
<Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="18,15,18,12"><StackPanel><TextBlock Text="Contas a pagar" Style="{StaticResource FP.SectionTitle}"/><TextBlock Text="Pague ou cancele títulos diretamente na grelha." Style="{StaticResource FP.KpiHint}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ComboBox Width="180" ItemsSource="{Binding Origens}" SelectedItem="{Binding OrigemPagamentoSelecionada}" DisplayMemberPath="Nome"/><DatePicker Width="125" Margin="10,0,0,0" SelectedDate="{Binding DataPagamento}"/></StackPanel></Grid><DataGrid Grid.Row="1" ItemsSource="{Binding Contas}" Style="{StaticResource FP.DataGrid}"><DataGrid.Columns><DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="90"/><DataGridTextColumn Header="DESCRIÇÃO" Binding="{Binding Descricao}" Width="2*"/><DataGridTextColumn Header="FORNECEDOR" Binding="{Binding FornecedorNome}" Width="*"/><DataGridTextColumn Header="VENCIMENTO" Binding="{Binding DataVencimento, StringFormat=dd/MM/yyyy}" Width="105"/><DataGridTextColumn Header="VALOR" Binding="{Binding Valor, Converter={StaticResource ValorMoeda}}" Width="120"/><DataGridTextColumn Header="ESTADO" Binding="{Binding EstadoExibicao}" Width="100"/><DataGridTemplateColumn Header="AÇÕES" Width="135"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Pagar" Command="{Binding DataContext.PagarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.LinkButton}" Foreground="{StaticResource FP.Success}"/><Button Content="Cancelar" Command="{Binding DataContext.CancelarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.LinkButton}" Foreground="{StaticResource FP.Danger}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></Border>
<Border Grid.Column="2" Style="{StaticResource FP.Card}"><StackPanel><TextBlock Text="Nova conta a pagar" Style="{StaticResource FP.SectionTitle}"/><TextBlock Text="Registe a obrigação com o fornecedor." Style="{StaticResource FP.KpiHint}" Margin="0,0,0,14"/><TextBlock Text="Descrição" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Valor (FCFA)" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding ValorTexto}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Vencimento" Style="{StaticResource FP.FieldLabel}"/><DatePicker SelectedDate="{Binding DataVencimento}"/></StackPanel></Grid><TextBlock Text="Fornecedor" Style="{StaticResource FP.FieldLabel}" Margin="0,10,0,0"/><ComboBox ItemsSource="{Binding Fornecedores}" SelectedItem="{Binding FornecedorSelecionado}" DisplayMemberPath="Nome"/><TextBlock Text="Rubrica / Categoria" Style="{StaticResource FP.FieldLabel}" Margin="0,10,0,0"/><ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSelecionada}" DisplayMemberPath="Nome"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Forma de pagamento" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding FormaPagamento}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Centro de custo" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding CentroCusto}"/></StackPanel></Grid><TextBlock Text="{Binding MensagemErro}" Foreground="{StaticResource FP.Danger}" TextWrapping="Wrap" Margin="0,12,0,0"/><Button Content="Guardar conta" Command="{Binding CriarCommand}" Style="{StaticResource FP.PrimaryButton}" Margin="0,16,0,0" HorizontalAlignment="Stretch"/></StackPanel></Border></Grid>
</Grid></ScrollViewer></Grid></UserControl>
