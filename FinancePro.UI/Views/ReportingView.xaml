<UserControl x:Class="FinancePro.UI.Views.ReportingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Central de Relatórios" FontSize="22" FontWeight="SemiBold" Foreground="#0E4C5E"/>
                    <TextBlock Text="Gere, pré-visualize e exporte informação financeira e operacional." Foreground="#667085" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Exportar CSV" Command="{Binding ExportCommand}" Style="{StaticResource BaseButton}" Padding="18,8"/>
            </Grid>

            <Border Style="{StaticResource FP.Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Relatório" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" DisplayMemberPath="Name" Margin="0,6,0,0"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Data inicial" FontWeight="SemiBold"/><DatePicker SelectedDate="{Binding From}" Margin="0,6,0,0"/></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="Data final" FontWeight="SemiBold"/><DatePicker SelectedDate="{Binding To}" Margin="0,6,0,0"/></StackPanel>
                    <Button Grid.Column="6" Content="Gerar relatório" Command="{Binding GenerateCommand}" Style="{StaticResource BaseButton}" Padding="18,8" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>

            <UniformGrid Columns="2" Margin="0,0,0,16">
                <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Relatório" Foreground="#667085"/><TextBlock Text="{Binding ReportTitle}" FontSize="18" FontWeight="SemiBold" Foreground="#0E4C5E" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="Registos" Foreground="#667085"/><TextBlock Text="{Binding RowCount}" FontSize="26" FontWeight="Bold" Foreground="#0E4C5E"/></StackPanel></Border>
            </UniformGrid>

            <Border Style="{StaticResource FP.Card}">
                <StackPanel>
                    <TextBlock Text="Pré-visualização" FontSize="16" FontWeight="SemiBold" Foreground="#0E4C5E" Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="420">
                        <DataGrid.Columns><DataGridTextColumn Header="Dados" Binding="{Binding Summary}" Width="*"/></DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding Message}" Margin="0,12,0,0" Foreground="#0E6B4F" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
