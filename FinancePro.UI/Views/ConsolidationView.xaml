<UserControl x:Class="FinancePro.UI.Views.ConsolidationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Consolidação Contabilística" FontSize="25" FontWeight="SemiBold" Foreground="#16324F"/><TextBlock Text="Reconciliação intercompany, eliminações e demonstrações consolidadas." Foreground="#667085" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="#E8F3F6" CornerRadius="12" Padding="14,8"><TextBlock Text="{Binding CurrentStatus}" FontWeight="SemiBold" Foreground="#0E5A6B"/></Border></Grid>

  <Border Style="{StaticResource FP.Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="GRUPO DE CONSOLIDAÇÃO" FontWeight="SemiBold" Foreground="#415466" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"/><TextBox Grid.Column="2" Text="{Binding FiscalYear, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="4" Content="Guardar grupo" Command="{Binding SaveGroupCommand}" Style="{StaticResource BaseButton}"/></Grid>
   <DataGrid ItemsSource="{Binding Companies}" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" Height="150" Margin="0,10,0,0"><DataGrid.Columns><DataGridCheckBoxColumn Header="Incluir" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/><DataGridTextColumn Header="Empresa" Binding="{Binding Name}" Width="*"/></DataGrid.Columns></DataGrid>
   <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Name" Margin="0,10,0,0"/>
  </StackPanel></Border>

  <Border Style="{StaticResource FP.Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="PROCESSAMENTO" FontWeight="SemiBold" Foreground="#415466" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="8"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DatePicker SelectedDate="{Binding FromDate}"/><DatePicker Grid.Column="2" SelectedDate="{Binding ToDate}"/><Button Grid.Column="4" Content="Novo processamento" Command="{Binding CreateRunCommand}" Style="{StaticResource BaseButton}"/><Button Grid.Column="6" Content="Validar" Command="{Binding ValidateCommand}"/><Button Grid.Column="8" Content="Consolidar" Command="{Binding ConsolidateCommand}"/><Button Grid.Column="10" Content="Fechar" Command="{Binding CloseCommand}"/></Grid><ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" DisplayMemberPath="CreatedAt" Margin="0,10,0,0"/></StackPanel></Border>

  <UniformGrid Columns="5" Margin="0,0,0,14"><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Empresas" Foreground="#667085"/><TextBlock Text="{Binding CompanyCount}" FontSize="20" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Contas" Foreground="#667085"/><TextBlock Text="{Binding AccountCount}" FontSize="20" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Débitos consolidados" Foreground="#667085"/><TextBlock Text="{Binding ConsolidatedDebit, StringFormat=N2}" FontSize="18" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Créditos consolidados" Foreground="#667085"/><TextBlock Text="{Binding ConsolidatedCredit, StringFormat=N2}" FontSize="18" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="Divergências IC" Foreground="#667085"/><TextBlock Text="{Binding DifferenceCount}" FontSize="20" FontWeight="Bold"/></StackPanel></Border></UniformGrid>

  <TabControl>
   <TabItem Header="Balancete consolidado"><DataGrid ItemsSource="{Binding TrialBalanceRows}" SelectedItem="{Binding SelectedTrialRow}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="390"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding AccountCode}" Width="100"/><DataGridTextColumn Header="Conta" Binding="{Binding AccountName}" Width="*"/><DataGridTextColumn Header="Origem D" Binding="{Binding SourceDebit, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Origem C" Binding="{Binding SourceCredit, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Elim. D" Binding="{Binding EliminationDebit, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Elim. C" Binding="{Binding EliminationCredit, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Consolidado D" Binding="{Binding ConsolidatedDebit, StringFormat=N2}" Width="120"/><DataGridTextColumn Header="Consolidado C" Binding="{Binding ConsolidatedCredit, StringFormat=N2}" Width="120"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Intercompany"><StackPanel Margin="10"><DataGrid ItemsSource="{Binding Differences}" SelectedItem="{Binding SelectedDifference}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="280"><DataGrid.Columns><DataGridTextColumn Header="Referência" Binding="{Binding Reference}" Width="180"/><DataGridTextColumn Header="Empresas" Binding="{Binding Companies}" Width="*"/><DataGridTextColumn Header="Qtd." Binding="{Binding CompanyCount}" Width="60"/><DataGridTextColumn Header="Mínimo" Binding="{Binding MinimumAmount, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Máximo" Binding="{Binding MaximumAmount, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Diferença" Binding="{Binding Difference, StringFormat=N2}" Width="110"/></DataGrid.Columns></DataGrid><Button Content="Preparar eliminação com conta selecionada" Command="{Binding PrepareEliminationCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></TabItem>
   <TabItem Header="Eliminações"><StackPanel Margin="10"><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBox Text="{Binding EliminationAccount}" ToolTip="Código da conta"/><TextBox Grid.Column="2" Text="{Binding EliminationDescription}" ToolTip="Descrição"/><TextBox Grid.Column="4" Text="{Binding EliminationDebit}" ToolTip="Débito"/><TextBox Grid.Column="6" Text="{Binding EliminationCredit}" ToolTip="Crédito"/></Grid><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding EliminationReference}" ToolTip="Referência"/><Button Grid.Column="2" Content="Adicionar" Command="{Binding AddEliminationCommand}" Style="{StaticResource BaseButton}"/><Button Grid.Column="4" Content="Remover selecionada" Command="{Binding DeleteEliminationCommand}"/></Grid><DataGrid ItemsSource="{Binding Eliminations}" SelectedItem="{Binding SelectedElimination}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="270"><DataGrid.Columns><DataGridTextColumn Header="Conta" Binding="{Binding AccountCode}" Width="100"/><DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Débito" Binding="{Binding Debit, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Crédito" Binding="{Binding Credit, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Referência" Binding="{Binding Reference}" Width="160"/></DataGrid.Columns></DataGrid></StackPanel></TabItem>
   <TabItem Header="Validação"><DataGrid ItemsSource="{Binding ValidationChecks}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="330"><DataGrid.Columns><DataGridTextColumn Header="Verificação" Binding="{Binding Description}" Width="220"/><DataGridTextColumn Header="Pendências" Binding="{Binding Count}" Width="90"/><DataGridTextColumn Header="Mensagem" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
  </TabControl>
  <TextBlock Text="{Binding Message}" Foreground="#0E6B4F" Margin="0,12,0,0" TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer>
</UserControl>
