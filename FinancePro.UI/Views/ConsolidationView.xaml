<UserControl x:Class="FinancePro.UI.Views.ConsolidationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Consolidação Contabilística" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource FP.Text}"/><TextBlock Text="Reconciliação intercompany, eliminações e demonstrações consolidadas." Foreground="{DynamicResource FP.TextMuted}" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource FP.AccentSoft}" CornerRadius="12" Padding="14,8"><TextBlock Text="{Binding CurrentStatus}" FontWeight="SemiBold" Foreground="{DynamicResource TealBrush}"/></Border></Grid>

  <Border Style="{StaticResource FP.Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="GRUPO DE CONSOLIDAÇÃO" FontWeight="SemiBold" Foreground="{DynamicResource FP.TextMuted}" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"/><TextBox Grid.Column="2" Text="{Binding FiscalYear, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="4" Content="Guardar grupo" Command="{Binding SaveGroupCommand}" Style="{StaticResource BaseButton}"/></Grid>
   <DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding Companies}" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" Height="150" Margin="0,10,0,0"><DataGrid.Columns><DataGridCheckBoxColumn ElementStyle="{StaticResource FP.DataGridCheckBox}" EditingElementStyle="{StaticResource FP.DataGridCheckBox}" Header="Incluir" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/><DataGridTextColumn Header="Empresa" Binding="{Binding Name}" Width="*"/></DataGrid.Columns></DataGrid>
   <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Name" Margin="0,10,0,0"/>
  </StackPanel></Border>

  <Border Style="{StaticResource FP.Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="PROCESSAMENTO" FontWeight="SemiBold" Foreground="{DynamicResource FP.TextMuted}" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="8"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DatePicker SelectedDate="{Binding FromDate}"/><DatePicker Grid.Column="2" SelectedDate="{Binding ToDate}"/><Button Grid.Column="4" Content="Novo processamento" Command="{Binding CreateRunCommand}" Style="{StaticResource BaseButton}"/><Button Grid.Column="6" Content="Validar" Command="{Binding ValidateCommand}"/><Button Grid.Column="8" Content="Consolidar" Command="{Binding ConsolidateCommand}"/><Button Grid.Column="10" Content="Fechar" Command="{Binding CloseCommand}"/></Grid><ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" DisplayMemberPath="CreatedAt" Margin="0,10,0,0"/></StackPanel></Border>

  <UniformGrid Columns="5" Margin="0,0,0,14"><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="{DynamicResource FP.AccentSoft}" CornerRadius="9"><TextBlock Text="&#xE731;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FP.Accent}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Empresas" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding CompanyCount}" FontSize="20" FontWeight="Bold"/></StackPanel></Grid></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="{DynamicResource FP.AccentSoft}" CornerRadius="9"><TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FP.Accent}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Contas" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding AccountCount}" FontSize="20" FontWeight="Bold"/></StackPanel></Grid></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="{DynamicResource SucessoSuaveBrush}" CornerRadius="9"><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SucessoBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Débitos consolidados" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding ConsolidatedDebit, StringFormat=N2}" FontSize="18" FontWeight="Bold"/></StackPanel></Grid></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="{DynamicResource PerigoSuaveBrush}" CornerRadius="9"><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource PerigoBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Créditos consolidados" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding ConsolidatedCredit, StringFormat=N2}" FontSize="18" FontWeight="Bold"/></StackPanel></Grid></Border><Border Style="{StaticResource FP.KpiCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="{DynamicResource AvisoSuaveBrush}" CornerRadius="9"><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AvisoBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Divergências IC" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding DifferenceCount}" FontSize="20" FontWeight="Bold"/></StackPanel></Grid></Border></UniformGrid>

  <TabControl>
   <TabItem Header="Balancete consolidado"><DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding TrialBalanceRows}" SelectedItem="{Binding SelectedTrialRow}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="390"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding AccountCode}" Width="Auto"/><DataGridTextColumn Header="Conta" Binding="{Binding AccountName}" Width="*"/><DataGridTextColumn Header="Origem D" Binding="{Binding SourceDebit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Origem C" Binding="{Binding SourceCredit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Elim. D" Binding="{Binding EliminationDebit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Elim. C" Binding="{Binding EliminationCredit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Consolidado D" Binding="{Binding ConsolidatedDebit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Consolidado C" Binding="{Binding ConsolidatedCredit, StringFormat=N2}" Width="Auto"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Intercompany"><StackPanel Margin="10"><DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding Differences}" SelectedItem="{Binding SelectedDifference}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="280"><DataGrid.Columns><DataGridTextColumn Header="Referência" Binding="{Binding Reference}" Width="Auto"/><DataGridTextColumn Header="Empresas" Binding="{Binding Companies}" Width="*"/><DataGridTextColumn Header="Qtd." Binding="{Binding CompanyCount}" Width="Auto"/><DataGridTextColumn Header="Mínimo" Binding="{Binding MinimumAmount, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Máximo" Binding="{Binding MaximumAmount, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Diferença" Binding="{Binding Difference, StringFormat=N2}" Width="Auto"/></DataGrid.Columns></DataGrid><Button Content="Preparar eliminação com conta selecionada" Command="{Binding PrepareEliminationCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></TabItem>
   <TabItem Header="Eliminações"><StackPanel Margin="10"><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBox Text="{Binding EliminationAccount}" ToolTip="Código da conta"/><TextBox Grid.Column="2" Text="{Binding EliminationDescription}" ToolTip="Descrição"/><TextBox Grid.Column="4" Text="{Binding EliminationDebit}" ToolTip="Débito"/><TextBox Grid.Column="6" Text="{Binding EliminationCredit}" ToolTip="Crédito"/></Grid><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding EliminationReference}" ToolTip="Referência"/><Button Grid.Column="2" Content="Adicionar" Command="{Binding AddEliminationCommand}" Style="{StaticResource BaseButton}"/><Button Grid.Column="4" Content="Remover selecionada" Command="{Binding DeleteEliminationCommand}"/></Grid><DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding Eliminations}" SelectedItem="{Binding SelectedElimination}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="270"><DataGrid.Columns><DataGridTextColumn Header="Conta" Binding="{Binding AccountCode}" Width="Auto"/><DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Débito" Binding="{Binding Debit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Crédito" Binding="{Binding Credit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Referência" Binding="{Binding Reference}" Width="Auto"/></DataGrid.Columns></DataGrid></StackPanel></TabItem>
   <TabItem Header="Validação"><DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding ValidationChecks}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="330"><DataGrid.Columns><DataGridTextColumn Header="Verificação" Binding="{Binding Description}" Width="Auto"/><DataGridTextColumn Header="Pendências" Binding="{Binding Count}" Width="Auto"/><DataGridTextColumn Header="Mensagem" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
  </TabControl>
  <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SucessoBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer>
</UserControl>
