<UserControl x:Class="FinancePro.UI.Views.ConfiguracoesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{StaticResource FP.Page}">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>

  <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid Margin="26,22,22,28" MaxWidth="1420" HorizontalAlignment="Center">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/>
     <RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="Administração  ›  Configurações" Foreground="{StaticResource FP.TextMuted}" FontSize="11"/>
      <TextBlock Text="Configurações do sistema" Foreground="{StaticResource FP.Text}" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/>
      <TextBlock Text="Atualize os dados institucionais e acompanhe os acessos ao FinancePro." Foreground="{StaticResource FP.TextMuted}" FontSize="12" Margin="0,5,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Content="Guardar empresa" Command="{Binding GuardarEmpresaCommand}" Style="{StaticResource FP.PrimaryButton}"/>
     </StackPanel>
    </Grid>

    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Style="{StaticResource FP.KpiCard}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" Background="{StaticResource FP.AccentSoft}" CornerRadius="20"><TextBlock Text="&#xE731;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Accent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Empresa ativa" Foreground="{StaticResource FP.TextMuted}" FontSize="11"/><TextBlock Text="{Binding EmpresaNome, TargetNullValue=—}" Foreground="{StaticResource FP.Text}" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="Configuração institucional" Foreground="{StaticResource FP.TextMuted}" FontSize="10"/></StackPanel>
      </Grid>
     </Border>
     <Border Grid.Column="2" Style="{StaticResource FP.KpiCard}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" Background="{StaticResource FP.SuccessSoft}" CornerRadius="20"><TextBlock Text="&#xE8C1;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Success}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Moeda base" Foreground="{StaticResource FP.TextMuted}" FontSize="11"/><TextBlock Text="{Binding Moeda, TargetNullValue=—}" Foreground="{StaticResource FP.Text}" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Moeda operacional" Foreground="{StaticResource FP.TextMuted}" FontSize="10"/></StackPanel>
      </Grid>
     </Border>
     <Border Grid.Column="4" Style="{StaticResource FP.KpiCard}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" Background="#F1EAFE" CornerRadius="20"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="#7C3AED" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Utilizadores" Foreground="{StaticResource FP.TextMuted}" FontSize="11"/><TextBlock Text="{Binding Utilizadores.Count}" Foreground="{StaticResource FP.Text}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Contas registadas" Foreground="{StaticResource FP.TextMuted}" FontSize="10"/></StackPanel>
      </Grid>
     </Border>
     <Border Grid.Column="6" Style="{StaticResource FP.KpiCard}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" Background="#FFF4E5" CornerRadius="20"><TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Warning}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Perfis" Foreground="{StaticResource FP.TextMuted}" FontSize="11"/><TextBlock Text="{Binding Perfis.Count}" Foreground="{StaticResource FP.Text}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Perfis disponíveis" Foreground="{StaticResource FP.TextMuted}" FontSize="10"/></StackPanel>
      </Grid>
     </Border>
    </Grid>

    <Border Grid.Row="4" Style="{StaticResource FP.Card}">
     <StackPanel>
      <TextBlock Text="Dados da empresa" Foreground="{StaticResource FP.Text}" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="Informações usadas em documentos, relatórios e operações do sistema." Foreground="{StaticResource FP.TextMuted}" FontSize="11" Margin="0,4,0,18"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Grid.Column="0"><TextBlock Text="Nome da empresa" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding EmpresaNome, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FilterTextBox}"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Moeda base" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Moeda, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FilterTextBox}"/></StackPanel>
      </Grid>
      <Grid Margin="0,14,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Grid.Column="0"><TextBlock Text="NIF" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding NIF, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FilterTextBox}"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Telefone" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FilterTextBox}"/></StackPanel>
      </Grid>
      <Grid Margin="0,14,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Grid.Column="0"><TextBlock Text="Email institucional" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding EmailEmpresa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FilterTextBox}"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Morada" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Morada, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FilterTextBox}"/></StackPanel>
      </Grid>
      <TextBlock Text="{Binding MensagemErroEmpresa}" Foreground="{StaticResource FP.Danger}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap" Visibility="{Binding MensagemErroEmpresa, Converter={StaticResource TextoParaVisibilidade}}"/>
     </StackPanel>
    </Border>

    <Border Grid.Row="6" Style="{StaticResource FP.Card}" Padding="0">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Utilizadores do sistema" Foreground="{StaticResource FP.Text}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Contas associadas à empresa atual" Foreground="{StaticResource FP.TextMuted}" FontSize="10"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Utilizadores.Count, StringFormat={}{0} registos}" Foreground="{StaticResource FP.TextMuted}" VerticalAlignment="Center"/></Grid>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Utilizadores}" Style="{StaticResource FP.DataGrid}" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Nome" Binding="{Binding NomeCompleto}" Width="*"/>
        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="210"/>
        <DataGridTextColumn Header="Perfil" Binding="{Binding PerfilNome}" Width="150"/>
        <DataGridTemplateColumn Header="Estado" Width="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Ativo, Converter={StaticResource AtivoParaTexto}}" Foreground="{Binding Ativo, Converter={StaticResource AtivoParaCor}}" FontWeight="SemiBold" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Ação" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Ativo, Converter={StaticResource AtivoParaAcaoTexto}}" Command="{Binding DataContext.AlternarAtivoUtilizadorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.LinkButton}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Border>
   </Grid>
  </ScrollViewer>

  <Border Grid.Column="1" Background="{StaticResource FP.Surface}" BorderBrush="{StaticResource FP.Border}" BorderThickness="1,0,0,0" Padding="22">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <Border Width="44" Height="44" Background="{StaticResource FP.AccentSoft}" CornerRadius="22" HorizontalAlignment="Left"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Accent}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="Novo utilizador" Foreground="{StaticResource FP.Text}" FontSize="19" FontWeight="SemiBold" Margin="0,14,0,0"/>
     <TextBlock Text="Crie uma conta e defina o perfil de acesso inicial." Foreground="{StaticResource FP.TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,20"/>
     <TextBlock Text="Nome completo" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding NovoNome, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FilterTextBox}" Margin="0,0,0,14"/>
     <TextBlock Text="Email" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding NovoEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FilterTextBox}" Margin="0,0,0,14"/>
     <TextBlock Text="Senha provisória" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding NovaPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FilterTextBox}" Margin="0,0,0,14"/>
     <TextBlock Text="Perfil" Style="{StaticResource FP.FieldLabel}"/><ComboBox ItemsSource="{Binding Perfis}" SelectedItem="{Binding PerfilSelecionado}" DisplayMemberPath="Nome" Style="{StaticResource FP.FilterComboBox}" Margin="0,0,0,18"/>
     <TextBlock Text="{Binding MensagemErroUtilizador}" Foreground="{StaticResource FP.Danger}" TextWrapping="Wrap" Margin="0,0,0,14" Visibility="{Binding MensagemErroUtilizador, Converter={StaticResource TextoParaVisibilidade}}"/>
     <Button Content="Adicionar utilizador" Command="{Binding CriarUtilizadorCommand}" Style="{StaticResource FP.PrimaryButton}" Margin="0,0,0,10"/>
     <Border Background="{StaticResource FP.AccentSoft}" CornerRadius="8" Padding="12" Margin="0,10,0,0"><TextBlock Text="A senha provisória deve ser alterada pelo utilizador no primeiro acesso, quando essa política estiver ativa." Foreground="{StaticResource FP.Accent}" FontSize="10.5" TextWrapping="Wrap"/></Border>
    </StackPanel>
   </ScrollViewer>
  </Border>
 </Grid>
</UserControl>
