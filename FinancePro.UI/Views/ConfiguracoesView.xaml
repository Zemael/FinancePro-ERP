<UserControl x:Class="FinancePro.UI.Views.ConfiguracoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <TextBlock Text="Configurações" Style="{StaticResource TituloModulo}" Margin="0,0,0,4"/>
            <TextBlock Text="Dados da empresa e utilizadores com acesso ao sistema"
                       Style="{StaticResource TextoSecundario}" Margin="0,0,0,16"/>

            <TextBlock Text="Empresa" Style="{StaticResource FP.SectionTitle}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nome da empresa" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding EmpresaNome, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Moeda" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding Moeda, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="NIF" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding NIF, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Telefone" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Morada" Style="{StaticResource Rotulo}" Margin="0,14,0,4"/>
                    <TextBox Text="{Binding Morada, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Email" Style="{StaticResource Rotulo}" Margin="0,14,0,4"/>
                    <TextBox Text="{Binding EmailEmpresa, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{Binding MensagemErroEmpresa}" Foreground="{DynamicResource PerigoBrush}" FontSize="12"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding MensagemErroEmpresa, Converter={StaticResource TextoParaVisibilidade}}"/>

                    <Button Style="{StaticResource BotaoPrimario}" Command="{Binding GuardarEmpresaCommand}"
                            Content="{Binding AGuardarEmpresa, Converter={StaticResource OcupadoParaTexto}, ConverterParameter=Guardar}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Parâmetros do sistema" Style="{StaticResource FP.SectionTitle}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tema" Style="{StaticResource Rotulo}"/>
                            <ComboBox IsEditable="True" Text="{Binding Tema, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="Light"/>
                                <ComboBoxItem Content="Dark"/>
                                <ComboBoxItem Content="FinancePro Blue"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Limite para aprovação de pagamentos" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding LimiteAprovacaoPagamento, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="Permitir caixa com saldo negativo" IsChecked="{Binding PermitirCaixaNegativo}" Margin="0,14,0,0"/>
                    <TextBlock Text="{Binding MensagemParametros}" Foreground="{DynamicResource SucessoBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <Button Style="{StaticResource BotaoPrimario}" Command="{Binding GuardarParametrosCommand}" Content="Guardar parâmetros"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Saúde do sistema e cópia de segurança" Style="{StaticResource FP.SectionTitle}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource NeutroSuaveBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Base de dados" Style="{StaticResource Rotulo}"/>
                                <TextBlock Text="{Binding DatabaseNome}" FontWeight="SemiBold" Foreground="{DynamicResource TextoPrincipalBrush}"/>
                                <TextBlock Text="{Binding DatabaseServidor}" FontSize="11" Foreground="{DynamicResource GrayTextBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource NeutroSuaveBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Tamanho da base" Style="{StaticResource Rotulo}"/>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TealDarkBrush}">
                                    <Run Text="{Binding DatabaseTamanhoMb, StringFormat={}{0:N2}}"/><Run Text=" MB"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="{DynamicResource NeutroSuaveBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Último backup" Style="{StaticResource Rotulo}"/>
                                <TextBlock Text="{Binding UltimoBackup}" FontWeight="SemiBold" Foreground="{DynamicResource TextoPrincipalBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding ResumoSistema}" Foreground="{DynamicResource GrayTextBrush}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding MensagemBackup}" Foreground="{DynamicResource SucessoBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource BotaoPrimario}" Command="{Binding CriarBackupCommand}" Content="Criar backup agora" Margin="0"/>
                        <Button Style="{StaticResource BotaoSecundario}" Command="{Binding AtualizarSaudeCommand}" Content="Atualizar estado" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Histórico de backups" Style="{StaticResource FP.SectionTitle}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <TextBlock Text="Últimas cópias de segurança registadas pelo SQL Server" FontWeight="SemiBold" Foreground="{DynamicResource TextoPrincipalBrush}"/>
                    <TextBlock Text="Apresenta backups completos, diferenciais e de log, incluindo data, tamanho, duração e destino." Foreground="{DynamicResource GrayTextBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding HistoricoBackups}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,14,0,0" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Início" Binding="{Binding StartedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="Auto"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding BackupType}" Width="Auto"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="Auto"/>
                            <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeMb, StringFormat={}{0:N2} MB}" Width="Auto"/>
                            <DataGridTextColumn Header="Duração" Binding="{Binding DurationSeconds, StringFormat={}{0} s}" Width="Auto"/>
                            <DataGridTextColumn Header="Destino" Binding="{Binding Destination}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding MensagemHistoricoBackups}" Foreground="{DynamicResource GrayTextBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Backups recentes a preservar" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding BackupsAPreservar, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <CheckBox Content="Confirmo a eliminação dos backups antigos criados pelo FinancePro" IsChecked="{Binding ConfirmarLimpezaBackups}"/>
                            <TextBlock Text="A limpeza atua apenas em ficheiros FinancePro_*.bak na pasta padrão do SQL Server." Foreground="{DynamicResource GrayTextBrush}" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource BotaoSecundario}" Command="{Binding AtualizarHistoricoBackupsCommand}" Content="Atualizar histórico" Margin="0"/>
                        <Button Style="{StaticResource BotaoPrimario}" Command="{Binding VerificarUltimoBackupCommand}" Content="Verificar último" Margin="10,0,0,0" Background="{DynamicResource SucessoBrush}" BorderBrush="{DynamicResource SucessoBrush}"/>
                        <Button Style="{StaticResource BotaoPrimario}" Command="{Binding LimparBackupsAntigosCommand}" Content="Limpar antigos" Margin="10,0,0,0" Background="{DynamicResource PerigoBrush}" BorderBrush="{DynamicResource PerigoBrush}"/>
                    </StackPanel>
                    <Border Background="{DynamicResource NeutroSuaveBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Verificação de integridade" Style="{StaticResource Rotulo}"/>
                            <TextBlock Text="{Binding EstadoVerificacaoBackup}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TealDarkBrush}"/>
                            <TextBlock Text="{Binding DetalheVerificacaoBackup}" Foreground="{DynamicResource GrayTextBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Política de continuidade" Style="{StaticResource FP.SectionTitle}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Frequência do backup (horas)" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding FrequenciaBackupHoras, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Retenção (ficheiros)" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding BackupsAPreservar, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="RPO objetivo (horas)" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding RpoObjetivoHoras, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="RTO objetivo (horas)" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding RtoObjetivoHoras, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <Border Background="{DynamicResource NeutroSuaveBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Conformidade atual" Style="{StaticResource Rotulo}"/>
                            <TextBlock Text="{Binding EstadoPoliticaContinuidade}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TealDarkBrush}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding MensagemPoliticaContinuidade}" Foreground="{DynamicResource SucessoBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <Button Style="{StaticResource BotaoPrimario}" Command="{Binding GuardarPoliticaContinuidadeCommand}" Content="Guardar política" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Teste integrado de continuidade" Style="{StaticResource FP.SectionTitle}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource NeutroSuaveBrush}" CornerRadius="8" Padding="14" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Resultado geral" Style="{StaticResource Rotulo}"/>
                                <TextBlock Text="{Binding EstadoTesteContinuidade}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TealDarkBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Simulação técnica sem restauração" FontWeight="SemiBold" Foreground="{DynamicResource TextoPrincipalBrush}"/>
                            <TextBlock Text="Valida disponibilidade, RPO, integridade da base, legibilidade do backup e política RTO numa única execução." Foreground="{DynamicResource GrayTextBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ResumoTesteContinuidade}" Foreground="{DynamicResource GrayTextBrush}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding TestesContinuidade}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,14,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Teste" Binding="{Binding Test}" Width="Auto"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="Auto"/>
                            <DataGridTextColumn Header="Detalhe" Binding="{Binding Detail}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Style="{StaticResource BotaoPrimario}" Command="{Binding ExecutarTesteContinuidadeCommand}" Content="Executar teste" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Plano de recuperação e continuidade" Style="{StaticResource FP.SectionTitle}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <TextBlock Text="Documento operacional de recuperação" FontWeight="SemiBold" Foreground="{DynamicResource TextoPrincipalBrush}"/>
                    <TextBlock Text="Valida o último backup completo e gera um ficheiro TXT com o ponto de recuperação disponível, estado técnico e procedimento controlado. Nenhuma restauração é executada." Foreground="{DynamicResource GrayTextBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding MensagemPlanoRecuperacao}" Foreground="{DynamicResource SucessoBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <Button Style="{StaticResource BotaoPrimario}" Command="{Binding GerarPlanoRecuperacaoCommand}" Content="Gerar plano" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Diagnóstico técnico" Style="{StaticResource FP.SectionTitle}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource NeutroSuaveBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="SQL Server" Style="{StaticResource Rotulo}"/>
                                <TextBlock Text="{Binding SqlServerVersao}" FontWeight="SemiBold" Foreground="{DynamicResource TextoPrincipalBrush}"/>
                                <TextBlock Text="{Binding DatabaseEstado, StringFormat=Estado: {0}}" FontSize="11" Foreground="{DynamicResource GrayTextBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource NeutroSuaveBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Recuperação / Compatibilidade" Style="{StaticResource Rotulo}"/>
                                <TextBlock Text="{Binding RecoveryModel}" FontWeight="SemiBold" Foreground="{DynamicResource TextoPrincipalBrush}"/>
                                <TextBlock Text="{Binding CompatibilityLevel, StringFormat=Compatibilidade SQL: {0}}" FontSize="11" Foreground="{DynamicResource GrayTextBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="{DynamicResource NeutroSuaveBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Integridade física" Style="{StaticResource Rotulo}"/>
                                <TextBlock Text="{Binding IntegridadeBase}" FontWeight="SemiBold" Foreground="{DynamicResource TextoPrincipalBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding MensagemDiagnostico}" Foreground="{DynamicResource GrayTextBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <Button Style="{StaticResource BotaoPrimario}" Command="{Binding ExecutarDiagnosticoCommand}" Content="Executar diagnóstico" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Prontidão operacional" Style="{StaticResource FP.SectionTitle}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource NeutroSuaveBrush}" CornerRadius="8" Padding="14" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Estado geral" Style="{StaticResource Rotulo}"/>
                                <TextBlock Text="{Binding EstadoProntidao}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TealDarkBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Verificação de produção" FontWeight="SemiBold" Foreground="{DynamicResource TextoPrincipalBrush}"/>
                            <TextBlock Text="Confirma ligação, backup recente, integridade física, utilizadores, empresa e compatibilidade da base antes de colocar o sistema em operação." Foreground="{DynamicResource GrayTextBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ResumoProntidao}" Foreground="{DynamicResource GrayTextBrush}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding VerificacoesProntidao}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,14,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Área" Binding="{Binding Area}" Width="Auto"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="Auto"/>
                            <DataGridTextColumn Header="Detalhe" Binding="{Binding Detail}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Style="{StaticResource BotaoPrimario}" Command="{Binding VerificarProntidaoCommand}" Content="Verificar prontidão" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Suporte técnico" Style="{StaticResource FP.SectionTitle}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <TextBlock Text="Pacote de diagnóstico" FontWeight="SemiBold" Foreground="{DynamicResource TextoPrincipalBrush}"/>
                    <TextBlock Text="Gera um relatório técnico em ficheiro TXT com estado da base, versão do SQL Server, integridade, último backup e resumo operacional. O ficheiro não inclui palavras-passe." Foreground="{DynamicResource GrayTextBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding MensagemSuporte}" Foreground="{DynamicResource SucessoBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <Button Style="{StaticResource BotaoPrimario}" Command="{Binding GerarRelatorioSuporteCommand}" Content="Gerar relatório técnico" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Utilizadores" Style="{StaticResource FP.SectionTitle}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nome completo" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding NovoNome, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding NovoEmail, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Senha provisória" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding NovaPassword, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Perfil" Style="{StaticResource Rotulo}"/>
                            <ComboBox ItemsSource="{Binding Perfis}" SelectedItem="{Binding PerfilSelecionado}" DisplayMemberPath="Nome"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding MensagemErroUtilizador}" Foreground="{DynamicResource PerigoBrush}" FontSize="12"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding MensagemErroUtilizador, Converter={StaticResource TextoParaVisibilidade}}"/>

                    <Button Style="{StaticResource BotaoPrimario}" Command="{Binding CriarUtilizadorCommand}"
                            Content="{Binding AGuardarUtilizador, Converter={StaticResource OcupadoParaTexto}, ConverterParameter=Adicionar}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Cartao}" Padding="0" Margin="0,10,0,0">
                <DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding Utilizadores}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding NomeCompleto}" Width="*"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="Auto"/>
                        <DataGridTextColumn Header="Perfil" Binding="{Binding PerfilNome}" Width="Auto"/>
                        <DataGridTemplateColumn Header="Estado" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Ativo, Converter={StaticResource AtivoParaTexto}}"
                                               Foreground="{Binding Ativo, Converter={StaticResource AtivoParaCor}}"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Ativo, Converter={StaticResource AtivoParaAcaoTexto}}"
                                            Command="{Binding DataContext.AlternarAtivoUtilizadorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource BotaoLink}" Foreground="{DynamicResource TealBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
