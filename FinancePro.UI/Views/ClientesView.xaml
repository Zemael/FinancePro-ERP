<UserControl x:Class="FinancePro.UI.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource FP.Page}"
             FontFamily="Segoe UI">
    <Grid Background="{StaticResource FP.Page}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="22,20" MaxWidth="1500" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho no padrão do Dashboard -->
                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="Clientes" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource FP.Text}"/>
                        <TextBlock Text="Gestão de clientes, contactos e integração com receitas e contas a receber."
                                   Foreground="{StaticResource FP.TextMuted}" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Border Background="White" BorderBrush="{StaticResource FP.Border}" BorderThickness="1"
                                CornerRadius="9" Height="40" Padding="14,0" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Accent}" Margin="0,0,8,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Última atualização" Foreground="{StaticResource FP.TextMuted}" FontSize="9"/>
                                    <TextBlock Text="{Binding UltimaAtualizacao}" Foreground="{StaticResource FP.Text}" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding AtualizarCommand}" Style="{StaticResource FP.SecondaryButton}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="Atualizar"/></StackPanel>
                        </Button>
                        <Button Command="{Binding NovoCommand}" Style="{StaticResource FP.PrimaryButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="+" FontSize="18" Margin="0,-2,8,0"/><TextBlock Text="Novo cliente"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Indicadores -->
                <UniformGrid Grid.Row="2" Columns="4">
                    <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="#EAF2FF" CornerRadius="9"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Accent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1"><TextBlock Text="TOTAL DE CLIENTES" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding TotalClientes}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Registos encontrados" Style="{StaticResource FP.KpiHint}"/></StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="{StaticResource FP.SuccessSoft}" CornerRadius="9"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Success}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1"><TextBlock Text="ATIVOS" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding ClientesAtivos}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Disponíveis para operações" Style="{StaticResource FP.KpiHint}"/></StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="{StaticResource FP.DangerSoft}" CornerRadius="9"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Danger}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1"><TextBlock Text="INATIVOS" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding ClientesInativos}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Registos suspensos" Style="{StaticResource FP.KpiHint}"/></StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource FP.KpiCard}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="#F4ECFF" CornerRadius="9"><TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" Foreground="#7C3AED" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1"><TextBlock Text="COM EMAIL" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding ClientesComEmail}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Contactos digitais válidos" Style="{StaticResource FP.KpiHint}"/></StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- Pesquisa -->
                <Border Grid.Row="4" Style="{StaticResource FP.Card}" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox Text="{Binding Pesquisa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FilterTextBox}" Padding="38,8,12,8" ToolTip="Pesquise por nome, NIF ou email"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.TextMuted}" FontSize="14" Margin="13,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <Button Grid.Column="2" Content="Pesquisar" Command="{Binding AtualizarCommand}" Style="{StaticResource FP.PrimaryButton}"/>
                    </Grid>
                </Border>

                <!-- Lista + formulário -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource FP.Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="18,15,18,12">
                                <StackPanel><TextBlock Text="Lista de clientes" Style="{StaticResource FP.SectionTitle}"/><TextBlock Text="Selecione um registo para editar ou alterar o estado." Style="{StaticResource FP.KpiHint}"/></StackPanel>
                                <TextBlock Text="{Binding Ocupado, Converter={StaticResource OcupadoParaTexto}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource FP.Accent}" FontSize="11"/>
                            </Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Itens}" SelectedItem="{Binding Selecionado}" Style="{StaticResource FP.DataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NOME" Binding="{Binding Nome}" Width="2*"/>
                                    <DataGridTextColumn Header="NIF" Binding="{Binding NIF}" Width="*"/>
                                    <DataGridTextColumn Header="TELEFONE" Binding="{Binding Telefone}" Width="*"/>
                                    <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="1.5*"/>
                                    <DataGridTemplateColumn Header="ESTADO" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding Ativo, Converter={StaticResource AtivoParaCor}}" CornerRadius="10" Padding="9,4" HorizontalAlignment="Left"><TextBlock Text="{Binding Ativo, Converter={StaticResource AtivoParaTexto}}" Foreground="White" FontSize="10" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="AÇÕES" Width="98"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="&#xE70F;" Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}" ToolTip="Editar"/><Button Content="&#xE8D8;" Command="{Binding DataContext.AlternarAtivoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}" Margin="6,0,0,0" ToolTip="Ativar/Inativar"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource FP.Card}" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="Dados do cliente" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource FP.Text}"/><TextBlock Text="Informações gerais e contactos" Style="{StaticResource FP.KpiHint}" Margin="0,4,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource FP.AccentSoft}" CornerRadius="8" Padding="9,4"><TextBlock Text="CADASTRO" Foreground="{StaticResource FP.Accent}" FontSize="9" FontWeight="Bold"/></Border></Grid>
                                <TextBlock Text="Nome completo / Designação" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FormTextBox}" Margin="0,0,0,12"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="NIF" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding NIF}" Style="{StaticResource FP.FormTextBox}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Telefone" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Telefone}" Style="{StaticResource FP.FormTextBox}"/></StackPanel></Grid>
                                <TextBlock Text="Email" Style="{StaticResource FP.FieldLabel}" Margin="0,12,0,5"/><TextBox Text="{Binding Email}" Style="{StaticResource FP.FormTextBox}"/>
                                <TextBlock Text="Morada" Style="{StaticResource FP.FieldLabel}" Margin="0,12,0,5"/><TextBox Text="{Binding Morada}" Style="{StaticResource FP.FormTextBox}" Height="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource FP.Border}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,14,0,14" Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade}}"><TextBlock Text="{Binding Mensagem}" Foreground="{StaticResource FP.Text}" TextWrapping="Wrap" FontSize="11"/></Border>
                                <Button Command="{Binding GuardarCommand}" Style="{StaticResource FP.PrimaryButton}" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="Guardar cliente"/></StackPanel></Button>
                                <Button Content="Carregar selecionado" Command="{Binding EditarCommand}" Style="{StaticResource FP.SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
