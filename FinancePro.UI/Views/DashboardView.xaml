<UserControl x:Class="FinancePro.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource FundoPrincipalBrush}"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FP.Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FP.TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="QuickAction" TargetType="Button">
            <Setter Property="MinWidth" Value="122"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="{DynamicResource FundoCartaoBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BordaBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource FP.Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource FP.AccentSoft}"/><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource FP.Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource FundoPrincipalBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Center">
            <Grid Margin="24,20,24,20"
                  MaxWidth="1500"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Greeting -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource FP.Text}"><Run Text="Bem-vindo, "/><Run Text="{Binding NomeUtilizador}"/><Run Text="!"/></TextBlock>
                    <TextBlock Foreground="{DynamicResource GrayTextBrush}" FontSize="12" Margin="0,5,0,0">
                        <Run Text="Visão geral da situação financeira de "/><Run Text="{Binding EmpresaNome}" FontWeight="SemiBold"/><Run Text="."/>
                    </TextBlock>
                </StackPanel>
                <Grid HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Height="40"
                            Padding="18,0"
                            VerticalAlignment="Top"
                            Background="{DynamicResource FP.Accent}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding RecarregarCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                            <TextBlock Text="Atualizar" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="1"
                            Width="1"
                            Height="40"
                            Background="{DynamicResource BordaBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"/>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="&#xE787;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource FP.Accent}"
                                       FontSize="18"
                                       Margin="0,2,9,0"/>
                            <TextBlock Text="{Binding UltimaAtualizacao}"
                                       Foreground="{DynamicResource FP.Text}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Top"/>
                        </StackPanel>
                        <TextBlock Text="Última atualização"
                                   Style="{StaticResource Muted}"
                                   Margin="27,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- KPI cards -->
            <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,14">
                <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource FP.AccentSoft}"><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FP.Accent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Saldo em Caixa" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding SaldoCaixa, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.CompanyKpiValue}" TextWrapping="NoWrap"/></Viewbox><TextBlock Grid.Row="2" VerticalAlignment="Bottom" Text="{Binding VariacaoReceitasPercentual, StringFormat=Variação: {0:N1}%}" Style="{StaticResource FP.CompanyKpiCaption}" Margin="0,5,0,0"/></Grid></Grid></Border>
                <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource FP.AccentSoft}"><TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FP.Accent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Saldo Bancário" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding SaldoBancario, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.CompanyKpiValue}" TextWrapping="NoWrap"/></Viewbox><TextBlock Grid.Row="2" VerticalAlignment="Bottom" Text="{Binding VariacaoDespesasPercentual, StringFormat=Variação: {0:N1}%}" Style="{StaticResource FP.CompanyKpiCaption}" Margin="0,5,0,0"/></Grid></Grid></Border>
                <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource SucessoSuaveBrush}"><TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SucessoBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Receitas (Mês)" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding TotalReceitas, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.CompanyKpiValue}" TextWrapping="NoWrap"/></Viewbox><TextBlock Grid.Row="2" VerticalAlignment="Bottom" Text="0% em relação ao mês anterior" Style="{StaticResource FP.CompanyKpiCaption}" Margin="0,5,0,0"/></Grid></Grid></Border>
                <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource PerigoSuaveBrush}"><TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource PerigoBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Despesas (Mês)" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding TotalDespesas, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.CompanyKpiValue}" TextWrapping="NoWrap"/></Viewbox><TextBlock Grid.Row="2" VerticalAlignment="Bottom" Text="0% em relação ao mês anterior" Style="{StaticResource FP.CompanyKpiCaption}" Margin="0,5,0,0"/></Grid></Grid></Border>
                <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource FP.AccentSoft}"><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FP.Accent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Resultado (Mês)" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding Resultado, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.CompanyKpiValue}" TextWrapping="NoWrap"/></Viewbox><TextBlock Grid.Row="2" VerticalAlignment="Bottom" Text="0% em relação ao mês anterior" Style="{StaticResource FP.CompanyKpiCaption}" Margin="0,5,0,0"/></Grid></Grid></Border>
                <Border Style="{StaticResource FP.KpiCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource RoxoSuaveBrush}"><TextBlock Text="%" Foreground="{DynamicResource RoxoBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Total Disponível" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding TotalDisponivel, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.CompanyKpiValue}" TextWrapping="NoWrap"/></Viewbox><TextBlock Grid.Row="2" VerticalAlignment="Bottom" Text="Caixa + contas bancárias" Style="{StaticResource FP.CompanyKpiCaption}" Margin="0,5,0,0"/></Grid></Grid></Border>
            </UniformGrid>

            <!-- Executive KPIs: real data, loaded with the dashboard summary -->
            <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,14">
                <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource RoxoSuaveBrush}"><TextBlock Text="%" Foreground="{DynamicResource RoxoBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Execução Orçamental" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding ExecucaoOrcamentalPercentual, StringFormat={}{0:N1}%}" Style="{StaticResource FP.CompanyKpiValue}" TextWrapping="NoWrap"/></Viewbox><TextBlock Grid.Row="2" VerticalAlignment="Bottom" Text="Despesas realizadas / previstas" Style="{StaticResource FP.CompanyKpiCaption}" Margin="0,5,0,0"/></Grid>
                    </Grid>
                </Border>
                <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource SucessoSuaveBrush}"><TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SucessoBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Património Ativo" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding ValorPatrimonio, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.CompanyKpiValue}" TextWrapping="NoWrap"/></Viewbox><TextBlock Grid.Row="2" VerticalAlignment="Bottom" FontSize="10" Foreground="{DynamicResource GrayTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"><Run Text="Bens ativos: "/><Run Text="{Binding BensAtivos}"/><Run Text=" · Manutenção: "/><Run Text="{Binding BensEmManutencao}"/></TextBlock></Grid>
                    </Grid>
                </Border>
                <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource AvisoSuaveBrush}"><TextBlock Text="&#xE73A;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AvisoBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Workflow Pendente" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding WorkflowPendentes}" Style="{StaticResource FP.CompanyKpiValue}" TextWrapping="NoWrap"/></Viewbox><TextBlock Grid.Row="2" VerticalAlignment="Bottom" FontSize="10" Foreground="{DynamicResource GrayTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"><Run Text="Atrasados: "/><Run Text="{Binding WorkflowAtrasados}"/><Run Text=" · Urgentes: "/><Run Text="{Binding WorkflowUrgentes}"/></TextBlock></Grid>
                    </Grid>
                </Border>
                <Border Style="{StaticResource FP.KpiCard}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource FP.AccentSoft}"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FP.Accent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Conformidade Fiscal" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding TaxaConformidadeFiscal, StringFormat={}{0:N1}%}" Style="{StaticResource FP.CompanyKpiValue}" TextWrapping="NoWrap"/></Viewbox><TextBlock Grid.Row="2" VerticalAlignment="Bottom" FontSize="10" Foreground="{DynamicResource GrayTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"><Run Text="Atrasadas: "/><Run Text="{Binding ObrigacoesFiscaisAtrasadas}"/><Run Text=" · Próx. 7 dias: "/><Run Text="{Binding ObrigacoesFiscaisProximas}"/></TextBlock></Grid>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- BI executivo -->
            <UniformGrid Grid.Row="3" Columns="5" Margin="0,0,0,14">
                <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Contas a Receber" Style="{StaticResource KpiLabel}"/><Viewbox StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding ContasReceberPendente, Converter={StaticResource ValorMoeda}}" Style="{StaticResource KpiValue}" TextWrapping="NoWrap"/></Viewbox><TextBlock Text="Saldo pendente faturado" Style="{StaticResource FP.CompanyKpiCaption}"/></StackPanel></Border>
                <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Contas a Pagar" Style="{StaticResource KpiLabel}"/><Viewbox StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding ContasPagarPendente, Converter={StaticResource ValorMoeda}}" Style="{StaticResource KpiValue}" TextWrapping="NoWrap"/></Viewbox><TextBlock Text="Obrigações pendentes" Style="{StaticResource FP.CompanyKpiCaption}"/></StackPanel></Border>
                <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Liquidez Imediata" Style="{StaticResource KpiLabel}"/><Viewbox StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding LiquidezImediataPercentual, StringFormat={}{0:N1}%}" Style="{StaticResource KpiValue}" TextWrapping="NoWrap"/></Viewbox><TextBlock Text="Disponível / contas a pagar" Style="{StaticResource FP.CompanyKpiCaption}"/></StackPanel></Border>
                <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Projetos Ativos" Style="{StaticResource KpiLabel}"/><Viewbox StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding ProjetosAtivos}" Style="{StaticResource KpiValue}" TextWrapping="NoWrap"/></Viewbox><TextBlock Text="{Binding ProjetosCriticos, StringFormat=Críticos: {0}}" Style="{StaticResource FP.CompanyKpiCaption}"/></StackPanel></Border>
                <Border Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="Resultado dos Projetos" Style="{StaticResource KpiLabel}"/><Viewbox StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding ResultadoProjetos, Converter={StaticResource ValorMoeda}}" Style="{StaticResource KpiValue}" TextWrapping="NoWrap"/></Viewbox><TextBlock Text="Receita prevista - custo previsto" Style="{StaticResource FP.CompanyKpiCaption}"/></StackPanel></Border>
            </UniformGrid>

            <!-- Quick actions -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Ações rápidas" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Style="{StaticResource QuickAction}" Command="{Binding NovoMovimentoCommand}"><StackPanel><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FP.Accent}" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="Novo movimento" FontSize="11" Margin="0,6,0,0"/></StackPanel></Button>
                        <Button Style="{StaticResource QuickAction}" Command="{Binding NovaContaReceberCommand}"><StackPanel><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SucessoBrush}" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="Conta a receber" FontSize="11" Margin="0,6,0,0"/></StackPanel></Button>
                        <Button Style="{StaticResource QuickAction}" Command="{Binding NovaDespesaCommand}"><StackPanel><TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource PerigoBrush}" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="Nova despesa" FontSize="11" Margin="0,6,0,0"/></StackPanel></Button>
                        <Button Style="{StaticResource QuickAction}" Command="{Binding NovoOrcamentoCommand}"><StackPanel><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource RoxoBrush}" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="Novo orçamento" FontSize="11" Margin="0,6,0,0"/></StackPanel></Button>
                        <Button Style="{StaticResource QuickAction}" Command="{Binding NovaCaixaCommand}"><StackPanel><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FP.Accent}" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="Nova caixa" FontSize="11" Margin="0,6,0,0"/></StackPanel></Button>
                        <Button Style="{StaticResource QuickAction}" Command="{Binding NovaTransferenciaCommand}"><StackPanel><TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TealBrush}" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="Transferência" FontSize="11" Margin="0,6,0,0"/></StackPanel></Button>
                        <Button Style="{StaticResource QuickAction}" Command="{Binding NovoUtilizadorCommand}"><StackPanel><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AvisoBrush}" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="Novo utilizador" FontSize="11" Margin="0,6,0,0"/></StackPanel></Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Main panels -->
            <Grid Grid.Row="5" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.72*"/></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Fluxo de caixa" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Border Width="9" Height="9" Background="{DynamicResource FP.Accent}" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Saldo previsto" Style="{StaticResource Muted}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Border Width="9" Height="9" Background="{DynamicResource SucessoBrush}" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Entradas" Style="{StaticResource Muted}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="9" Height="9" Background="{DynamicResource PerigoBrush}" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Saídas" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Grid Height="210">
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="26"/></Grid.RowDefinitions>
                            <Viewbox Stretch="Fill" Margin="22,14,18,4">
                                <Canvas Width="520" Height="160">
                                    <Line X1="0" Y1="30" X2="520" Y2="30" Stroke="{DynamicResource BordaBrush}"/><Line X1="0" Y1="70" X2="520" Y2="70" Stroke="{DynamicResource BordaBrush}"/><Line X1="0" Y1="110" X2="520" Y2="110" Stroke="{DynamicResource BordaBrush}"/><Line X1="0" Y1="150" X2="520" Y2="150" Stroke="{DynamicResource BordaBrush}"/>
                                    <Polyline Points="0,120 100,105 200,110 300,88 400,95 520,70" Stroke="{DynamicResource FP.Accent}" StrokeThickness="2.5" StrokeLineJoin="Round"/>
                                    <Polyline Points="0,140 100,118 200,128 300,95 400,100 520,80" Stroke="{DynamicResource SucessoBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
                                    <Polyline Points="0,100 100,112 200,102 300,120 400,108 520,130" Stroke="{DynamicResource PerigoBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <UniformGrid Grid.Row="1" Columns="6" Margin="22,0,18,0"><TextBlock Text="Mar/26" Style="{StaticResource FP.CompanyKpiCaption}" HorizontalAlignment="Center"/><TextBlock Text="Abr/26" Style="{StaticResource FP.CompanyKpiCaption}" HorizontalAlignment="Center"/><TextBlock Text="Mai/26" Style="{StaticResource FP.CompanyKpiCaption}" HorizontalAlignment="Center"/><TextBlock Text="Jun/26" Style="{StaticResource FP.CompanyKpiCaption}" HorizontalAlignment="Center"/><TextBlock Text="Jul/26" Style="{StaticResource FP.CompanyKpiCaption}" HorizontalAlignment="Center"/><TextBlock Text="Ago/26" Style="{StaticResource FP.CompanyKpiCaption}" HorizontalAlignment="Center"/></UniformGrid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Conformidade fiscal" Style="{StaticResource SectionTitle}"/>
                        <Grid Height="150">
                            <Ellipse Width="116" Height="116" Stroke="{DynamicResource BordaBrush}" StrokeThickness="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TaxaConformidadeFiscal, StringFormat={}{0:N1}%}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource FP.Text}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Cumprimento" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="Atrasadas" Style="{StaticResource Muted}" HorizontalAlignment="Center"/><TextBlock Text="{Binding ObrigacoesFiscaisAtrasadas}" Foreground="{DynamicResource PerigoBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Próx. 7 dias" Style="{StaticResource Muted}" HorizontalAlignment="Center"/><TextBlock Text="{Binding ObrigacoesFiscaisProximas}" Foreground="{DynamicResource AvisoBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Cumpridas" Style="{StaticResource Muted}" HorizontalAlignment="Center"/><TextBlock Text="{Binding ObrigacoesFiscaisCumpridas}" Foreground="{DynamicResource SucessoBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <StackPanel><Grid><TextBlock Text="Empresa" Style="{StaticResource SectionTitle}"/><TextBlock Text="Ativa" HorizontalAlignment="Right" Foreground="{DynamicResource SucessoBrush}" FontSize="10"/></Grid><Border Background="{DynamicResource FP.AccentSoft}" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0"><StackPanel><TextBlock Text="{Binding EmpresaNome}" FontWeight="SemiBold" Foreground="{DynamicResource FP.Text}"/><TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"><Run Text="Exercício "/><Run Text="{Binding Exercicio}"/></TextBlock></StackPanel></Border></StackPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                        <StackPanel><TextBlock Text="Alertas" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Alertas}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Severidade, Converter={StaticResource SeveridadeParaCor}}"/><TextBlock Grid.Column="1" Text="{Binding Mensagem}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource FP.Text}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Bottom panels -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}"><StackPanel><Grid Margin="0,0,0,10"><TextBlock Text="Pendências (contas a receber)" Style="{StaticResource SectionTitle}"/><TextBlock Text="Ver todas" HorizontalAlignment="Right" Foreground="{DynamicResource FP.Accent}" FontSize="10"/></Grid><DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding Pendencias}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="105"><DataGrid.Columns><DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/><DataGridTextColumn Header="Vence" Binding="{Binding DataVencimento, StringFormat=dd/MM}" Width="Auto"/><DataGridTextColumn Header="Valor" Binding="{Binding Valor, Converter={StaticResource ValorMoeda}}" Width="Auto"/></DataGrid.Columns></DataGrid><TextBlock Text="Nenhuma pendência encontrada" Style="{StaticResource Muted}" Margin="8,12,0,0" Visibility="{Binding Pendencias, Converter={StaticResource ColecaoVaziaParaVisibilidade}}"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><Grid Margin="0,0,0,10"><TextBlock Text="Movimentos recentes" Style="{StaticResource SectionTitle}"/><TextBlock Text="Ver todos" HorizontalAlignment="Right" Foreground="{DynamicResource FP.Accent}" FontSize="10"/></Grid><ItemsControl ItemsSource="{Binding MovimentosRecentes}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Descricao}" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Valor, Converter={StaticResource ValorMoeda}}" FontSize="11" FontWeight="SemiBold"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Sem movimentos registados" Style="{StaticResource Muted}" Margin="8,12,0,0" Visibility="{Binding MovimentosRecentes, Converter={StaticResource ColecaoVaziaParaVisibilidade}}"/></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Saldos por origem" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding SaldosPorOrigem}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="105" HorizontalScrollBarVisibility="Disabled"><DataGrid.Columns><DataGridTextColumn Header="Origem" Binding="{Binding Nome}" Width="*" MinWidth="90"/><DataGridTextColumn Header="Saldo" Binding="{Binding Saldo, Converter={StaticResource ValorMoeda}}" Width="150" MinWidth="150"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="TextTrimming" Value="None"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid></StackPanel></Border>
            </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
