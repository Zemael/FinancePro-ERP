<UserControl x:Class="FinancePro.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F7FB"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCE5EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F2747"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F2747"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="QuickAction" TargetType="Button">
            <Setter Property="MinWidth" Value="126"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCE5EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F2747"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#F2F7FF"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#8EB5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F4F7FB">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="22" MaxWidth="1600" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Dashboard Executivo" FontSize="24" FontWeight="SemiBold" Foreground="#0F2747"/>
                        <TextBlock Margin="0,5,0,0" Foreground="#64748B" FontSize="12">
                            <Run Text="Visão consolidada de "/><Run Text="{Binding EmpresaNome}" FontWeight="SemiBold"/><Run Text=" · Exercício "/><Run Text="{Binding Exercicio}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="White" BorderBrush="#DCE5EF" BorderThickness="1" CornerRadius="9" Height="40" Padding="14,0" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="#315E91" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding UltimaAtualizacao}" Foreground="#334155" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding AtualizarCommand}" Height="40" Padding="18,0" Background="#2F6FED" Foreground="White" BorderThickness="0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                <TextBlock Text="Atualizar" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Search -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#64748B" VerticalAlignment="Center" FontSize="16"/>
                        <TextBox Grid.Column="1" Text="{Binding TermoPesquisa, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="12" VerticalContentAlignment="Center" ToolTip="Pesquisar clientes, fornecedores, documentos, movimentos e bens"/>
                        <TextBlock Grid.Column="2" Text="Pesquisa global" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <Popup Grid.Column="1" IsOpen="{Binding ResultadosPesquisaVisiveis}" Placement="Bottom" StaysOpen="False" Width="620">
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="10">
                                <ItemsControl ItemsSource="{Binding ResultadosPesquisa}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Tipo}" Foreground="#2F6FED" FontWeight="SemiBold" FontSize="10"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Descricao}" Foreground="#0F2747" FontSize="11"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Info}" Foreground="#64748B" FontSize="10"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

                <!-- KPI row 1 -->
                <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,10">
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="40" Height="40" Background="#EAF2FF" CornerRadius="10"><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="#2F6FED" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="DISPONIBILIDADE" Style="{StaticResource KpiLabel}"/><TextBlock Text="{Binding SaldoBancario, Converter={StaticResource ValorMoeda}}" Style="{StaticResource KpiValue}"/><TextBlock Text="Bancos e contas ativas" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Grid></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="40" Height="40" Background="#EAFBF3" CornerRadius="10"><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="#16A34A" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="CONTAS A RECEBER" Style="{StaticResource KpiLabel}"/><TextBlock Text="{Binding TotalAReceber, Converter={StaticResource ValorMoeda}}" Style="{StaticResource KpiValue}"/><TextBlock Text="Títulos ainda pendentes" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Grid></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="40" Height="40" Background="#FFF0F1" CornerRadius="10"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Foreground="#EF4444" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="CONTAS A PAGAR" Style="{StaticResource KpiLabel}"/><TextBlock Text="{Binding TotalAPagar, Converter={StaticResource ValorMoeda}}" Style="{StaticResource KpiValue}"/><TextBlock Text="Obrigações em aberto" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Grid></Border>
                    <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="40" Height="40" Background="#F4ECFF" CornerRadius="10"><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Foreground="#7C3AED" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="RESULTADO DO MÊS" Style="{StaticResource KpiLabel}"/><TextBlock Text="{Binding Resultado, Converter={StaticResource ValorMoeda}}" Style="{StaticResource KpiValue}"/><TextBlock Style="{StaticResource Muted}"><Run Text="Margem: "/><Run Text="{Binding MargemPercentual}"/><Run Text="%"/></TextBlock></StackPanel></Grid></Border>
                </UniformGrid>

                <!-- KPI row 2 -->
                <UniformGrid Grid.Row="3" Columns="4" Margin="0,0,0,14">
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="CAIXA" Style="{StaticResource KpiLabel}"/><TextBlock Text="{Binding SaldoCaixa, Converter={StaticResource ValorMoeda}}" Style="{StaticResource KpiValue}"/><TextBlock Text="Saldo físico consolidado" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="PATRIMÓNIO" Style="{StaticResource KpiLabel}"/><TextBlock Text="{Binding ValorPatrimonio, Converter={StaticResource ValorMoeda}}" Style="{StaticResource KpiValue}"/><TextBlock Text="Valor de aquisição ativo" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="COMPRAS PENDENTES" Style="{StaticResource KpiLabel}"/><TextBlock Text="{Binding ComprasPendentes}" Style="{StaticResource KpiValue}"/><TextBlock Text="Aguardando decisão" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="EXECUÇÃO ORÇAMENTAL" Style="{StaticResource KpiLabel}"/><TextBlock Text="{Binding ExecucaoOrcamental, StringFormat={}{0}%}" Style="{StaticResource KpiValue}"/><TextBlock Text="{Binding TotalOrcamento, Converter={StaticResource ValorMoeda}}" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Border>
                </UniformGrid>

                <!-- Actions -->
                <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,12"><TextBlock Text="Ações rápidas" Style="{StaticResource SectionTitle}"/><TextBlock Text="Operações mais utilizadas" HorizontalAlignment="Right" Style="{StaticResource Muted}"/></Grid>
                        <WrapPanel>
                            <Button Style="{StaticResource QuickAction}" Command="{Binding NovoMovimentoCommand}"><StackPanel><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="#2F6FED" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="Movimento" FontSize="11" Margin="0,6,0,0"/></StackPanel></Button>
                            <Button Style="{StaticResource QuickAction}" Command="{Binding NovaContaReceberCommand}"><StackPanel><TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" Foreground="#16A34A" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="Nova receita" FontSize="11" Margin="0,6,0,0"/></StackPanel></Button>
                            <Button Style="{StaticResource QuickAction}" Command="{Binding NovaDespesaCommand}"><StackPanel><TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" Foreground="#EF4444" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="Nova despesa" FontSize="11" Margin="0,6,0,0"/></StackPanel></Button>
                            <Button Style="{StaticResource QuickAction}" Command="{Binding NovaCompraCommand}"><StackPanel><TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" Foreground="#F59E0B" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="Nova compra" FontSize="11" Margin="0,6,0,0"/></StackPanel></Button>
                            <Button Style="{StaticResource QuickAction}" Command="{Binding NovoBemCommand}"><StackPanel><TextBlock Text="&#xE821;" FontFamily="Segoe MDL2 Assets" Foreground="#0EA5A8" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="Novo bem" FontSize="11" Margin="0,6,0,0"/></StackPanel></Button>
                            <Button Style="{StaticResource QuickAction}" Command="{Binding NovoOrcamentoCommand}"><StackPanel><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Foreground="#7C3AED" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="Novo orçamento" FontSize="11" Margin="0,6,0,0"/></StackPanel></Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Main content -->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10"><TextBlock Text="Fluxo de caixa — 6 meses" Style="{StaticResource SectionTitle}"/><TextBlock Text="Entradas, saídas e resultado" HorizontalAlignment="Right" Style="{StaticResource Muted}"/></Grid>
                            <DataGrid ItemsSource="{Binding FluxoMensal}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Período" Binding="{Binding Periodo}" Width="*"/>
                                    <DataGridTextColumn Header="Entradas" Binding="{Binding Entradas, Converter={StaticResource ValorMoeda}}" Width="120"/>
                                    <DataGridTextColumn Header="Saídas" Binding="{Binding Saidas, Converter={StaticResource ValorMoeda}}" Width="120"/>
                                    <DataGridTextColumn Header="Resultado" Binding="{Binding Resultado, Converter={StaticResource ValorMoeda}}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10"><TextBlock Text="Alertas operacionais" Style="{StaticResource SectionTitle}"/><Border HorizontalAlignment="Right" Background="#FFF3E5" CornerRadius="10" Padding="8,3"><TextBlock Text="{Binding TotalAlertas}" Foreground="#B45309" FontWeight="Bold" FontSize="10"/></Border></Grid>
                            <ItemsControl ItemsSource="{Binding Alertas}">
                                <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Severidade, Converter={StaticResource SeveridadeParaCor}}"/><TextBlock Grid.Column="1" Text="{Binding Mensagem}" TextWrapping="Wrap" FontSize="11" Foreground="#334155"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Saldos por origem" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <DataGrid ItemsSource="{Binding SaldosPorOrigem}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="180">
                                <DataGrid.Columns><DataGridTextColumn Header="Origem" Binding="{Binding Nome}" Width="*"/><DataGridTextColumn Header="Saldo" Binding="{Binding Saldo, Converter={StaticResource ValorMoeda}}" Width="110"/></DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Pendências de clientes" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <DataGrid ItemsSource="{Binding Pendencias}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="160">
                                <DataGrid.Columns><DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="*"/><DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="1.2*"/><DataGridTextColumn Header="Vence" Binding="{Binding DataVencimento, StringFormat=dd/MM/yyyy}" Width="90"/><DataGridTextColumn Header="Valor" Binding="{Binding Valor, Converter={StaticResource ValorMoeda}}" Width="110"/></DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Atividade recente" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding AtividadesRecentes}">
                                <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="28" Height="28" Background="#EAF2FF" CornerRadius="14"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="#2F6FED" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Descricao}" FontSize="11" Foreground="#0F2747" TextWrapping="Wrap"/><TextBlock Style="{StaticResource Muted}"><Run Text="{Binding Utilizador}"/><Run Text=" · "/><Run Text="{Binding Modulo}"/></TextBlock></StackPanel><TextBlock Grid.Column="2" Text="{Binding Data, StringFormat=dd/MM HH:mm}" Style="{StaticResource Muted}"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Sem atividade de auditoria" Style="{StaticResource Muted}" Margin="8,12,0,0" Visibility="{Binding AtividadesRecentes, Converter={StaticResource ColecaoVaziaParaVisibilidade}}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Movimentos recentes" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding MovimentosRecentes}">
                                <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Descricao}" FontSize="11" Foreground="#0F2747" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Data, StringFormat=dd/MM/yyyy}" Style="{StaticResource Muted}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Valor, Converter={StaticResource ValorMoeda}}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
