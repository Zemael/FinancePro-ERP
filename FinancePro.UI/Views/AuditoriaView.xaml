<UserControl x:Class="FinancePro.UI.Views.AuditoriaView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource FP.Page}">
 <Grid Margin="26,22,26,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Administração  ›  Segurança  ›  Auditoria" Foreground="{DynamicResource FP.TextMuted}" FontSize="11"/><TextBlock Text="Auditoria e controlo interno" Foreground="{DynamicResource FP.Text}" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Rastreabilidade de operações, utilizadores e alterações críticas." Foreground="{DynamicResource FP.TextMuted}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
  <Border Grid.Row="2" Style="{StaticResource FP.Card}"><StackPanel Orientation="Horizontal"><DatePicker SelectedDate="{Binding De}" Width="150"/><DatePicker SelectedDate="{Binding Ate}" Width="150" Margin="10,0,0,0"/><TextBox Text="{Binding Termo,UpdateSourceTrigger=PropertyChanged}" Width="280" Margin="10,0,0,0" ToolTip="Entidade, ação, utilizador ou detalhe"/><Button Content="Atualizar" Command="{Binding AtualizarCommand}" Style="{StaticResource FP.SecondaryButton}" Margin="10,0,0,0"/><TextBlock Text="{Binding Mensagem}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{DynamicResource FP.TextMuted}"/></StackPanel></Border>
  <Border Grid.Row="4" Style="{StaticResource FP.Card}"><DataGrid ItemsSource="{Binding Registos}" Style="{StaticResource FP.DataGrid}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Data/Hora" Binding="{Binding Data,StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="Auto"/><DataGridTextColumn Header="Utilizador" Binding="{Binding UtilizadorNome}" Width="Auto"/><DataGridTextColumn Header="Entidade" Binding="{Binding Entidade}" Width="Auto"/><DataGridTextColumn Header="Registo" Binding="{Binding RegistoId}" Width="Auto"/><DataGridTextColumn Header="Ação" Binding="{Binding Acao}" Width="Auto"/><DataGridTextColumn Header="Detalhe" Binding="{Binding Detalhe}" Width="*"/></DataGrid.Columns></DataGrid></Border>
 </Grid>
</UserControl>
