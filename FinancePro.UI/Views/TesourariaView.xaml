<UserControl x:Class="FinancePro.UI.Views.TesourariaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <TextBlock Text="Financeiro / Tesouraria" FontSize="11" Foreground="{DynamicResource GrayTextBrush}" Margin="0,0,0,2"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Tesouraria" Style="{StaticResource TituloModulo}" Margin="0"/>
                <Button Grid.Column="1" Content="Atualizar" Style="{StaticResource FP.SecondaryButton}" Command="{Binding AtualizarResumoCommand}" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="Movimentos financeiros — Entrada, Saída, Transferência, Sangria, Reforço, Ajuste, Bloqueio"
                       Style="{StaticResource TextoSecundario}" Margin="0,0,0,16" TextWrapping="Wrap"/>

            <!-- v6.11.0 · posição e previsão de tesouraria -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource FP.KpiCard}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource FP.AccentSoft}"><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FP.Accent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Saldo Disponível" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="150" HorizontalAlignment="Left"><TextBlock Text="{Binding Resumo.SaldoDisponivel, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.CompanyKpiValue}" Foreground="{DynamicResource TealDarkBrush}" TextWrapping="NoWrap"/></Viewbox><TextBlock Grid.Row="2" VerticalAlignment="Bottom" Text="Caixa + bancos" Style="{StaticResource FP.CompanyKpiCaption}" Foreground="{DynamicResource GrayTextBrush}"/></Grid>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource FP.KpiCard}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource SucessoSuaveBrush}"><TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SucessoBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="A Receber" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="150" HorizontalAlignment="Left"><TextBlock Text="{Binding Resumo.AReceberPendente, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.CompanyKpiValue}" Foreground="{DynamicResource SucessoBrush}" TextWrapping="NoWrap"/></Viewbox><TextBlock Grid.Row="2" VerticalAlignment="Bottom" Text="{Binding Resumo.TitulosReceberAtrasados, StringFormat={}{0} título(s) atrasado(s)}" Style="{StaticResource FP.CompanyKpiCaption}" Foreground="{DynamicResource AvisoBrush}"/></Grid>
                    </Grid>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource FP.KpiCard}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource PerigoSuaveBrush}"><TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource PerigoBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="A Pagar" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="150" HorizontalAlignment="Left"><TextBlock Text="{Binding Resumo.APagarPendente, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.CompanyKpiValue}" Foreground="{DynamicResource PerigoBrush}" TextWrapping="NoWrap"/></Viewbox><TextBlock Grid.Row="2" VerticalAlignment="Bottom" Text="{Binding Resumo.TitulosPagarAtrasados, StringFormat={}{0} título(s) atrasado(s)}" Style="{StaticResource FP.CompanyKpiCaption}" Foreground="{DynamicResource AvisoBrush}"/></Grid>
                    </Grid>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource FP.KpiCard}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource FP.AccentSoft}"><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FP.Accent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Previsão 30 Dias" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="150" HorizontalAlignment="Left"><TextBlock Text="{Binding Resumo.Previsao30Dias, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.CompanyKpiValue}" Foreground="{DynamicResource TealBrush}" TextWrapping="NoWrap"/></Viewbox><TextBlock Grid.Row="2" VerticalAlignment="Bottom" Text="{Binding Resumo.RiscoLiquidez, StringFormat=Risco de liquidez: {0}}" Style="{StaticResource FP.CompanyKpiCaption}" Foreground="{DynamicResource GrayTextBrush}"/></Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource Cartao}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Previsão de caixa · próximos 30 dias" Style="{StaticResource FP.SectionTitle}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource SucessoSuaveBrush}" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="Receber em 7 dias" Style="{StaticResource Rotulo}"/><TextBlock Text="{Binding Resumo.ReceberProximos7Dias, Converter={StaticResource ValorMoeda}}" FontSize="14" Foreground="{DynamicResource SucessoBrush}"/></StackPanel></Border>
                        <Border Grid.Column="2" Background="{DynamicResource PerigoSuaveBrush}" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="Pagar em 7 dias" Style="{StaticResource Rotulo}"/><TextBlock Text="{Binding Resumo.PagarProximos7Dias, Converter={StaticResource ValorMoeda}}" FontSize="14" Foreground="{DynamicResource PerigoBrush}"/></StackPanel></Border>
                        <Border Grid.Column="4" Background="{DynamicResource AvisoSuaveBrush}" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="Vencido líquido" Style="{StaticResource Rotulo}"/><TextBlock Text="{Binding Resumo.AReceberAtrasado, Converter={StaticResource ValorMoeda}}" FontSize="14" Foreground="{DynamicResource AvisoBrush}"/><TextBlock Text="A receber vencido" FontSize="9.5" Foreground="{DynamicResource GrayTextBrush}"/></StackPanel></Border>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource NeutroSuaveBrush}" CornerRadius="8" Padding="10"><StackPanel><TextBlock Text="7 DIAS" Style="{StaticResource Rotulo}"/><TextBlock Text="{Binding Resumo.Previsao7Dias, Converter={StaticResource ValorMoeda}}"/></StackPanel></Border>
                        <Border Grid.Column="2" Background="{DynamicResource NeutroSuaveBrush}" CornerRadius="8" Padding="10"><StackPanel><TextBlock Text="15 DIAS" Style="{StaticResource Rotulo}"/><TextBlock Text="{Binding Resumo.Previsao15Dias, Converter={StaticResource ValorMoeda}}"/></StackPanel></Border>
                        <Border Grid.Column="4" Background="{DynamicResource NeutroSuaveBrush}" CornerRadius="8" Padding="10"><StackPanel><TextBlock Text="60 DIAS" Style="{StaticResource Rotulo}"/><TextBlock Text="{Binding Resumo.Previsao60Dias, Converter={StaticResource ValorMoeda}}"/></StackPanel></Border>
                        <Border Grid.Column="6" Background="{DynamicResource AvisoSuaveBrush}" CornerRadius="8" Padding="10"><StackPanel><TextBlock Text="INADIMPLÊNCIA" Style="{StaticResource Rotulo}"/><TextBlock Text="{Binding Resumo.InadimplenciaPercentual, StringFormat={}{0:N1}%}" Foreground="{DynamicResource AvisoBrush}"/></StackPanel></Border>
                    </Grid>
                    <DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding Previsao}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Vencimento" Binding="{Binding Data, StringFormat=dd/MM/yyyy}" Width="Auto"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="Auto"/>
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
                            <DataGridTextColumn Header="Entidade" Binding="{Binding Entidade}" Width="Auto"/>
                            <DataGridTextColumn Header="Entrada" Binding="{Binding Entrada, Converter={StaticResource ValorMoeda}}" Width="Auto"/>
                            <DataGridTextColumn Header="Saída" Binding="{Binding Saida, Converter={StaticResource ValorMoeda}}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Aging financeiro" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TealDarkBrush}" Margin="0,14,0,6"/>
                    <DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding Aging}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="190">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Faixa" Binding="{Binding Faixa}" Width="*"/>
                            <DataGridTextColumn Header="A receber" Binding="{Binding AReceber, Converter={StaticResource ValorMoeda}}" Width="Auto"/>
                            <DataGridTextColumn Header="A pagar" Binding="{Binding APagar, Converter={StaticResource ValorMoeda}}" Width="Auto"/>
                            <DataGridTextColumn Header="Líquido" Binding="{Binding Liquido, Converter={StaticResource ValorMoeda}}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Data" Style="{StaticResource Rotulo}"/>
                            <DatePicker SelectedDate="{Binding Data}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tipo de operação" Style="{StaticResource Rotulo}"/>
                            <ComboBox ItemsSource="{Binding TiposOperacaoDisponiveis}" SelectedItem="{Binding TipoOperacaoSelecionado}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Valor (FCFA)" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding ValorTexto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding TipoCategoriaImplicito}" FontSize="9.5" Foreground="{DynamicResource GraySubBrush}" Margin="0,4,0,0"/>

                    <TextBlock Text="Descrição" Style="{StaticResource Rotulo}" Margin="0,14,0,4"/>
                    <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Origem única (Entrada / Saída / Ajuste / Bloqueio) -->
                    <Grid Margin="0,14,0,0" Visibility="{Binding EhTransferencia, Converter={StaticResource BoolParaVisibilidade}, ConverterParameter=Inverso}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Origem" Style="{StaticResource Rotulo}"/>
                            <ComboBox ItemsSource="{Binding Origens}" SelectedItem="{Binding OrigemSelecionada}" DisplayMemberPath="Nome"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Rubrica (categoria)" Style="{StaticResource Rotulo}"/>
                            <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSelecionada}" DisplayMemberPath="Nome"/>
                        </StackPanel>
                    </Grid>

                    <!-- Origem + Destino (Transferência / Sangria / Reforço) -->
                    <Grid Margin="0,14,0,0" Visibility="{Binding EhTransferencia, Converter={StaticResource BoolParaVisibilidade}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Origem (sai daqui)" Style="{StaticResource Rotulo}"/>
                            <ComboBox ItemsSource="{Binding Origens}" SelectedItem="{Binding OrigemSelecionada}" DisplayMemberPath="Nome"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Destino (entra aqui)" Style="{StaticResource Rotulo}"/>
                            <ComboBox ItemsSource="{Binding Origens}" SelectedItem="{Binding DestinoSelecionado}" DisplayMemberPath="Nome"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Forma de pagamento (ex.: Numerário, Transferência, Cheque, Cartão)" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding FormaPagamento, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Centro de custo" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding CentroCusto, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding MensagemErro}" Foreground="{DynamicResource PerigoBrush}" FontSize="10.5"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding MensagemErro, Converter={StaticResource TextoParaVisibilidade}}"/>

                    <Button Style="{StaticResource BotaoPrimario}" Content="{Binding AGuardar, Converter={StaticResource OcupadoParaTexto}, ConverterParameter=Registar}"
                            Command="{Binding RegistarCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Movimentos" Style="{StaticResource FP.SectionTitle}" Margin="0,20,0,10"/>

            <Border Style="{StaticResource Cartao}" Padding="0">
                <DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding Movimentos}" AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy}" Width="Auto"/>
                        <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
                        <DataGridTextColumn Header="Operação" Binding="{Binding TipoOperacao}" Width="Auto"/>
                        <DataGridTextColumn Header="Origem" Binding="{Binding Origem}" Width="Auto"/>
                        <DataGridTextColumn Header="F. Pagamento" Binding="{Binding FormaPagamento}" Width="Auto"/>
                        <DataGridTextColumn Header="C. Custo" Binding="{Binding CentroCusto}" Width="Auto"/>
                        <DataGridTextColumn Header="Valor" Binding="{Binding Valor, Converter={StaticResource ValorMoeda}}" Width="Auto"/>
                        <DataGridTemplateColumn Header="Conciliado" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Conciliado, Converter={StaticResource ConciliadoParaTexto}}"
                                            Command="{Binding DataContext.AlternarConciliadoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource BotaoLink}" Foreground="{DynamicResource TealBrush}" FontSize="10"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
