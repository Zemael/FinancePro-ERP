<UserControl x:Class="FinancePro.UI.Views.ExerciciosFinanceirosView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{StaticResource FP.Page}">
 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="350"/>
  </Grid.ColumnDefinitions>

  <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid Margin="26,22,22,26" MaxWidth="1420" HorizontalAlignment="Center">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="18"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="18"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="18"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="Cadastros Mestres  ›  Exercícios Financeiros" Foreground="{StaticResource FP.TextMuted}" FontSize="11"/>
      <TextBlock Text="Exercícios Financeiros" Foreground="{StaticResource FP.Text}" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/>
      <TextBlock Text="Administre os períodos utilizados em lançamentos, orçamento e relatórios." Foreground="{StaticResource FP.TextMuted}" FontSize="12" Margin="0,5,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Content="&#xE72C;  Atualizar" FontFamily="Segoe UI, Segoe MDL2 Assets" Command="{Binding PesquisarCommand}" Style="{StaticResource FP.SecondaryButton}" Margin="0,0,10,0"/>
      <Button Content="+  Novo Exercício" Command="{Binding NovoCommand}" Style="{StaticResource FP.PrimaryButton}"/>
     </StackPanel>
    </Grid>

    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Style="{StaticResource FP.KpiCard}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" Background="{StaticResource FP.AccentSoft}" CornerRadius="20"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Accent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Total de Exercícios" Foreground="{StaticResource FP.TextMuted}" FontSize="11"/><TextBlock Text="{Binding Exercicios.Count}" Foreground="{StaticResource FP.Text}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Registos existentes" Foreground="{StaticResource FP.TextMuted}" FontSize="10"/></StackPanel>
      </Grid>
     </Border>
     <Border Grid.Column="2" Style="{StaticResource FP.KpiCard}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" Background="{StaticResource FP.SuccessSoft}" CornerRadius="20"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Success}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Ano Selecionado" Foreground="{StaticResource FP.TextMuted}" FontSize="11"/><TextBlock Text="{Binding Selecionado.Ano, TargetNullValue=—}" Foreground="{StaticResource FP.Text}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Seleção atual" Foreground="{StaticResource FP.TextMuted}" FontSize="10"/></StackPanel>
      </Grid>
     </Border>
     <Border Grid.Column="4" Style="{StaticResource FP.KpiCard}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" Background="#FFF4E5" CornerRadius="20"><TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Warning}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Empresa" Foreground="{StaticResource FP.TextMuted}" FontSize="11"/><TextBlock Text="{Binding Selecionado.EmpresaNome, TargetNullValue=—}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource FP.Text}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Empresa associada" Foreground="{StaticResource FP.TextMuted}" FontSize="10"/></StackPanel>
      </Grid>
     </Border>
     <Border Grid.Column="6" Style="{StaticResource FP.KpiCard}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" Background="#F1EAFE" CornerRadius="20"><TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" Foreground="#7C3AED" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Estado" Foreground="{StaticResource FP.TextMuted}" FontSize="11"/><TextBlock Text="{Binding Selecionado.Ativo, Converter={StaticResource AtivoParaTexto}, TargetNullValue=—}" Foreground="{StaticResource FP.Text}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Situação do registo" Foreground="{StaticResource FP.TextMuted}" FontSize="10"/></StackPanel>
      </Grid>
     </Border>
    </Grid>

    <Border Grid.Row="4" Style="{StaticResource FP.Card}" Padding="16">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="160"/><ColumnDefinition Width="14"/><ColumnDefinition Width="160"/><ColumnDefinition Width="14"/><ColumnDefinition Width="110"/><ColumnDefinition Width="10"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0"><TextBlock Text="Pesquisar" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Pesquisa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FilterTextBox}" ToolTip="Ano ou empresa"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Estado" Style="{StaticResource FP.FieldLabel}"/><ComboBox Height="40"><ComboBoxItem Content="Todos" IsSelected="True"/><ComboBoxItem Content="Ativos"/><ComboBoxItem Content="Inativos"/></ComboBox></StackPanel>
      <StackPanel Grid.Column="4"><TextBlock Text="Situação" Style="{StaticResource FP.FieldLabel}"/><ComboBox Height="40"><ComboBoxItem Content="Todas" IsSelected="True"/><ComboBoxItem Content="Abertos"/><ComboBoxItem Content="Encerrados"/></ComboBox></StackPanel>
      <Button Grid.Column="6" Content="Pesquisar" Command="{Binding PesquisarCommand}" Style="{StaticResource FP.PrimaryButton}" VerticalAlignment="Bottom"/>
      <Button Grid.Column="8" Content="Limpar" Command="{Binding NovoCommand}" Style="{StaticResource FP.SecondaryButton}" VerticalAlignment="Bottom"/>
     </Grid>
    </Border>

    <Border Grid.Row="6" Style="{StaticResource FP.Card}" Padding="0">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
      <DataGrid Grid.Row="0" ItemsSource="{Binding Exercicios}" SelectedItem="{Binding Selecionado}" Style="{StaticResource FP.DataGrid}">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Ano" Binding="{Binding Ano}" Width="85"/>
        <DataGridTextColumn Header="Empresa" Binding="{Binding EmpresaNome}" Width="2*"/>
        <DataGridTextColumn Header="Data Inicial" Binding="{Binding DataInicio, StringFormat=dd/MM/yyyy}" Width="125"/>
        <DataGridTextColumn Header="Data Final" Binding="{Binding DataFim, StringFormat=dd/MM/yyyy}" Width="125"/>
        <DataGridCheckBoxColumn Header="Padrão" Binding="{Binding Padrao}" Width="85"/>
        <DataGridCheckBoxColumn Header="Encerrado" Binding="{Binding Encerrado}" Width="95"/>
        <DataGridTemplateColumn Header="Estado" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource FP.StatusActive}" HorizontalAlignment="Left"><TextBlock Text="{Binding Ativo, Converter={StaticResource AtivoParaTexto}}" Foreground="{Binding Ativo, Converter={StaticResource AtivoParaCor}}" FontSize="10" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Ações" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="&#xE70F;" Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource FP.IconButton}" Width="34" Height="40" Margin="0,0,6,0" ToolTip="Editar"/><Button Content="&#xE8D8;" Command="{Binding DataContext.AlternarAtivoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}" Width="34" Height="40" ToolTip="Ativar/Desativar"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
      <Grid Grid.Row="1" Margin="14,0"><TextBlock Text="Exercícios carregados" Foreground="{StaticResource FP.TextMuted}" FontSize="10" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="‹" Style="{StaticResource FP.SecondaryButton}" Width="34" Height="40" Padding="0"/><Border Background="{StaticResource FP.Accent}" CornerRadius="5" Margin="6,0" Width="34" Height="30"><TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Button Content="›" Style="{StaticResource FP.SecondaryButton}" Width="34" Height="40" Padding="0"/></StackPanel></Grid>
     </Grid>
    </Border>
   </Grid>
  </ScrollViewer>

  <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource FP.Border}" BorderThickness="1,0,0,0">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="22">
     <Grid><TextBlock Text="Dados do Exercício" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource FP.Text}"/><Button Content="&#xE711;" HorizontalAlignment="Right" Style="{StaticResource FP.IconButton}" Width="34" Height="40" Command="{Binding NovoCommand}"/></Grid>
     <Border Height="1" Background="{StaticResource FP.Border}" Margin="0,18"/>
     <Border Width="72" Height="72" Background="{StaticResource FP.AccentSoft}" CornerRadius="36" HorizontalAlignment="Left" Margin="0,0,0,18"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Accent}" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="Empresa" Style="{StaticResource FP.FieldLabel}"/><ComboBox ItemsSource="{Binding Empresas}" DisplayMemberPath="Nome" SelectedValuePath="Id" SelectedValue="{Binding EmpresaId}" Height="40" Margin="0,0,0,12"/>
     <TextBlock Text="Ano" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Ano}" Margin="0,0,0,12"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Data inicial" Style="{StaticResource FP.FieldLabel}"/><DatePicker SelectedDate="{Binding DataInicio}" Height="40" Margin="0,0,0,12"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Data final" Style="{StaticResource FP.FieldLabel}"/><DatePicker SelectedDate="{Binding DataFim}" Height="40" Margin="0,0,0,12"/></StackPanel>
     </Grid>
     <CheckBox Content="Definir como exercício padrão" IsChecked="{Binding Padrao}" Margin="0,4,0,10"/>
     <CheckBox Content="Exercício encerrado" IsChecked="{Binding Encerrado}" Margin="0,0,0,14"/>
     <Border Background="{StaticResource FP.AccentSoft}" CornerRadius="8" Padding="10" Margin="0,0,0,14" Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade}}"><TextBlock Text="{Binding Mensagem}" Foreground="{StaticResource FP.Accent}" TextWrapping="Wrap" FontSize="11"/></Border>
     <Button Content="Guardar Exercício" Command="{Binding GuardarCommand}" Style="{StaticResource FP.PrimaryButton}" HorizontalAlignment="Stretch"/>
     <Button Content="Carregar selecionado" Command="{Binding EditarCommand}" Style="{StaticResource FP.SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
     <Border Height="1" Background="{StaticResource FP.Border}" Margin="0,22"/>
     <TextBlock Text="Fecho Anual" Style="{StaticResource FP.SectionTitle}" Margin="0,0,0,10"/>
     <TextBlock Text="Conta de Resultado do Exercício" Style="{StaticResource FP.FieldLabel}"/>
     <ComboBox ItemsSource="{Binding ContasFecho}" DisplayMemberPath="Descricao" SelectedValuePath="Id" SelectedValue="{Binding ContaResultadoId}" Height="40" Margin="0,0,0,8"/>
     <TextBlock Text="Conta de Resultados Transitados" Style="{StaticResource FP.FieldLabel}"/>
     <ComboBox ItemsSource="{Binding ContasFecho}" DisplayMemberPath="Descricao" SelectedValuePath="Id" SelectedValue="{Binding ContaResultadosTransitadosId}" Height="40" Margin="0,0,0,8"/>
     <Button Content="Guardar contas de fecho" Command="{Binding GuardarConfiguracaoFechoCommand}" Style="{StaticResource FP.SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>
     <TextBlock Text="Classificar conta movimentada" Style="{StaticResource FP.FieldLabel}"/>
     <ComboBox ItemsSource="{Binding ContasFecho}" DisplayMemberPath="Descricao" SelectedItem="{Binding ContaClassificacao}" Height="40" Margin="0,0,0,6"/>
     <ComboBox ItemsSource="{Binding ClassificacoesConta}" SelectedItem="{Binding ClassificacaoSelecionada}" Height="40" Margin="0,0,0,6"/>
     <Button Content="Guardar classificação" Command="{Binding GuardarClassificacaoContaCommand}" Style="{StaticResource FP.SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>
     <TextBlock Text="Valide todos os períodos, contas e saldos antes de encerrar o exercício." Foreground="{StaticResource FP.TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10"/>
     <Button Content="Validar Fecho" Command="{Binding ValidarFechoCommand}" Style="{StaticResource FP.SecondaryButton}" HorizontalAlignment="Stretch"/>
     <TextBlock Text="{Binding ResumoFecho}" Foreground="{StaticResource FP.Text}" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,10"/>
     <Button Content="Encerrar Exercício" Command="{Binding EncerrarExercicioCommand}" Style="{StaticResource FP.PrimaryButton}" HorizontalAlignment="Stretch"/>
     <TextBlock Text="Motivo da reabertura" Style="{StaticResource FP.FieldLabel}" Margin="0,12,0,0"/>
     <TextBox Text="{Binding MotivoReabertura, UpdateSourceTrigger=PropertyChanged}" MinHeight="40"/>
     <Button Content="Reabrir Exercício" Command="{Binding ReabrirExercicioCommand}" Style="{StaticResource FP.SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
     <Border Height="1" Background="{StaticResource FP.Border}" Margin="0,22"/>
     <TextBlock Text="Resumo rápido" Style="{StaticResource FP.SectionTitle}" Margin="0,0,0,12"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource FP.Card}" Padding="12"><StackPanel><TextBlock Text="Ano" Foreground="{StaticResource FP.TextMuted}" FontSize="10"/><TextBlock Text="{Binding Selecionado.Ano, TargetNullValue=—}" Foreground="{StaticResource FP.Accent}" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource FP.Card}" Padding="12"><StackPanel><TextBlock Text="Estado" Foreground="{StaticResource FP.TextMuted}" FontSize="10"/><TextBlock Text="{Binding Selecionado.Ativo, Converter={StaticResource AtivoParaTexto}, TargetNullValue=—}" Foreground="{StaticResource FP.Success}" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
     </Grid>
    </StackPanel>
   </ScrollViewer>
  </Border>
 </Grid>
</UserControl>
