<UserControl x:Class="FinancePro.UI.Views.OrcamentoView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource FP.Page}" FontFamily="Segoe UI"><Grid Background="{StaticResource FP.Page}"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="22,20" MaxWidth="1500" HorizontalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="Orçamento" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource FP.Text}"/><TextBlock Text="Planeamento, execução, revisões e acompanhamento orçamental." Foreground="{StaticResource FP.TextMuted}" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Border Background="White" BorderBrush="{StaticResource FP.Border}" BorderThickness="1" CornerRadius="9" Height="40" Padding="14,0" Margin="0,0,10,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Accent}" Margin="0,0,8,0"/><StackPanel><TextBlock Text="Última atualização" Foreground="{StaticResource FP.TextMuted}" FontSize="9"/><TextBlock Text="{Binding UltimaAtualizacao}" FontSize="11" FontWeight="SemiBold"/></StackPanel></StackPanel></Border><Button Command="{Binding AtualizarCommand}" Style="{StaticResource FP.SecondaryButton}" Content="Atualizar"/></StackPanel></Grid><UniformGrid Grid.Row="2" Columns="4"><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="RECEITAS PREVISTAS" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding TotalPrevistoReceitas, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Planeamento anual" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="RECEITAS REALIZADAS" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding TotalRealizadoReceitas, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Execução acumulada" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="DESPESAS PREVISTAS" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding TotalPrevistoDespesas, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Limite programado" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="RESULTADO REALIZADO" Style="{StaticResource FP.KpiLabel}"/><TextBlock Text="{Binding ResultadoRealizado, Converter={StaticResource ValorMoeda}}" Style="{StaticResource FP.KpiValue}"/><TextBlock Text="Receitas menos despesas" Style="{StaticResource FP.KpiHint}"/></StackPanel></Border></UniformGrid><Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.Card}"><StackPanel><TextBlock Text="Orçamentos" Style="{StaticResource FP.SectionTitle}"/><TextBlock Text="Selecione um plano para trabalhar." Style="{StaticResource FP.KpiHint}" Margin="0,0,0,12"/><ListBox ItemsSource="{Binding Orcamentos}" SelectedItem="{Binding OrcamentoSelecionado}" DisplayMemberPath="Nome" Height="220"/><Separator Margin="0,16"/><TextBlock Text="Novo orçamento" Style="{StaticResource FP.SectionTitle}"/><TextBlock Text="Ano" Style="{StaticResource FP.FieldLabel}" Margin="0,10,0,0"/><TextBox Text="{Binding NovoAno}"/><TextBlock Text="Nome" Style="{StaticResource FP.FieldLabel}" Margin="0,10,0,0"/><TextBox Text="{Binding NovoNome}"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Início" Style="{StaticResource FP.FieldLabel}"/><DatePicker SelectedDate="{Binding NovaDataInicio}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Fim" Style="{StaticResource FP.FieldLabel}"/><DatePicker SelectedDate="{Binding NovaDataFim}"/></StackPanel></Grid><TextBlock Text="Moeda" Style="{StaticResource FP.FieldLabel}" Margin="0,10,0,0"/><TextBox Text="{Binding NovaMoeda}"/><TextBlock Text="{Binding MensagemErroOrcamento}" Foreground="{StaticResource FP.Danger}" TextWrapping="Wrap" Margin="0,10,0,0"/><Button Content="Criar orçamento" Command="{Binding CriarOrcamentoCommand}" Style="{StaticResource FP.PrimaryButton}" Margin="0,14,0,0"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource FP.Card}" Padding="14"><TabControl><TabItem Header="Receitas"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="80"/><ColumnDefinition Width="10"/><ColumnDefinition Width="120"/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Contas}" SelectedItem="{Binding ContaSelecionadaReceita}" DisplayMemberPath="Nome"/><TextBox Grid.Column="2" Text="{Binding CentroCustoReceita}" ToolTip="Centro de custo"/><TextBox Grid.Column="4" Text="{Binding DepartamentoReceita}" ToolTip="Departamento"/><ComboBox Grid.Column="6" ItemsSource="{Binding MesesDisponiveis}" SelectedItem="{Binding MesReceita}"/><TextBox Grid.Column="8" Text="{Binding ValorPrevistoReceitaTexto}" ToolTip="Valor previsto"/><Button Grid.Column="10" Content="Adicionar" Command="{Binding AdicionarReceitaCommand}" Style="{StaticResource FP.PrimaryButton}"/></Grid><DataGrid Grid.Row="2" ItemsSource="{Binding ReceitasPrevistas}" Style="{StaticResource FP.DataGrid}"><DataGrid.Columns><DataGridTextColumn Header="CONTA" Binding="{Binding PlanoContasNome}" Width="*"/><DataGridTextColumn Header="C. CUSTO" Binding="{Binding CentroCusto}" Width="100"/><DataGridTextColumn Header="DEPARTAMENTO" Binding="{Binding Departamento}" Width="110"/><DataGridTextColumn Header="MÊS" Binding="{Binding MesNome}" Width="80"/><DataGridTextColumn Header="PREVISTO" Binding="{Binding ValorPrevisto, Converter={StaticResource ValorMoeda}}" Width="120"/><DataGridTextColumn Header="REALIZADO" Binding="{Binding ValorRealizado, Converter={StaticResource ValorMoeda}}" Width="120"/></DataGrid.Columns></DataGrid></Grid></TabItem><TabItem Header="Despesas"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="80"/><ColumnDefinition Width="10"/><ColumnDefinition Width="120"/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Contas}" SelectedItem="{Binding ContaSelecionadaDespesa}" DisplayMemberPath="Nome"/><TextBox Grid.Column="2" Text="{Binding CentroCustoDespesa}" ToolTip="Centro de custo"/><TextBox Grid.Column="4" Text="{Binding DepartamentoDespesa}" ToolTip="Departamento"/><ComboBox Grid.Column="6" ItemsSource="{Binding MesesDisponiveis}" SelectedItem="{Binding MesDespesa}"/><TextBox Grid.Column="8" Text="{Binding ValorPrevistoDespesaTexto}" ToolTip="Valor previsto"/><Button Grid.Column="10" Content="Adicionar" Command="{Binding AdicionarDespesaCommand}" Style="{StaticResource FP.PrimaryButton}"/></Grid><DataGrid Grid.Row="2" ItemsSource="{Binding DespesasPrevistas}" Style="{StaticResource FP.DataGrid}"><DataGrid.Columns><DataGridTextColumn Header="CONTA" Binding="{Binding PlanoContasNome}" Width="*"/><DataGridTextColumn Header="C. CUSTO" Binding="{Binding CentroCusto}" Width="100"/><DataGridTextColumn Header="DEPARTAMENTO" Binding="{Binding Departamento}" Width="110"/><DataGridTextColumn Header="MÊS" Binding="{Binding MesNome}" Width="80"/><DataGridTextColumn Header="PREVISTO" Binding="{Binding ValorPrevisto, Converter={StaticResource ValorMoeda}}" Width="120"/><DataGridTextColumn Header="REALIZADO" Binding="{Binding ValorRealizado, Converter={StaticResource ValorMoeda}}" Width="120"/></DataGrid.Columns></DataGrid></Grid></TabItem><TabItem Header="Execução"><DataGrid Margin="8" ItemsSource="{Binding Execucao}" Style="{StaticResource FP.DataGrid}"><DataGrid.Columns><DataGridTextColumn Header="MÊS" Binding="{Binding MesNome}" Width="100"/><DataGridTextColumn Header="RECEITAS PREVISTAS" Binding="{Binding PrevistoReceitas, Converter={StaticResource ValorMoeda}}" Width="150"/><DataGridTextColumn Header="RECEITAS REALIZADAS" Binding="{Binding RealizadoReceitas, Converter={StaticResource ValorMoeda}}" Width="150"/><DataGridTextColumn Header="DESPESAS PREVISTAS" Binding="{Binding PrevistoDespesas, Converter={StaticResource ValorMoeda}}" Width="150"/><DataGridTextColumn Header="DESPESAS REALIZADAS" Binding="{Binding RealizadoDespesas, Converter={StaticResource ValorMoeda}}" Width="*"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Revisões"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="220"/><ColumnDefinition Width="10"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBox Text="{Binding MotivoRevisao}" ToolTip="Motivo da revisão"/><TextBox Grid.Column="2" Text="{Binding ResponsavelRevisao}" ToolTip="Responsável"/><Button Grid.Column="4" Content="Registar revisão" Command="{Binding AdicionarRevisaoCommand}" Style="{StaticResource FP.PrimaryButton}"/></Grid><DataGrid Grid.Row="2" ItemsSource="{Binding Revisoes}" Style="{StaticResource FP.DataGrid}"><DataGrid.Columns><DataGridTextColumn Header="VERSÃO" Binding="{Binding Versao}" Width="70"/><DataGridTextColumn Header="DATA" Binding="{Binding Data, StringFormat=dd/MM/yyyy}" Width="100"/><DataGridTextColumn Header="MOTIVO" Binding="{Binding Motivo}" Width="*"/><DataGridTextColumn Header="RESPONSÁVEL" Binding="{Binding Responsavel}" Width="140"/><DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="100"/></DataGrid.Columns></DataGrid></Grid></TabItem></TabControl></Border></Grid></Grid></ScrollViewer></Grid></UserControl>