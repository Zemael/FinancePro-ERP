<UserControl x:Class="FinancePro.UI.Views.OrcamentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="BorderBrush" Value="#DCEAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#595959"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="RotuloCartao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#595959"/>
        </Style>
        <Style x:Key="ValorCartao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>

            <TextBlock Text="Gestão Orçamental" FontSize="16" FontWeight="Bold" Foreground="#0E4C5E" Margin="0,0,0,4"/>
            <TextBlock Text="Orçamento anual por conta, mês, centro de custo e departamento"
                       FontSize="10.5" Foreground="#595959" Margin="0,0,0,14"/>

            <!-- Criar / escolher orçamento -->
            <Border Style="{StaticResource Cartao}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ano" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding NovoAno, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Nome" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding NovoNome, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Data início" Style="{StaticResource Rotulo}"/>
                            <DatePicker SelectedDate="{Binding NovaDataInicio}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Data fim" Style="{StaticResource Rotulo}"/>
                            <DatePicker SelectedDate="{Binding NovaDataFim}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="8">
                            <TextBlock Text="Moeda" Style="{StaticResource Rotulo}"/>
                            <TextBox Text="{Binding NovaMoeda, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding MensagemErroOrcamento}" Foreground="#C00000" FontSize="10.5"
                               Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding MensagemErroOrcamento, Converter={StaticResource TextoParaVisibilidade}}"/>
                    <Button Style="{StaticResource BotaoPrimario}" Command="{Binding CriarOrcamentoCommand}"
                            Content="{Binding AGuardarOrcamento, Converter={StaticResource OcupadoParaTexto}, ConverterParameter=Criar orçamento}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Cartao}" Padding="0" Margin="0,10,0,0">
                <DataGrid ItemsSource="{Binding Orcamentos}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="32" BorderThickness="0"
                          SelectedItem="{Binding OrcamentoSelecionado, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ano" Binding="{Binding Ano}" Width="60"/>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                        <DataGridTextColumn Header="Início" Binding="{Binding DataInicio, StringFormat=dd/MM/yyyy}" Width="90"/>
                        <DataGridTextColumn Header="Fim" Binding="{Binding DataFim, StringFormat=dd/MM/yyyy}" Width="90"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock Text="Clique numa linha acima para escolher o orçamento em edição."
                       FontSize="9.5" Foreground="#888780" Margin="0,4,0,0"
                       Visibility="{Binding OrcamentoSelecionado, Converter={StaticResource ObjetoParaVisibilidade}, ConverterParameter=Inverso}"/>

            <!-- Detalhe do orçamento selecionado -->
            <Border Style="{StaticResource Cartao}" Margin="0,16,0,0"
                    Visibility="{Binding OrcamentoSelecionado, Converter={StaticResource ObjetoParaVisibilidade}}">
                <TabControl>

                    <TabItem Header="Receitas Previstas">
                        <StackPanel Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Conta do plano" Style="{StaticResource Rotulo}"/>
                                    <ComboBox ItemsSource="{Binding Contas}" SelectedItem="{Binding ContaSelecionadaReceita}" DisplayMemberPath="Nome"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Centro de custo" Style="{StaticResource Rotulo}"/>
                                    <TextBox Text="{Binding CentroCustoReceita, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Departamento" Style="{StaticResource Rotulo}"/>
                                    <TextBox Text="{Binding DepartamentoReceita, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Mês" Style="{StaticResource Rotulo}"/>
                                    <ComboBox ItemsSource="{Binding MesesDisponiveis}" SelectedItem="{Binding MesReceita}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="8">
                                    <TextBlock Text="Valor previsto" Style="{StaticResource Rotulo}"/>
                                    <TextBox Text="{Binding ValorPrevistoReceitaTexto, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding MensagemErroReceita}" Foreground="#C00000" FontSize="10.5"
                                       Margin="0,8,0,0" Visibility="{Binding MensagemErroReceita, Converter={StaticResource TextoParaVisibilidade}}"/>
                            <Button Content="Adicionar linha" Style="{StaticResource BotaoPrimario}" Command="{Binding AdicionarReceitaCommand}"/>

                            <DataGrid ItemsSource="{Binding ReceitasPrevistas}" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="30" BorderThickness="0" Margin="0,14,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Conta" Binding="{Binding PlanoContasNome}" Width="*"/>
                                    <DataGridTextColumn Header="C. Custo" Binding="{Binding CentroCusto}" Width="90"/>
                                    <DataGridTextColumn Header="Depart." Binding="{Binding Departamento}" Width="90"/>
                                    <DataGridTextColumn Header="Mês" Binding="{Binding MesNome}" Width="80"/>
                                    <DataGridTextColumn Header="Previsto" Binding="{Binding ValorPrevisto, Converter={StaticResource ValorMoeda}}" Width="110"/>
                                    <DataGridTextColumn Header="Realizado" Binding="{Binding ValorRealizado, Converter={StaticResource ValorMoeda}}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Despesas">
                        <StackPanel Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Conta do plano" Style="{StaticResource Rotulo}"/>
                                    <ComboBox ItemsSource="{Binding Contas}" SelectedItem="{Binding ContaSelecionadaDespesa}" DisplayMemberPath="Nome"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Centro de custo" Style="{StaticResource Rotulo}"/>
                                    <TextBox Text="{Binding CentroCustoDespesa, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Departamento" Style="{StaticResource Rotulo}"/>
                                    <TextBox Text="{Binding DepartamentoDespesa, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Mês" Style="{StaticResource Rotulo}"/>
                                    <ComboBox ItemsSource="{Binding MesesDisponiveis}" SelectedItem="{Binding MesDespesa}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="8">
                                    <TextBlock Text="Valor previsto" Style="{StaticResource Rotulo}"/>
                                    <TextBox Text="{Binding ValorPrevistoDespesaTexto, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding MensagemErroDespesa}" Foreground="#C00000" FontSize="10.5"
                                       Margin="0,8,0,0" Visibility="{Binding MensagemErroDespesa, Converter={StaticResource TextoParaVisibilidade}}"/>
                            <Button Content="Adicionar linha" Style="{StaticResource BotaoPrimario}" Command="{Binding AdicionarDespesaCommand}"/>

                            <DataGrid ItemsSource="{Binding DespesasPrevistas}" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="30" BorderThickness="0" Margin="0,14,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Conta" Binding="{Binding PlanoContasNome}" Width="*"/>
                                    <DataGridTextColumn Header="C. Custo" Binding="{Binding CentroCusto}" Width="90"/>
                                    <DataGridTextColumn Header="Depart." Binding="{Binding Departamento}" Width="90"/>
                                    <DataGridTextColumn Header="Mês" Binding="{Binding MesNome}" Width="80"/>
                                    <DataGridTextColumn Header="Previsto" Binding="{Binding ValorPrevisto, Converter={StaticResource ValorMoeda}}" Width="110"/>
                                    <DataGridTextColumn Header="Realizado" Binding="{Binding ValorRealizado, Converter={StaticResource ValorMoeda}}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Execução (Plano Mensal)">
                        <DataGrid ItemsSource="{Binding Execucao}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="30" BorderThickness="0" Margin="0,10,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mês" Binding="{Binding MesNome}" Width="100"/>
                                <DataGridTextColumn Header="Receitas previstas" Binding="{Binding PrevistoReceitas, Converter={StaticResource ValorMoeda}}" Width="130"/>
                                <DataGridTextColumn Header="Receitas realizadas" Binding="{Binding RealizadoReceitas, Converter={StaticResource ValorMoeda}}" Width="130"/>
                                <DataGridTextColumn Header="Despesas previstas" Binding="{Binding PrevistoDespesas, Converter={StaticResource ValorMoeda}}" Width="130"/>
                                <DataGridTextColumn Header="Despesas realizadas" Binding="{Binding RealizadoDespesas, Converter={StaticResource ValorMoeda}}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Revisões">
                        <StackPanel Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Motivo" Style="{StaticResource Rotulo}"/>
                                    <TextBox Text="{Binding MotivoRevisao, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Responsável" Style="{StaticResource Rotulo}"/>
                                    <TextBox Text="{Binding ResponsavelRevisao, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding MensagemErroRevisao}" Foreground="#C00000" FontSize="10.5"
                                       Margin="0,8,0,0" Visibility="{Binding MensagemErroRevisao, Converter={StaticResource TextoParaVisibilidade}}"/>
                            <Button Content="Registar revisão" Style="{StaticResource BotaoPrimario}" Command="{Binding AdicionarRevisaoCommand}"/>

                            <DataGrid ItemsSource="{Binding Revisoes}" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="30" BorderThickness="0" Margin="0,14,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Versão" Binding="{Binding Versao}" Width="60"/>
                                    <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy}" Width="90"/>
                                    <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="*"/>
                                    <DataGridTextColumn Header="Responsável" Binding="{Binding Responsavel}" Width="120"/>
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Relatórios">
                        <UniformGrid Columns="3" Margin="0,10,0,0">
                            <Border Style="{StaticResource Cartao}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="RECEITAS: PREVISTO VS REALIZADO" Style="{StaticResource RotuloCartao}"/>
                                    <TextBlock Style="{StaticResource ValorCartao}" Foreground="#0E4C5E">
                                        <Run Text="{Binding TotalPrevistoReceitas, Converter={StaticResource ValorMoeda}, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10.5" Foreground="#0F6E56" Margin="0,2,0,0">
                                        <Run Text="Realizado: "/><Run Text="{Binding TotalRealizadoReceitas, Converter={StaticResource ValorMoeda}, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Cartao}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="DESPESAS: PREVISTO VS REALIZADO" Style="{StaticResource RotuloCartao}"/>
                                    <TextBlock Style="{StaticResource ValorCartao}" Foreground="#0E4C5E">
                                        <Run Text="{Binding TotalPrevistoDespesas, Converter={StaticResource ValorMoeda}, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10.5" Foreground="#C00000" Margin="0,2,0,0">
                                        <Run Text="Realizado: "/><Run Text="{Binding TotalRealizadoDespesas, Converter={StaticResource ValorMoeda}, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Cartao}">
                                <StackPanel>
                                    <TextBlock Text="RESULTADO: PREVISTO VS REALIZADO" Style="{StaticResource RotuloCartao}"/>
                                    <TextBlock Text="{Binding ResultadoPrevisto, Converter={StaticResource ValorMoeda}}" Style="{StaticResource ValorCartao}"
                                               Foreground="{Binding ResultadoPrevisto, Converter={StaticResource ValorParaCor}}"/>
                                    <TextBlock FontSize="10.5" Margin="0,2,0,0" Foreground="{Binding ResultadoRealizado, Converter={StaticResource ValorParaCor}}">
                                        <Run Text="Realizado: "/><Run Text="{Binding ResultadoRealizado, Converter={StaticResource ValorMoeda}, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </TabItem>

                </TabControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
