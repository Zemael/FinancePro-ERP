<UserControl x:Class="FinancePro.UI.Views.AccountingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="{DynamicResource FundoPrincipalBrush}"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24"><StackPanel>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Contabilidade Geral" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TealDarkBrush}"/><TextBlock Text="Lançamentos, Diário Geral, Razão, Balancete e DRE" Foreground="{DynamicResource FP.TextMuted}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Saldos de abertura" Command="{Binding PrepareOpeningCommand}" Margin="0,0,8,0"/><Button Content="Novo" Command="{Binding NewCommand}" Margin="0,0,8,0"/><Button Content="Atualizar" Command="{Binding RefreshCommand}" Style="{StaticResource FP.SecondaryButton}"/></StackPanel></Grid>
  <UniformGrid Columns="4" Margin="0,0,0,18"><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource AvisoSuaveBrush}"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AvisoBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Rascunhos" Style="{StaticResource FP.CompanyKpiLabel}"/><TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding Drafts}" Style="{StaticResource FP.CompanyKpiValue}" Foreground="{DynamicResource AvisoBrush}"/></Grid></Grid></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource SucessoSuaveBrush}"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SucessoBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Contabilizados" Style="{StaticResource FP.CompanyKpiLabel}"/><TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding Posted}" Style="{StaticResource FP.CompanyKpiValue}" Foreground="{DynamicResource SucessoBrush}"/></Grid></Grid></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource FP.AccentSoft}"><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FP.Accent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Total Débito" Style="{StaticResource FP.CompanyKpiLabel}"/><TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding TotalDebit, StringFormat=N0}" Style="{StaticResource FP.CompanyKpiValue}" Foreground="{DynamicResource TealDarkBrush}"/></Grid></Grid></Border><Border Style="{StaticResource FP.KpiCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource FP.AccentSoft}"><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FP.Accent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Total Crédito" Style="{StaticResource FP.CompanyKpiLabel}"/><TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding TotalCredit, StringFormat=N0}" Style="{StaticResource FP.CompanyKpiValue}" Foreground="{DynamicResource TealDarkBrush}"/></Grid></Grid></Border></UniformGrid>
  <TabControl>
   <TabItem Header="Lançamentos"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource FP.Card}"><StackPanel><TextBlock Text="Diário de lançamentos" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TealDarkBrush}" Margin="0,0,0,12"/><DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="420"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding EntryDate, StringFormat=dd/MM/yyyy}" Width="Auto"/><DataGridTextColumn Header="Documento" Binding="{Binding DocumentNumber}" Width="Auto"/><DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Débito" Binding="{Binding TotalDebit, StringFormat=N0}" Width="Auto"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="Auto"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Contabilizar" Command="{Binding PostCommand}" Style="{StaticResource BaseButton}" Margin="0,0,8,0"/><Button Content="Estornar" Command="{Binding ReverseCommand}"/></StackPanel></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource FP.Card}"><StackPanel><TextBlock Text="Novo lançamento" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TealDarkBrush}"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Data" FontWeight="SemiBold"/><DatePicker SelectedDate="{Binding EntryDate}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Documento" FontWeight="SemiBold"/><TextBox Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid><TextBlock Text="Referência" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Descrição" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Linhas" FontWeight="SemiBold" Margin="0,14,0,6"/><ItemsControl ItemsSource="{Binding DraftLines}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="90"/><ColumnDefinition Width="8"/><ColumnDefinition Width="90"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Account}" DisplayMemberPath="Name"/><TextBox Grid.Column="2" Text="{Binding Debit, UpdateSourceTrigger=PropertyChanged}" ToolTip="Débito"/><TextBox Grid.Column="4" Text="{Binding Credit, UpdateSourceTrigger=PropertyChanged}" ToolTip="Crédito"/><Button Grid.Column="6" Content="×" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="+ Adicionar linha" Command="{Binding AddLineCommand}" HorizontalAlignment="Left"/><Button Content="Guardar rascunho" Command="{Binding SaveCommand}" Style="{StaticResource BaseButton}" Margin="0,14,0,0"/></StackPanel></Border></Grid></TabItem>
   <TabItem Header="Diário Geral"><StackPanel Margin="12"><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="160"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DatePicker SelectedDate="{Binding ReportFrom}"/><DatePicker Grid.Column="2" SelectedDate="{Binding ReportTo}"/><ComboBox Grid.Column="4" ItemsSource="{Binding JournalStatuses}" SelectedItem="{Binding JournalStatus}"/><TextBox Grid.Column="6" Text="{Binding JournalSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Documento, referência ou descrição"/><Button Grid.Column="7" Content="Pesquisar" Command="{Binding LoadJournalCommand}" Style="{StaticResource BaseButton}"/><Button Grid.Column="9" Content="Exportar CSV" Command="{Binding ExportJournalCommand}"/></Grid><DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding JournalRows}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="480"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding EntryDate, StringFormat=dd/MM/yyyy}" Width="Auto"/><DataGridTextColumn Header="Documento" Binding="{Binding DocumentNumber}" Width="Auto"/><DataGridTextColumn Header="Conta" Binding="{Binding AccountCode}" Width="Auto"/><DataGridTextColumn Header="Designação" Binding="{Binding AccountName}" Width="*"/><DataGridTextColumn Header="Débito" Binding="{Binding Debit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Crédito" Binding="{Binding Credit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="Auto"/></DataGrid.Columns></DataGrid></StackPanel></TabItem>
   <TabItem Header="Razão"><StackPanel Margin="12"><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedLedgerAccount}" DisplayMemberPath="Name"/><DatePicker Grid.Column="2" SelectedDate="{Binding ReportFrom}"/><DatePicker Grid.Column="4" SelectedDate="{Binding ReportTo}"/><Button Grid.Column="6" Content="Gerar Razão" Command="{Binding LoadLedgerCommand}" Style="{StaticResource BaseButton}"/><Button Grid.Column="8" Content="Exportar CSV" Command="{Binding ExportLedgerCommand}"/></Grid><DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding LedgerRows}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="480"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding EntryDate, StringFormat=dd/MM/yyyy}" Width="Auto"/><DataGridTextColumn Header="Documento" Binding="{Binding DocumentNumber}" Width="Auto"/><DataGridTextColumn Header="Referência" Binding="{Binding Reference}" Width="Auto"/><DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Débito" Binding="{Binding Debit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Crédito" Binding="{Binding Credit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Saldo" Binding="{Binding RunningBalance, StringFormat=N2}" Width="Auto"/></DataGrid.Columns></DataGrid></StackPanel></TabItem>
   <TabItem Header="Balancete"><StackPanel Margin="12"><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DatePicker SelectedDate="{Binding ReportFrom}"/><DatePicker Grid.Column="2" SelectedDate="{Binding ReportTo}"/><Button Grid.Column="4" Content="Gerar Balancete" Command="{Binding LoadTrialBalanceCommand}" Style="{StaticResource BaseButton}"/><Button Grid.Column="6" Content="Exportar CSV" Command="{Binding ExportTrialBalanceCommand}"/></Grid><UniformGrid Columns="4" Margin="0,0,0,12"><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Débitos do período"/><TextBlock Text="{Binding TrialPeriodDebit, StringFormat=N2}" Style="{StaticResource FP.CompanyKpiValue}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Créditos do período"/><TextBlock Text="{Binding TrialPeriodCredit, StringFormat=N2}" Style="{StaticResource FP.CompanyKpiValue}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Saldo final débito"/><TextBlock Text="{Binding TrialClosingDebit, StringFormat=N2}" Style="{StaticResource FP.CompanyKpiValue}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="Saldo final crédito"/><TextBlock Text="{Binding TrialClosingCredit, StringFormat=N2}" Style="{StaticResource FP.CompanyKpiValue}"/></StackPanel></Border></UniformGrid><DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding TrialBalanceRows}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="430"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding AccountCode}" Width="Auto"/><DataGridTextColumn Header="Conta" Binding="{Binding AccountName}" Width="*"/><DataGridTextColumn Header="Inicial D" Binding="{Binding OpeningDebit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Inicial C" Binding="{Binding OpeningCredit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Débitos" Binding="{Binding PeriodDebit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Créditos" Binding="{Binding PeriodCredit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Final D" Binding="{Binding ClosingDebit, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Final C" Binding="{Binding ClosingCredit, StringFormat=N2}" Width="Auto"/></DataGrid.Columns></DataGrid></StackPanel></TabItem>

   <TabItem Header="DRE"><StackPanel Margin="12"><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="8"/><ColumnDefinition Width="130"/><ColumnDefinition Width="18"/><ColumnDefinition Width="130"/><ColumnDefinition Width="8"/><ColumnDefinition Width="130"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Período atual" FontSize="11" Foreground="{DynamicResource FP.TextMuted}"/><DatePicker SelectedDate="{Binding ReportFrom}"/></StackPanel><DatePicker Grid.Column="2" SelectedDate="{Binding ReportTo}" VerticalAlignment="Bottom"/><StackPanel Grid.Column="4"><TextBlock Text="Comparativo" FontSize="11" Foreground="{DynamicResource FP.TextMuted}"/><DatePicker SelectedDate="{Binding PreviousReportFrom}"/></StackPanel><DatePicker Grid.Column="6" SelectedDate="{Binding PreviousReportTo}" VerticalAlignment="Bottom"/><Button Grid.Column="8" Content="Gerar DRE" Command="{Binding LoadIncomeStatementCommand}" Style="{StaticResource BaseButton}" VerticalAlignment="Bottom"/><Button Grid.Column="10" Content="Exportar CSV" Command="{Binding ExportIncomeStatementCommand}" VerticalAlignment="Bottom"/></Grid><UniformGrid Columns="4" Margin="0,0,0,12"><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Receita líquida" Style="{StaticResource FP.CompanyKpiLabel}"/><TextBlock Text="{Binding NetRevenue, StringFormat=N2}" Style="{StaticResource FP.CompanyKpiValue}" Foreground="{DynamicResource TealDarkBrush}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Lucro bruto" Style="{StaticResource FP.CompanyKpiLabel}"/><TextBlock Text="{Binding GrossProfit, StringFormat=N2}" Style="{StaticResource FP.CompanyKpiValue}" Foreground="{DynamicResource TealDarkBrush}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Resultado operacional" Style="{StaticResource FP.CompanyKpiLabel}"/><TextBlock Text="{Binding OperatingResult, StringFormat=N2}" Style="{StaticResource FP.CompanyKpiValue}" Foreground="{DynamicResource TealDarkBrush}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="Resultado líquido" Style="{StaticResource FP.CompanyKpiLabel}"/><TextBlock Text="{Binding NetResult, StringFormat=N2}" Style="{StaticResource FP.CompanyKpiValue}" Foreground="{DynamicResource SucessoBrush}"/><TextBlock Text="{Binding NetMargin, StringFormat='Margem líquida: {0:N1}%'}" FontSize="11" Foreground="{DynamicResource FP.TextMuted}"/></StackPanel></Border></UniformGrid><DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding IncomeStatementRows}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="430"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="Auto"/><DataGridTextColumn Header="Conta" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Grupo" Binding="{Binding LineType}" Width="Auto"/><DataGridTextColumn Header="Período atual" Binding="{Binding CurrentAmount, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Período anterior" Binding="{Binding PreviousAmount, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Variação" Binding="{Binding Variation, StringFormat=N2}" Width="Auto"/></DataGrid.Columns></DataGrid></StackPanel></TabItem>

   <TabItem Header="Balanço Patrimonial"><StackPanel Margin="12"><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Data do balanço" FontSize="11" Foreground="{DynamicResource FP.TextMuted}"/><DatePicker SelectedDate="{Binding ReportTo}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Comparativo" FontSize="11" Foreground="{DynamicResource FP.TextMuted}"/><DatePicker SelectedDate="{Binding PreviousReportTo}"/></StackPanel><Button Grid.Column="4" Content="Gerar Balanço" Command="{Binding LoadBalanceSheetCommand}" Style="{StaticResource BaseButton}" VerticalAlignment="Bottom"/><Button Grid.Column="6" Content="Exportar CSV" Command="{Binding ExportBalanceSheetCommand}" VerticalAlignment="Bottom"/></Grid><UniformGrid Columns="4" Margin="0,0,0,12"><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Total do Ativo" Style="{StaticResource FP.CompanyKpiLabel}"/><TextBlock Text="{Binding BalanceAssets, StringFormat=N2}" Style="{StaticResource FP.CompanyKpiValue}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Total do Passivo" Style="{StaticResource FP.CompanyKpiLabel}"/><TextBlock Text="{Binding BalanceLiabilities, StringFormat=N2}" Style="{StaticResource FP.CompanyKpiValue}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Património Líquido" Style="{StaticResource FP.CompanyKpiLabel}"/><TextBlock Text="{Binding BalanceEquity, StringFormat=N2}" Style="{StaticResource FP.CompanyKpiValue}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="Diferença" Style="{StaticResource FP.CompanyKpiLabel}"/><TextBlock Text="{Binding BalanceDifference, StringFormat=N2}" Style="{StaticResource FP.CompanyKpiValue}"/></StackPanel></Border></UniformGrid><DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding BalanceSheetRows}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="430"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding AccountCode}" Width="Auto"/><DataGridTextColumn Header="Conta" Binding="{Binding AccountName}" Width="*"/><DataGridTextColumn Header="Secção" Binding="{Binding Section}" Width="Auto"/><DataGridTextColumn Header="Atual" Binding="{Binding CurrentAmount, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Comparativo" Binding="{Binding PreviousAmount, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Variação" Binding="{Binding Variation, StringFormat=N2}" Width="Auto"/></DataGrid.Columns></DataGrid></StackPanel></TabItem>

   <TabItem Header="Fluxo de Caixa"><StackPanel Margin="12"><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="8"/><ColumnDefinition Width="150"/><ColumnDefinition Width="16"/><ColumnDefinition Width="160"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DatePicker SelectedDate="{Binding ReportFrom}"/><DatePicker Grid.Column="2" SelectedDate="{Binding ReportTo}"/><ComboBox Grid.Column="4" ItemsSource="{Binding CashFlowMethods}" SelectedItem="{Binding CashFlowMethodSelected}"/><Button Grid.Column="6" Content="Gerar Fluxo" Command="{Binding LoadCashFlowCommand}" Style="{StaticResource BaseButton}"/><Button Grid.Column="8" Content="Exportar CSV" Command="{Binding ExportCashFlowCommand}"/></Grid><UniformGrid Columns="5" Margin="0,0,0,12"><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Saldo inicial" Style="{StaticResource FP.CompanyKpiLabel}"/><TextBlock Text="{Binding CashOpeningBalance, StringFormat=N2}" Style="{StaticResource FP.CompanyKpiValue}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Operacional" Style="{StaticResource FP.CompanyKpiLabel}"/><TextBlock Text="{Binding CashOperatingNet, StringFormat=N2}" Style="{StaticResource FP.CompanyKpiValue}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Investimento" Style="{StaticResource FP.CompanyKpiLabel}"/><TextBlock Text="{Binding CashInvestingNet, StringFormat=N2}" Style="{StaticResource FP.CompanyKpiValue}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Financiamento" Style="{StaticResource FP.CompanyKpiLabel}"/><TextBlock Text="{Binding CashFinancingNet, StringFormat=N2}" Style="{StaticResource FP.CompanyKpiValue}"/></StackPanel></Border><Border Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="Saldo final" Style="{StaticResource FP.CompanyKpiLabel}"/><TextBlock Text="{Binding CashClosingBalance, StringFormat=N2}" Style="{StaticResource FP.CompanyKpiValue}" Foreground="{DynamicResource SucessoBrush}"/></StackPanel></Border></UniformGrid><DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding CashFlowRows}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="430"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="Auto"/><DataGridTextColumn Header="Documento" Binding="{Binding DocumentNumber}" Width="Auto"/><DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Atividade" Binding="{Binding Activity}" Width="Auto"/><DataGridTextColumn Header="Entradas" Binding="{Binding Inflow, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Saídas" Binding="{Binding Outflow, StringFormat=N2}" Width="Auto"/><DataGridTextColumn Header="Líquido" Binding="{Binding NetAmount, StringFormat=N2}" Width="Auto"/></DataGrid.Columns></DataGrid></StackPanel></TabItem>

   <TabItem Header="Regras Automáticas"><StackPanel Margin="12"><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Contabilização automática" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TealDarkBrush}"/><TextBlock Text="Associe cada evento financeiro às contas de débito e crédito do plano de contas." Foreground="{DynamicResource FP.TextMuted}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Guardar regras" Command="{Binding SaveAutomaticRulesCommand}" Style="{StaticResource BaseButton}" Padding="18,8"/></Grid><ItemsControl ItemsSource="{Binding AutomaticRules}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource FP.Card}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding EventName}" FontWeight="SemiBold" Foreground="{DynamicResource TealDarkBrush}"/><TextBlock Text="{Binding EventCode}" FontSize="11" Foreground="{DynamicResource FP.TextMuted}"/><TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource FP.TextMuted}" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Conta de débito" FontWeight="SemiBold" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding DebitAccount}" DisplayMemberPath="Name"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Conta de crédito" FontWeight="SemiBold" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding CreditAccount}" DisplayMemberPath="Name"/></StackPanel><CheckBox Grid.Column="4" Content="Ativa" IsChecked="{Binding Active}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></TabItem>
  </TabControl><TextBlock Text="{Binding Message}" Margin="0,12,0,0" Foreground="{DynamicResource SucessoBrush}" TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer></Grid>
</UserControl>
