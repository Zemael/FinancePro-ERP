<UserControl x:Class="FinancePro.UI.Views.PerfisView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource FP.Page}">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
  <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
   <Grid Margin="26,22,22,26" MaxWidth="1420" HorizontalAlignment="Center">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Administração  ›  Perfis" Foreground="{DynamicResource FP.TextMuted}" FontSize="11"/><TextBlock Text="Perfis de acesso" Foreground="{DynamicResource FP.Text}" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Defina os grupos de acesso utilizados pelos utilizadores do FinancePro." Foreground="{DynamicResource FP.TextMuted}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Atualizar" Command="{Binding PesquisarCommand}" Style="{StaticResource FP.SecondaryButton}" Margin="0,0,10,0"/><Button Content="+  Novo Perfil" Command="{Binding NovoCommand}" Style="{StaticResource FP.PrimaryButton}"/></StackPanel>
    </Grid>
    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="Total de perfis" Foreground="{DynamicResource FP.TextMuted}" FontSize="11"/><TextBlock Text="{Binding Perfis.Count}" Foreground="{DynamicResource FP.Text}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="Perfil selecionado" Foreground="{DynamicResource FP.TextMuted}" FontSize="11"/><TextBlock Text="{Binding Selecionado.Nome, TargetNullValue=—}" Foreground="{DynamicResource FP.Text}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
     <Border Grid.Column="4" Style="{StaticResource FP.KpiCard}"><StackPanel><TextBlock Text="Estado" Foreground="{DynamicResource FP.TextMuted}" FontSize="11"/><TextBlock Text="{Binding Selecionado.Ativo, Converter={StaticResource AtivoParaTextoConverter}, TargetNullValue=—}" Foreground="{DynamicResource FP.Text}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
    </Grid>
    <Border Grid.Row="4" Style="{StaticResource FP.Card}">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Pesquisa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FilterTextBox}" Width="330" HorizontalAlignment="Left" ToolTip="Pesquisar por nome ou descrição"/><Button Grid.Column="1" Content="Pesquisar" Command="{Binding PesquisarCommand}" Style="{StaticResource FP.SecondaryButton}"/></Grid>
      <DataGrid Grid.Row="2" ItemsSource="{Binding Perfis}" SelectedItem="{Binding Selecionado}" Style="{StaticResource FP.DataGrid}" AutoGenerateColumns="False">
       <DataGrid.Columns><DataGridTextColumn Header="Perfil" Binding="{Binding Nome}" Width="Auto"/><DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding Ativo, Converter={StaticResource AtivoParaTextoConverter}}" Width="Auto"/></DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Border>
   </Grid>
  </ScrollViewer>
  <Border Grid.Column="1" Background="{DynamicResource FP.Surface}" BorderBrush="{DynamicResource FP.Border}" BorderThickness="1,0,0,0" Padding="22">
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Detalhes do Perfil" Foreground="{DynamicResource FP.Text}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Crie ou edite um perfil de acesso." Foreground="{DynamicResource FP.TextMuted}" FontSize="11" Margin="0,5,0,20"/>
    <TextBlock Text="Nome do perfil" Foreground="{DynamicResource FP.TextMuted}" FontSize="11"/><TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FilterTextBox}" Margin="0,6,0,14"/>
    <TextBlock Text="Descrição" Foreground="{DynamicResource FP.TextMuted}" FontSize="11"/><TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FilterTextBox}" Height="95" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,18"/>
    <TextBlock Text="{Binding Mensagem}" Foreground="{DynamicResource FP.Accent}" TextWrapping="Wrap" Margin="0,0,0,14"/>
    <Button Content="Guardar Perfil" Command="{Binding GuardarCommand}" Style="{StaticResource FP.PrimaryButton}" Margin="0,0,0,10"/>
    <Button Content="Editar selecionado" Command="{Binding EditarCommand}" Style="{StaticResource FP.SecondaryButton}" Margin="0,0,0,10"/>
    <Button Content="Ativar / Desativar" Command="{Binding AlternarAtivoCommand}" CommandParameter="{Binding Selecionado}" Style="{StaticResource FP.SecondaryButton}"/>
   </StackPanel></ScrollViewer>
  </Border>
 </Grid>
</UserControl>
