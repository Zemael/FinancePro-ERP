<UserControl x:Class="FinancePro.UI.Views.EmpresasView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource FP.Page}">

 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="350"/>
  </Grid.ColumnDefinitions>

  <!-- Conteúdo principal -->
  <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid Margin="26,22,22,26" MaxWidth="1420" HorizontalAlignment="Center">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="18"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="18"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="14"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Cabeçalho -->
    <Grid Grid.Row="0">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="Cadastros Mestres  ›  Empresas" Foreground="{DynamicResource FP.TextMuted}" FontSize="11"/>
      <TextBlock Text="Empresas" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource FP.Text}" Margin="0,8,0,0"/>
      <TextBlock Text="Gerencie as empresas registadas no sistema" Foreground="{DynamicResource FP.TextMuted}" FontSize="12" Margin="0,5,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button Content="+  Nova Empresa" Command="{Binding NovoCommand}" Style="{StaticResource FP.PrimaryButton}" Margin="0,0,10,0"/>
      <Button Content="Exportar" Command="{Binding ExportarCommand}" Style="{StaticResource FP.SecondaryButton}" Margin="0,0,10,0"/>
      <Button Content="&#xE72C;" Command="{Binding PesquisarCommand}" Style="{StaticResource FP.IconButton}" ToolTip="Atualizar"/>
     </StackPanel>
    </Grid>

    <!-- KPIs -->
    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions>
      <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
     </Grid.ColumnDefinitions>
     <Border Grid.Column="0" Style="{StaticResource FP.KpiCard}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" Background="{DynamicResource FP.AccentSoft}" CornerRadius="20"><TextBlock Text="&#xE731;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FP.Accent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Total de Empresas" Foreground="{DynamicResource FP.TextMuted}" FontSize="11"/><TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding Empresas.Count}" Foreground="{DynamicResource FP.Text}" FontSize="14" FontWeight="SemiBold" Margin="0"/><TextBlock Grid.Row="2" VerticalAlignment="Bottom" Text="Registos no sistema" Foreground="{DynamicResource FP.TextMuted}" FontSize="10"/></Grid>
      </Grid>
     </Border>
     <Border Grid.Column="2" Style="{StaticResource FP.KpiCard}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" Background="{DynamicResource AvisoSuaveBrush}" CornerRadius="20"><TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FP.Warning}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Empresa Selecionada" Foreground="{DynamicResource FP.TextMuted}" FontSize="11"/><TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding Selecionada.Nome, TargetNullValue=—}" Foreground="{DynamicResource FP.Accent}" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="2" VerticalAlignment="Bottom" Text="Seleção atual" Foreground="{DynamicResource FP.TextMuted}" FontSize="10"/></Grid>
      </Grid>
     </Border>
     <Border Grid.Column="4" Style="{StaticResource FP.KpiCard}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" Background="{DynamicResource FP.SuccessSoft}" CornerRadius="20"><TextBlock Text="&#xE8C1;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FP.Success}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Moeda Principal" Foreground="{DynamicResource FP.TextMuted}" FontSize="11"/><TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding Selecionada.Moeda, TargetNullValue=FCFA}" Foreground="{DynamicResource FP.Text}" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Grid.Row="2" VerticalAlignment="Bottom" Text="Moeda da empresa" Foreground="{DynamicResource FP.TextMuted}" FontSize="10"/></Grid>
      </Grid>
     </Border>
     <Border Grid.Column="6" Style="{StaticResource FP.KpiCard}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" Background="{DynamicResource RoxoSuaveBrush}" CornerRadius="20"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource RoxoBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Estado" Foreground="{DynamicResource FP.TextMuted}" FontSize="11"/><TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding Selecionada.Ativo, Converter={StaticResource AtivoParaTexto}, TargetNullValue=—}" Foreground="{DynamicResource FP.Text}" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Grid.Row="2" VerticalAlignment="Bottom" Text="Situação do registo" Foreground="{DynamicResource FP.TextMuted}" FontSize="10"/></Grid>
      </Grid>
     </Border>
    </Grid>

    <!-- Filtros -->
    <Border Grid.Row="4" Style="{StaticResource FP.Card}" Padding="16">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="150"/><ColumnDefinition Width="14"/><ColumnDefinition Width="150"/><ColumnDefinition Width="14"/><ColumnDefinition Width="110"/><ColumnDefinition Width="10"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0"><TextBlock Text="Pesquisar" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Pesquisa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FilterTextBox}" ToolTip="Código, nome, NIF ou email"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Estado" Style="{StaticResource FP.FieldLabel}"/><ComboBox Height="40"><ComboBoxItem Content="Todos" IsSelected="True"/><ComboBoxItem Content="Ativas"/><ComboBoxItem Content="Inativas"/></ComboBox></StackPanel>
      <StackPanel Grid.Column="4"><TextBlock Text="Moeda" Style="{StaticResource FP.FieldLabel}"/><ComboBox Height="40"><ComboBoxItem Content="Todas" IsSelected="True"/><ComboBoxItem Content="FCFA"/><ComboBoxItem Content="EUR"/><ComboBoxItem Content="USD"/></ComboBox></StackPanel>
      <Button Grid.Column="6" Content="Pesquisar" Command="{Binding PesquisarCommand}" Style="{StaticResource FP.PrimaryButton}" VerticalAlignment="Bottom"/>
      <Button Grid.Column="8" Content="Limpar" Command="{Binding NovoCommand}" Style="{StaticResource FP.SecondaryButton}" VerticalAlignment="Bottom"/>
     </Grid>
    </Border>

    <!-- Tabela -->
    <Border Grid.Row="6" Style="{StaticResource FP.Card}" Padding="0">
     <Grid>
      <DataGrid ItemsSource="{Binding Empresas}" SelectedItem="{Binding Selecionada}" Style="{StaticResource FP.DataGrid}">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Empresa" Binding="{Binding Nome}" Width="2*"/>
        <DataGridTextColumn Header="NIF" Binding="{Binding NIF}" Width="*"/>
        <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="*"/>
        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*"/>
        <DataGridTextColumn Header="Moeda" Binding="{Binding Moeda}" Width="Auto"/>
        <DataGridTemplateColumn Header="Estado" Width="100">
         <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource FP.StatusActive}" HorizontalAlignment="Left"><TextBlock Text="{Binding Ativo, Converter={StaticResource AtivoParaTexto}}" Foreground="{Binding Ativo, Converter={StaticResource AtivoParaCor}}" FontSize="10" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Ações" Width="120">
         <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource FP.IconButton}" Height="40" Margin="0,0,6,0" ToolTip="Editar"/><Button Content="&#xE8D8;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.AlternarAtivoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}" Height="40" ToolTip="Ativar/Desativar"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Border>
   </Grid>
  </ScrollViewer>

  <!-- Painel lateral -->
  <Border Grid.Column="1" Background="{DynamicResource FundoCartaoBrush}" BorderBrush="{DynamicResource FP.Border}" BorderThickness="1,0,0,0">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="22">
     <TextBlock Text="Detalhes da Empresa" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource FP.Text}"/>
     <Border Height="1" Background="{DynamicResource FP.Border}" Margin="0,18"/>
     <TextBlock Text="Informações gerais" Style="{StaticResource FP.SectionTitle}" Margin="0,0,0,16"/>
     <Grid Width="96" Height="72" HorizontalAlignment="Left" Margin="0,0,0,10">
      <Border Background="{DynamicResource FP.AccentSoft}" CornerRadius="10"><TextBlock Text="&#xE731;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FP.Accent}" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <Border Background="Transparent" CornerRadius="10" BorderBrush="{DynamicResource FP.Border}" BorderThickness="1" Padding="4"><Image Source="{Binding Logotipo, Converter={StaticResource FotoPerfilConverter}}" Stretch="Uniform"/></Border>
     </Grid>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
      <Button Content="Selecionar logótipo" Click="SelecionarLogotipo_Click" Style="{StaticResource FP.SecondaryButton}" Margin="0,0,8,0"/>
      <Button Content="Remover" Click="RemoverLogotipo_Click" Style="{StaticResource FP.SecondaryButton}"/>
     </StackPanel>

     <TextBlock Text="Nome da Empresa" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
     <TextBlock Text="NIF" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding NIF}" Margin="0,0,0,12"/>
     <TextBlock Text="Moeda Principal" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Moeda}" Margin="0,0,0,12"/>
     <TextBlock Text="Telefone" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Telefone}" Margin="0,0,0,12"/>
     <TextBlock Text="Email" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Email}" Margin="0,0,0,12"/>
     <TextBlock Text="Morada" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Morada}" Height="74" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,14"/>

     <Border Background="{DynamicResource FP.AccentSoft}" CornerRadius="8" Padding="10" Margin="0,0,0,14" Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade}}"><TextBlock Text="{Binding Mensagem}" Foreground="{DynamicResource FP.Accent}" TextWrapping="Wrap" FontSize="11"/></Border>
     <Button Content="Guardar Empresa" Command="{Binding GuardarCommand}" Style="{StaticResource FP.PrimaryButton}" HorizontalAlignment="Stretch"/>
     <Button Content="Carregar selecionada" Command="{Binding EditarCommand}" Style="{StaticResource FP.SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>

     <Border Height="1" Background="{DynamicResource FP.Border}" Margin="0,22"/>
     <TextBlock Text="Resumo rápido" Style="{StaticResource FP.SectionTitle}" Margin="0,0,0,12"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource FP.Card}" Padding="12"><StackPanel><TextBlock Text="Moeda" Foreground="{DynamicResource FP.TextMuted}" FontSize="10"/><TextBlock Text="{Binding Selecionada.Moeda, TargetNullValue=—}" Foreground="{DynamicResource FP.Accent}" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource FP.Card}" Padding="12"><StackPanel><TextBlock Text="Estado" Foreground="{DynamicResource FP.TextMuted}" FontSize="10"/><TextBlock Text="{Binding Selecionada.Ativo, Converter={StaticResource AtivoParaTexto}, TargetNullValue=—}" Foreground="{DynamicResource FP.Success}" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
     </Grid>
    </StackPanel>
   </ScrollViewer>
  </Border>
 </Grid>
</UserControl>
