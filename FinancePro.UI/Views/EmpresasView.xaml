<UserControl x:Class="FinancePro.UI.Views.EmpresasView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{StaticResource FP.Page}">

 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="350"/>
  </Grid.ColumnDefinitions>

  <!-- Conteúdo principal -->
  <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid Margin="26,22,22,26" MaxWidth="1420" HorizontalAlignment="Center">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="18"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="18"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="14"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Cabeçalho -->
    <Grid Grid.Row="0">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="Empresas" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource FP.Text}"/>
       <TextBlock Text="  ›  Cadastros Mestres  ›  Empresas" VerticalAlignment="Center" Foreground="{StaticResource FP.TextMuted}" FontSize="12" Margin="10,3,0,0"/>
      </StackPanel>
      <TextBlock Text="Gerencie as empresas registadas no sistema" Foreground="{StaticResource FP.TextMuted}" FontSize="12" Margin="0,5,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button Content="+  Nova Empresa" Command="{Binding NovoCommand}" Style="{StaticResource FP.PrimaryButton}" Margin="0,0,10,0"/>
      <Button Content="Exportar" Style="{StaticResource FP.SecondaryButton}" Margin="0,0,10,0"/>
      <Button Content="&#xE72C;" Command="{Binding PesquisarCommand}" Style="{StaticResource FP.IconButton}" ToolTip="Atualizar"/>
     </StackPanel>
    </Grid>

    <!-- KPIs -->
    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions>
      <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
     </Grid.ColumnDefinitions>
     <Border Grid.Column="0" Style="{StaticResource FP.KpiCard}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" Background="{StaticResource FP.AccentSoft}" CornerRadius="20"><TextBlock Text="&#xE731;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Accent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Total de Empresas" Foreground="{StaticResource FP.TextMuted}" FontSize="11"/><TextBlock Text="{Binding Empresas.Count}" Foreground="{StaticResource FP.Text}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Registos no sistema" Foreground="{StaticResource FP.TextMuted}" FontSize="10"/></StackPanel>
      </Grid>
     </Border>
     <Border Grid.Column="2" Style="{StaticResource FP.KpiCard}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" Background="#FFF4E5" CornerRadius="20"><TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Warning}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Empresa Selecionada" Foreground="{StaticResource FP.TextMuted}" FontSize="11"/><TextBlock Text="{Binding Selecionada.Nome, TargetNullValue=—}" Foreground="{StaticResource FP.Accent}" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="Seleção atual" Foreground="{StaticResource FP.TextMuted}" FontSize="10"/></StackPanel>
      </Grid>
     </Border>
     <Border Grid.Column="4" Style="{StaticResource FP.KpiCard}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" Background="{StaticResource FP.SuccessSoft}" CornerRadius="20"><TextBlock Text="&#xE8C1;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Success}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Moeda Principal" Foreground="{StaticResource FP.TextMuted}" FontSize="11"/><TextBlock Text="{Binding Selecionada.Moeda, TargetNullValue=FCFA}" Foreground="{StaticResource FP.Text}" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Moeda da empresa" Foreground="{StaticResource FP.TextMuted}" FontSize="10"/></StackPanel>
      </Grid>
     </Border>
     <Border Grid.Column="6" Style="{StaticResource FP.KpiCard}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="40" Height="40" Background="#F1EAFE" CornerRadius="20"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="#7C3AED" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Estado" Foreground="{StaticResource FP.TextMuted}" FontSize="11"/><TextBlock Text="{Binding Selecionada.Ativo, Converter={StaticResource AtivoParaTexto}, TargetNullValue=—}" Foreground="{StaticResource FP.Text}" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Situação do registo" Foreground="{StaticResource FP.TextMuted}" FontSize="10"/></StackPanel>
      </Grid>
     </Border>
    </Grid>

    <!-- Filtros -->
    <Border Grid.Row="4" Style="{StaticResource FP.Card}" Padding="16">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="150"/><ColumnDefinition Width="14"/><ColumnDefinition Width="150"/><ColumnDefinition Width="14"/><ColumnDefinition Width="110"/><ColumnDefinition Width="10"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0"><TextBlock Text="Pesquisar" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Pesquisa, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FP.FilterTextBox}" ToolTip="Código, nome, NIF ou email"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Estado" Style="{StaticResource FP.FieldLabel}"/><ComboBox Height="40"><ComboBoxItem Content="Todos" IsSelected="True"/><ComboBoxItem Content="Ativas"/><ComboBoxItem Content="Inativas"/></ComboBox></StackPanel>
      <StackPanel Grid.Column="4"><TextBlock Text="Moeda" Style="{StaticResource FP.FieldLabel}"/><ComboBox Height="40"><ComboBoxItem Content="Todas" IsSelected="True"/><ComboBoxItem Content="FCFA"/><ComboBoxItem Content="EUR"/><ComboBoxItem Content="USD"/></ComboBox></StackPanel>
      <Button Grid.Column="6" Content="Pesquisar" Command="{Binding PesquisarCommand}" Style="{StaticResource FP.PrimaryButton}" VerticalAlignment="Bottom"/>
      <Button Grid.Column="8" Content="Limpar" Command="{Binding NovoCommand}" Style="{StaticResource FP.SecondaryButton}" VerticalAlignment="Bottom"/>
     </Grid>
    </Border>

    <!-- Tabela -->
    <Border Grid.Row="6" Style="{StaticResource FP.Card}" Padding="0">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
      <DataGrid Grid.Row="0" ItemsSource="{Binding Empresas}" SelectedItem="{Binding Selecionada}" Style="{StaticResource FP.DataGrid}">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Empresa" Binding="{Binding Nome}" Width="2*"/>
        <DataGridTextColumn Header="NIF" Binding="{Binding NIF}" Width="*"/>
        <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="*"/>
        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*"/>
        <DataGridTextColumn Header="Moeda" Binding="{Binding Moeda}" Width="90"/>
        <DataGridTemplateColumn Header="Estado" Width="100">
         <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource FP.StatusActive}" HorizontalAlignment="Left"><TextBlock Text="{Binding Ativo, Converter={StaticResource AtivoParaTexto}}" Foreground="{Binding Ativo, Converter={StaticResource AtivoParaCor}}" FontSize="10" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Ações" Width="120">
         <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource FP.IconButton}" Width="34" Height="40" Margin="0,0,6,0" ToolTip="Editar"/><Button Content="&#xE8D8;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.AlternarAtivoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource FP.IconButton}" Width="34" Height="40" ToolTip="Ativar/Desativar"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
      <Grid Grid.Row="1" Margin="14,0"><TextBlock Text="Registos carregados" Foreground="{StaticResource FP.TextMuted}" FontSize="10" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="‹" Style="{StaticResource FP.SecondaryButton}" Width="34" Height="40" Padding="0"/><Border Background="{StaticResource FP.Accent}" CornerRadius="5" Margin="6,0" Width="34" Height="30"><TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Button Content="›" Style="{StaticResource FP.SecondaryButton}" Width="34" Height="40" Padding="0"/></StackPanel></Grid>
     </Grid>
    </Border>
   </Grid>
  </ScrollViewer>

  <!-- Painel lateral -->
  <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource FP.Border}" BorderThickness="1,0,0,0">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="22">
     <Grid><TextBlock Text="Detalhes da Empresa" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource FP.Text}"/><Button Content="&#xE711;" HorizontalAlignment="Right" Style="{StaticResource FP.IconButton}" Width="34" Height="40"/></Grid>
     <Border Height="1" Background="{StaticResource FP.Border}" Margin="0,18"/>
     <TextBlock Text="Informações gerais" Style="{StaticResource FP.SectionTitle}" Margin="0,0,0,16"/>
     <Border Width="72" Height="72" Background="{StaticResource FP.AccentSoft}" CornerRadius="36" HorizontalAlignment="Left" Margin="0,0,0,16"><TextBlock Text="&#xE731;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource FP.Accent}" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>

     <TextBlock Text="Nome da Empresa" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
     <TextBlock Text="NIF" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding NIF}" Margin="0,0,0,12"/>
     <TextBlock Text="Moeda Principal" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Moeda}" Margin="0,0,0,12"/>
     <TextBlock Text="Telefone" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Telefone}" Margin="0,0,0,12"/>
     <TextBlock Text="Email" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Email}" Margin="0,0,0,12"/>
     <TextBlock Text="Morada" Style="{StaticResource FP.FieldLabel}"/><TextBox Text="{Binding Morada}" Height="74" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,14"/>

     <Border Background="{StaticResource FP.AccentSoft}" CornerRadius="8" Padding="10" Margin="0,0,0,14" Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade}}"><TextBlock Text="{Binding Mensagem}" Foreground="{StaticResource FP.Accent}" TextWrapping="Wrap" FontSize="11"/></Border>
     <Button Content="Guardar Empresa" Command="{Binding GuardarCommand}" Style="{StaticResource FP.PrimaryButton}" HorizontalAlignment="Stretch"/>
     <Button Content="Carregar selecionada" Command="{Binding EditarCommand}" Style="{StaticResource FP.SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>

     <Border Height="1" Background="{StaticResource FP.Border}" Margin="0,22"/>
     <TextBlock Text="Resumo rápido" Style="{StaticResource FP.SectionTitle}" Margin="0,0,0,12"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource FP.Card}" Padding="12"><StackPanel><TextBlock Text="Moeda" Foreground="{StaticResource FP.TextMuted}" FontSize="10"/><TextBlock Text="{Binding Selecionada.Moeda, TargetNullValue=—}" Foreground="{StaticResource FP.Accent}" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource FP.Card}" Padding="12"><StackPanel><TextBlock Text="Estado" Foreground="{StaticResource FP.TextMuted}" FontSize="10"/><TextBlock Text="{Binding Selecionada.Ativo, Converter={StaticResource AtivoParaTexto}, TargetNullValue=—}" Foreground="{StaticResource FP.Success}" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
     </Grid>
    </StackPanel>
   </ScrollViewer>
  </Border>
 </Grid>
</UserControl>
