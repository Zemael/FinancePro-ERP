<UserControl x:Class="FinancePro.UI.Views.HumanResourcesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource FundoPrincipalBrush}">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="Financeiro / RH Financeiro" FontSize="11" Foreground="{DynamicResource GrayTextBrush}" Margin="0,0,0,2"/><TextBlock Text="RH Financeiro" Style="{StaticResource TituloModulo}" Margin="0"/><TextBlock Text="Colaboradores, contratos, remunerações e custo mensal" Style="{StaticResource TextoSecundario}" Margin="0,4,0,0"/></StackPanel><Button HorizontalAlignment="Right" Style="{StaticResource FP.SecondaryButton}" Content="Atualizar" Command="{Binding RefreshCommand}"/></Grid>
  <UniformGrid Columns="4" Margin="0,0,0,16">
   <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource FP.AccentSoft}"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FP.Accent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Colaboradores Ativos" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding ActiveEmployees}" Style="{StaticResource FP.CompanyKpiValue}" TextWrapping="NoWrap"/></Viewbox></Grid></Grid></Border>
   <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource SucessoSuaveBrush}"><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SucessoBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Salários-base" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding TotalBaseSalary, StringFormat={}{0:N0} FCFA}" Style="{StaticResource FP.CompanyKpiValue}" TextWrapping="NoWrap"/></Viewbox></Grid></Grid></Border>
   <Border Style="{StaticResource FP.KpiCard}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource AvisoSuaveBrush}"><TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FP.Warning}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Subsídios" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding TotalAllowances, StringFormat={}{0:N0} FCFA}" Style="{StaticResource FP.CompanyKpiValue}" TextWrapping="NoWrap"/></Viewbox></Grid></Grid></Border>
   <Border Style="{StaticResource FP.KpiCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource FP.CompanyKpiIcon}" Background="{DynamicResource RoxoSuaveBrush}"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource RoxoBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid Grid.Column="1" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" VerticalAlignment="Top" Text="Líquido Mensal" Style="{StaticResource FP.CompanyKpiLabel}"/><Viewbox Grid.Row="1" VerticalAlignment="Center" StretchDirection="DownOnly" MaxWidth="160" HorizontalAlignment="Left"><TextBlock Text="{Binding NetMonthlyPayroll, StringFormat={}{0:N0} FCFA}" Style="{StaticResource FP.CompanyKpiValue}" TextWrapping="NoWrap"/></Viewbox></Grid></Grid></Border>
  </UniformGrid>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Cadastro financeiro do colaborador" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <UniformGrid Columns="5"><StackPanel Margin="0,0,10,8"><TextBlock Text="Número *"/><TextBox Text="{Binding EmployeeNumber}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Nome completo *"/><TextBox Text="{Binding FullName}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="NIF"/><TextBox Text="{Binding TaxId}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Segurança Social"/><TextBox Text="{Binding SocialSecurityNumber}"/></StackPanel><StackPanel><TextBlock Text="Estado"/><ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}"/></StackPanel></UniformGrid>
   <UniformGrid Columns="5"><StackPanel Margin="0,0,10,8"><TextBlock Text="Departamento *"/><TextBox Text="{Binding Department}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Centro de custo"/><TextBox Text="{Binding CostCenter}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Função *"/><TextBox Text="{Binding JobTitle}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Contrato"/><ComboBox ItemsSource="{Binding ContractTypes}" SelectedItem="{Binding ContractType}"/></StackPanel><StackPanel><TextBlock Text="Admissão"/><DatePicker SelectedDate="{Binding HireDate}"/></StackPanel></UniformGrid>
   <UniformGrid Columns="5"><StackPanel Margin="0,0,10,8"><TextBlock Text="Fim do contrato"/><DatePicker SelectedDate="{Binding EndDate}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Salário-base"/><TextBox Text="{Binding BaseSalary}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Subsídios"/><TextBox Text="{Binding Allowances}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Descontos"/><TextBox Text="{Binding Deductions}"/></StackPanel><StackPanel><TextBlock Text="Banco"/><TextBox Text="{Binding BankName}"/></StackPanel></UniformGrid>
   <UniformGrid Columns="2"><StackPanel Margin="0,0,10,8"><TextBlock Text="IBAN/Conta bancária"/><TextBox Text="{Binding Iban}"/></StackPanel><StackPanel><TextBlock Text="Notas"/><TextBox Text="{Binding Notes}"/></StackPanel></UniformGrid>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button Content="Novo" Command="{Binding NewCommand}" Margin="0,0,8,0"/><Button Content="Guardar" Command="{Binding SaveCommand}" Margin="0,0,8,0"/><Button Content="Arquivar" Command="{Binding ArchiveCommand}"/></StackPanel>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Folha salarial mensal" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <UniformGrid Columns="3"><StackPanel Margin="0,0,10,8"><TextBlock Text="Ano"/><TextBox Text="{Binding PayrollYear}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Mês (1-12)"/><TextBox Text="{Binding PayrollMonth}"/></StackPanel><StackPanel><TextBlock Text="Notas"/><TextBox Text="{Binding PayrollNotes}"/></StackPanel></UniformGrid>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,8"><Button Content="Gerar folha" Command="{Binding GeneratePayrollCommand}" Margin="0,0,8,0"/><Button Content="Aprovar folha" Command="{Binding ApprovePayrollCommand}"/></StackPanel>
   <DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding PayrollRuns}" SelectedItem="{Binding SelectedPayroll}" AutoGenerateColumns="False" IsReadOnly="True" Height="150"><DataGrid.Columns><DataGridTextColumn Header="Período" Binding="{Binding Period}"/><DataGridTextColumn Header="Colaboradores" Binding="{Binding EmployeeCount}"/><DataGridTextColumn Header="Bruto" Binding="{Binding GrossAmount, StringFormat=N0}"/><DataGridTextColumn Header="Descontos" Binding="{Binding Deductions, StringFormat=N0}"/><DataGridTextColumn Header="Líquido" Binding="{Binding NetAmount, StringFormat=N0}"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}"/><DataGridTextColumn Header="Gerada em" Binding="{Binding GeneratedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="*"/></DataGrid.Columns></DataGrid>
   <TextBlock Text="Detalhe da folha selecionada" FontWeight="SemiBold" Margin="0,12,0,8"/>
   <DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding PayrollLines}" SelectedItem="{Binding SelectedPayrollLine}" AutoGenerateColumns="False" IsReadOnly="True" Height="230"><DataGrid.Columns><DataGridTextColumn Header="Número" Binding="{Binding EmployeeNumber}"/><DataGridTextColumn Header="Colaborador" Binding="{Binding EmployeeName}" Width="*"/><DataGridTextColumn Header="Departamento" Binding="{Binding Department}"/><DataGridTextColumn Header="Base" Binding="{Binding BaseSalary, StringFormat=N0}"/><DataGridTextColumn Header="Subsídios" Binding="{Binding Allowances, StringFormat=N0}"/><DataGridTextColumn Header="Bruto" Binding="{Binding GrossAmount, StringFormat=N0}"/><DataGridTextColumn Header="Imposto" Binding="{Binding IncomeTax, StringFormat=N0}"/><DataGridTextColumn Header="S. Social" Binding="{Binding EmployeeSocialSecurity, StringFormat=N0}"/><DataGridTextColumn Header="Empréstimos" Binding="{Binding LoanDeduction, StringFormat=N0}"/><DataGridTextColumn Header="Encargo patronal" Binding="{Binding EmployerSocialSecurity, StringFormat=N0}"/><DataGridTextColumn Header="Descontos" Binding="{Binding Deductions, StringFormat=N0}"/><DataGridTextColumn Header="Líquido" Binding="{Binding NetAmount, StringFormat=N0}"/><DataGridTextColumn Header="Pagamento" Binding="{Binding PaymentStatus}"/><DataGridTextColumn Header="Data" Binding="{Binding PaymentDate, StringFormat=dd/MM/yyyy}"/><DataGridTextColumn Header="Referência" Binding="{Binding PaymentReference}"/></DataGrid.Columns></DataGrid>
   <UniformGrid Columns="3" Margin="0,12,0,8"><StackPanel Margin="0,0,10,0"><TextBlock Text="Data do pagamento"/><DatePicker SelectedDate="{Binding PaymentDate}"/></StackPanel><StackPanel Margin="0,0,10,0"><TextBlock Text="Referência bancária *"/><TextBox Text="{Binding PaymentReference}"/></StackPanel><StackPanel><TextBlock Text="Notas"/><TextBox Text="{Binding PaymentNotes}"/></StackPanel></UniformGrid>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Pagar selecionado" Command="{Binding RegisterPaymentCommand}" Margin="0,0,8,0"/><Button Content="Pagar folha completa" Command="{Binding PayEntirePayrollCommand}"/></StackPanel>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Pesquisar colaboradores"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/><DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding Employees}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" Height="390"><DataGrid.Columns><DataGridTextColumn Header="Número" Binding="{Binding EmployeeNumber}"/><DataGridTextColumn Header="Colaborador" Binding="{Binding FullName}" Width="*"/><DataGridTextColumn Header="Departamento" Binding="{Binding Department}"/><DataGridTextColumn Header="Função" Binding="{Binding JobTitle}"/><DataGridTextColumn Header="Contrato" Binding="{Binding ContractType}"/><DataGridTextColumn Header="Salário-base" Binding="{Binding BaseSalary, StringFormat=N0}"/><DataGridTextColumn Header="Subsídios" Binding="{Binding Allowances, StringFormat=N0}"/><DataGridTextColumn Header="Descontos" Binding="{Binding Deductions, StringFormat=N0}"/><DataGridTextColumn Header="Líquido" Binding="{Binding NetMonthly, StringFormat=N0}"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}"/></DataGrid.Columns></DataGrid><TextBlock Text="{Binding Message}" Foreground="{DynamicResource AvisoBrush}" Margin="0,10,0,0"/></StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Componentes remuneratórios do colaborador selecionado" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <UniformGrid Columns="5"><StackPanel Margin="0,0,10,8"><TextBlock Text="Tipo"/><ComboBox ItemsSource="{Binding AdjustmentTypes}" SelectedItem="{Binding AdjustmentType}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Categoria"/><ComboBox ItemsSource="{Binding AdjustmentCategories}" SelectedItem="{Binding AdjustmentCategory}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Descrição *"/><TextBox Text="{Binding AdjustmentDescription}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Valor"/><TextBox Text="{Binding AdjustmentAmount}"/></StackPanel><StackPanel><TextBlock Text="Recorrente"/><CheckBox IsChecked="{Binding AdjustmentRecurring}" Margin="0,10,0,0"/></StackPanel></UniformGrid>
   <UniformGrid Columns="3"><StackPanel Margin="0,0,10,8"><TextBlock Text="Início"/><DatePicker SelectedDate="{Binding AdjustmentStartDate}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Fim"/><DatePicker SelectedDate="{Binding AdjustmentEndDate}"/></StackPanel><StackPanel><TextBlock Text="Notas"/><TextBox Text="{Binding AdjustmentNotes}"/></StackPanel></UniformGrid>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Novo" Command="{Binding NewAdjustmentCommand}" Margin="0,0,8,0"/><Button Content="Guardar" Command="{Binding SaveAdjustmentCommand}" Margin="0,0,8,0"/><Button Content="Arquivar" Command="{Binding ArchiveAdjustmentCommand}"/></StackPanel>
   <DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding Adjustments}" SelectedItem="{Binding SelectedAdjustment}" AutoGenerateColumns="False" IsReadOnly="True" Height="220" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Tipo" Binding="{Binding AdjustmentType}"/><DataGridTextColumn Header="Categoria" Binding="{Binding Category}"/><DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Valor" Binding="{Binding Amount, StringFormat=N0}"/><DataGridTextColumn Header="Início" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}"/><DataGridTextColumn Header="Fim" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}"/><DataGridCheckBoxColumn ElementStyle="{StaticResource FP.DataGridCheckBox}" EditingElementStyle="{StaticResource FP.DataGridCheckBox}" Header="Recorrente" Binding="{Binding Recurring}"/></DataGrid.Columns></DataGrid>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Férias, licenças e faltas do colaborador selecionado" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <UniformGrid Columns="5"><StackPanel Margin="0,0,10,8"><TextBlock Text="Tipo"/><ComboBox ItemsSource="{Binding AbsenceTypes}" SelectedItem="{Binding AbsenceType}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Início"/><DatePicker SelectedDate="{Binding AbsenceStartDate}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Fim"/><DatePicker SelectedDate="{Binding AbsenceEndDate}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Dias"/><TextBox Text="{Binding AbsenceDays}"/></StackPanel><StackPanel><TextBlock Text="Remunerada"/><CheckBox IsChecked="{Binding AbsencePaid}" Margin="0,10,0,0"/></StackPanel></UniformGrid>
   <UniformGrid Columns="3"><StackPanel Margin="0,0,10,8"><TextBlock Text="Desconto na folha"/><TextBox Text="{Binding AbsenceDeduction}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Motivo *"/><TextBox Text="{Binding AbsenceReason}"/></StackPanel><StackPanel><TextBlock Text="Notas"/><TextBox Text="{Binding AbsenceNotes}"/></StackPanel></UniformGrid>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Novo" Command="{Binding NewAbsenceCommand}" Margin="0,0,8,0"/><Button Content="Guardar" Command="{Binding SaveAbsenceCommand}" Margin="0,0,8,0"/><Button Content="Aprovar" Command="{Binding ApproveAbsenceCommand}" Margin="0,0,8,0"/><Button Content="Rejeitar" Command="{Binding RejectAbsenceCommand}" Margin="0,0,8,0"/><Button Content="Arquivar" Command="{Binding ArchiveAbsenceCommand}"/></StackPanel>
   <DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding Absences}" SelectedItem="{Binding SelectedAbsence}" AutoGenerateColumns="False" IsReadOnly="True" Height="230" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Tipo" Binding="{Binding AbsenceType}"/><DataGridTextColumn Header="Início" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}"/><DataGridTextColumn Header="Fim" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}"/><DataGridTextColumn Header="Dias" Binding="{Binding Days, StringFormat=N1}"/><DataGridCheckBoxColumn ElementStyle="{StaticResource FP.DataGridCheckBox}" EditingElementStyle="{StaticResource FP.DataGridCheckBox}" Header="Remunerada" Binding="{Binding Paid}"/><DataGridTextColumn Header="Desconto" Binding="{Binding DeductionAmount, StringFormat=N0}"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}"/><DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Assiduidade e horas extraordinárias" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <UniformGrid Columns="6"><StackPanel Margin="0,0,10,8"><TextBlock Text="Data"/><DatePicker SelectedDate="{Binding AttendanceDate}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Entrada"/><TextBox Text="{Binding EntryTime}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Saída"/><TextBox Text="{Binding ExitTime}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Horas normais"/><TextBox Text="{Binding RegularHours}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Horas extra"/><TextBox Text="{Binding OvertimeHours}"/></StackPanel><StackPanel><TextBlock Text="Valor extra"/><TextBox Text="{Binding OvertimeAmount}"/></StackPanel></UniformGrid>
   <StackPanel Margin="0,0,0,8"><TextBlock Text="Notas"/><TextBox Text="{Binding AttendanceNotes}"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Novo" Command="{Binding NewAttendanceCommand}" Margin="0,0,8,0"/><Button Content="Guardar" Command="{Binding SaveAttendanceCommand}" Margin="0,0,8,0"/><Button Content="Aprovar" Command="{Binding ApproveAttendanceCommand}" Margin="0,0,8,0"/><Button Content="Rejeitar" Command="{Binding RejectAttendanceCommand}" Margin="0,0,8,0"/><Button Content="Arquivar" Command="{Binding ArchiveAttendanceCommand}"/></StackPanel>
   <DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding Attendance}" SelectedItem="{Binding SelectedAttendance}" AutoGenerateColumns="False" IsReadOnly="True" Height="230" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding WorkDate, StringFormat=dd/MM/yyyy}"/><DataGridTextColumn Header="Entrada" Binding="{Binding EntryTime}"/><DataGridTextColumn Header="Saída" Binding="{Binding ExitTime}"/><DataGridTextColumn Header="Normais" Binding="{Binding RegularHours, StringFormat=N2}"/><DataGridTextColumn Header="Extra" Binding="{Binding OvertimeHours, StringFormat=N2}"/><DataGridTextColumn Header="Valor extra" Binding="{Binding OvertimeAmount, StringFormat=N0}"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}"/><DataGridTextColumn Header="Notas" Binding="{Binding Notes}" Width="*"/></DataGrid.Columns></DataGrid>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Saldo anual de férias" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <UniformGrid Columns="4"><StackPanel Margin="0,0,10,8"><TextBlock Text="Ano"/><TextBox Text="{Binding LeaveYear}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Direito anual"/><TextBox Text="{Binding EntitledDays}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Saldo transitado"/><TextBox Text="{Binding CarriedDays}"/></StackPanel><StackPanel><TextBlock Text="Notas"/><TextBox Text="{Binding LeaveNotes}"/></StackPanel></UniformGrid>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Novo" Command="{Binding NewLeaveBalanceCommand}" Margin="0,0,8,0"/><Button Content="Guardar" Command="{Binding SaveLeaveBalanceCommand}" Margin="0,0,8,0"/><Button Content="Arquivar" Command="{Binding ArchiveLeaveBalanceCommand}"/></StackPanel>
   <DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding LeaveBalances}" SelectedItem="{Binding SelectedLeaveBalance}" AutoGenerateColumns="False" IsReadOnly="True" Height="200" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Ano" Binding="{Binding LeaveYear}"/><DataGridTextColumn Header="Direito" Binding="{Binding EntitledDays, StringFormat=N1}"/><DataGridTextColumn Header="Transitado" Binding="{Binding CarriedDays, StringFormat=N1}"/><DataGridTextColumn Header="Utilizado" Binding="{Binding TakenDays, StringFormat=N1}"/><DataGridTextColumn Header="Disponível" Binding="{Binding AvailableDays, StringFormat=N1}"/><DataGridTextColumn Header="Notas" Binding="{Binding Notes}" Width="*"/></DataGrid.Columns></DataGrid>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Regras de imposto e Segurança Social" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <UniformGrid Columns="5"><StackPanel Margin="0,0,10,8"><TextBlock Text="Tipo"/><ComboBox ItemsSource="{Binding PayrollRuleTypes}" SelectedItem="{Binding PayrollRuleType}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Nome *"/><TextBox Text="{Binding PayrollRuleName}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Taxa (%)"/><TextBox Text="{Binding PayrollRuleRate}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Valor fixo"/><TextBox Text="{Binding PayrollRuleFixedAmount}"/></StackPanel><StackPanel><TextBlock Text="Base mínima"/><TextBox Text="{Binding PayrollRuleMinimumBase}"/></StackPanel></UniformGrid>
   <UniformGrid Columns="4"><StackPanel Margin="0,0,10,8"><TextBlock Text="Base máxima"/><TextBox Text="{Binding PayrollRuleMaximumBase}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Início da vigência"/><DatePicker SelectedDate="{Binding PayrollRuleStartDate}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Fim da vigência"/><DatePicker SelectedDate="{Binding PayrollRuleEndDate}"/></StackPanel><StackPanel><TextBlock Text="Notas"/><TextBox Text="{Binding PayrollRuleNotes}"/></StackPanel></UniformGrid>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Novo" Command="{Binding NewPayrollRuleCommand}" Margin="0,0,8,0"/><Button Content="Guardar" Command="{Binding SavePayrollRuleCommand}" Margin="0,0,8,0"/><Button Content="Arquivar" Command="{Binding ArchivePayrollRuleCommand}"/></StackPanel>
   <DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding PayrollRules}" SelectedItem="{Binding SelectedPayrollRule}" AutoGenerateColumns="False" IsReadOnly="True" Height="230" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Tipo" Binding="{Binding RuleType}"/><DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Taxa (%)" Binding="{Binding Rate, StringFormat=N2}"/><DataGridTextColumn Header="Fixo" Binding="{Binding FixedAmount, StringFormat=N0}"/><DataGridTextColumn Header="Base mínima" Binding="{Binding MinimumBase, StringFormat=N0}"/><DataGridTextColumn Header="Base máxima" Binding="{Binding MaximumBase, StringFormat=N0}"/><DataGridTextColumn Header="Início" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}"/><DataGridTextColumn Header="Fim" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}"/></DataGrid.Columns></DataGrid>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Adiantamentos e empréstimos do colaborador selecionado" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <UniformGrid Columns="5"><StackPanel Margin="0,0,10,8"><TextBlock Text="Tipo"/><ComboBox ItemsSource="{Binding LoanTypes}" SelectedItem="{Binding LoanType}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Referência"/><TextBox Text="{Binding LoanReference}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Concessão"/><DatePicker SelectedDate="{Binding LoanGrantedDate}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Valor original"/><TextBox Text="{Binding LoanOriginalAmount}"/></StackPanel><StackPanel><TextBlock Text="Saldo devedor"/><TextBox Text="{Binding LoanOutstandingBalance}"/></StackPanel></UniformGrid>
   <UniformGrid Columns="3"><StackPanel Margin="0,0,10,8"><TextBlock Text="Prestação mensal"/><TextBox Text="{Binding LoanInstallmentAmount}"/></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Primeira dedução"/><DatePicker SelectedDate="{Binding LoanFirstDeductionDate}"/></StackPanel><StackPanel><TextBlock Text="Notas"/><TextBox Text="{Binding LoanNotes}"/></StackPanel></UniformGrid>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Novo" Command="{Binding NewLoanCommand}" Margin="0,0,8,0"/><Button Content="Guardar" Command="{Binding SaveLoanCommand}" Margin="0,0,8,0"/><Button Content="Ativar" Command="{Binding ActivateLoanCommand}" Margin="0,0,8,0"/><Button Content="Suspender" Command="{Binding SuspendLoanCommand}" Margin="0,0,8,0"/><Button Content="Arquivar" Command="{Binding ArchiveLoanCommand}"/></StackPanel>
   <DataGrid Style="{StaticResource FP.DataGrid}" ItemsSource="{Binding EmployeeLoans}" SelectedItem="{Binding SelectedLoan}" AutoGenerateColumns="False" IsReadOnly="True" Height="230" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Tipo" Binding="{Binding LoanType}"/><DataGridTextColumn Header="Referência" Binding="{Binding Reference}"/><DataGridTextColumn Header="Concessão" Binding="{Binding GrantedDate, StringFormat=dd/MM/yyyy}"/><DataGridTextColumn Header="Original" Binding="{Binding OriginalAmount, StringFormat=N0}"/><DataGridTextColumn Header="Saldo" Binding="{Binding OutstandingBalance, StringFormat=N0}"/><DataGridTextColumn Header="Prestação" Binding="{Binding InstallmentAmount, StringFormat=N0}"/><DataGridTextColumn Header="Primeira dedução" Binding="{Binding FirstDeductionDate, StringFormat=dd/MM/yyyy}"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}"/><DataGridTextColumn Header="Notas" Binding="{Binding Notes}" Width="*"/></DataGrid.Columns></DataGrid>
  </StackPanel></Border>
