<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- FinancePro Design System v1.0 -->
    <SolidColorBrush x:Key="FP.Primary" Color="#0B3B74"/>
    <SolidColorBrush x:Key="FP.PrimaryHover" Color="#124F91"/>
    <SolidColorBrush x:Key="FP.Accent" Color="#2F6FED"/>
    <SolidColorBrush x:Key="FP.AccentSoft" Color="#EAF1FF"/>
    <SolidColorBrush x:Key="FP.Page" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="FP.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FP.Border" Color="#DCE5EF"/>
    <SolidColorBrush x:Key="FP.Text" Color="#10233F"/>
    <SolidColorBrush x:Key="FP.TextMuted" Color="#64748B"/>
    <SolidColorBrush x:Key="FP.Success" Color="#159B62"/>
    <SolidColorBrush x:Key="FP.SuccessSoft" Color="#E8F8F0"/>
    <SolidColorBrush x:Key="FP.Danger" Color="#DC3C4B"/>
    <SolidColorBrush x:Key="FP.DangerSoft" Color="#FDECEF"/>
    <SolidColorBrush x:Key="FP.Warning" Color="#F59E0B"/>

    <Style x:Key="FP.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FP.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FP.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18"/>
    </Style>

    <Style x:Key="FP.PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource FP.Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="Height" Value="40"/>
    </Style>

    <Style x:Key="FP.SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource FP.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FP.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Height" Value="40"/>
    </Style>

    <Style x:Key="FP.IconButton" TargetType="Button" BasedOn="{StaticResource FP.SecondaryButton}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="FP.KpiCard" TargetType="Border" BasedOn="{StaticResource FP.Card}">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="MinHeight" Value="104"/>
    </Style>

    <Style x:Key="FP.FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FP.Text}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <Style x:Key="FP.SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FP.Text}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="FP.StatusActive" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FP.SuccessSoft}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="9,4"/>
    </Style>

    <Style x:Key="FP.FilterTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource FP.Border}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="FP.DataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F6"/>
        <Setter Property="RowHeight" Value="52"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
    </Style>


    <!-- Compatibilidade visual global usada pelas Views existentes -->
    <SolidColorBrush x:Key="FundoJanelaBrush" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="TextoSecundarioBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="AzulPrimarioBrush" Color="#2F6FED"/>

    <Style x:Key="TituloModulo" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FP.Text}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,4,0,4"/>
    </Style>

    <Style x:Key="TextoSecundario" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FP.TextMuted}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="Rotulo" TargetType="TextBlock" BasedOn="{StaticResource FP.FieldLabel}"/>
    <Style x:Key="Cartao" TargetType="Border" BasedOn="{StaticResource FP.Card}"/>
    <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource FP.PrimaryButton}"/>
    <Style x:Key="BotaoSecundario" TargetType="Button" BasedOn="{StaticResource FP.SecondaryButton}"/>

    <Style x:Key="FP.FilterComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D1DCE8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

</ResourceDictionary>
