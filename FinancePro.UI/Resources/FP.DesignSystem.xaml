<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:FinancePro.UI.Common">

    <!-- FinancePro Design System v2.0 — as cores (FP.Primary, FP.Surface, etc.)
         vêm de Theme.Light.xaml / Theme.Dark.xaml. Aqui só ficam os estilos,
         todos em DynamicResource para reagir à troca de tema. -->

    <Style x:Key="FP.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FP.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18"/>
    </Style>

    <!-- Alias global para Views modulares que utilizam a chave histórica Card. -->
    <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource FP.Card}"/>

    <Style x:Key="FP.PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="Height" Value="40"/>
    </Style>

    <Style x:Key="FP.SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{DynamicResource FP.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Height" Value="40"/>
    </Style>

    <Style x:Key="BotaoLink" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>

    <Style x:Key="FP.IconButton" TargetType="Button" BasedOn="{StaticResource FP.SecondaryButton}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="FP.KpiCard" TargetType="Border" BasedOn="{StaticResource FP.Card}">
        <Setter Property="Padding" Value="12"/>
        <Setter Property="MinHeight" Value="104"/>
    </Style>

    <!-- Anatomia visual dos KPI baseada no ecrã Empresas. -->
    <Style x:Key="FP.CompanyKpiIcon" TargetType="Border">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FP.CompanyKpiLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FP.TextMuted}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="FP.CompanyKpiValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style x:Key="FP.CompanyKpiCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FP.TextMuted}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="FP.FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="FP.SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="FP.StatusActive" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FP.SuccessSoft}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="9,4"/>
    </Style>

    <Style x:Key="FP.FilterTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="{DynamicResource FP.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="FP.DataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource FP.Surface}"/>
        <Setter Property="RowBackground" Value="{DynamicResource FP.Surface}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource FP.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource FP.Border}"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="RowHeight" Value="52"/>
        <Setter Property="ColumnHeaderHeight" Value="38"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template" Value="{StaticResource FP.DataGridWithFooter}"/>
        <Setter Property="common:DataGridPager.IsEnabled" Value="True"/>
        <Setter Property="common:DataGridPager.PageSize" Value="10"/>
    </Style>

    <Style x:Key="TituloModulo" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,4,0,4"/>
    </Style>

    <Style x:Key="TextoSecundario" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FP.TextMuted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Rotulo" TargetType="TextBlock" BasedOn="{StaticResource FP.FieldLabel}"/>
    <Style x:Key="Cartao" TargetType="Border" BasedOn="{StaticResource FP.Card}"/>
    <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource FP.PrimaryButton}"/>
    <Style x:Key="BotaoSecundario" TargetType="Button" BasedOn="{StaticResource FP.SecondaryButton}"/>

    <Style x:Key="KpiLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FP.TextMuted}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="KpiValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style x:Key="FP.FilterComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="{DynamicResource FP.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

</ResourceDictionary>
