<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- FinancePro UI Framework: reusable visual primitives. -->

    <Style x:Key="FPPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TealDarkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FPPageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource GrayTextBrush}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="FPSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TealDarkBrush}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="FPFormLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource GrayTextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <Style x:Key="FPCard" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TealLightBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Margin" Value="0,0,12,12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.10"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FPToolbar" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TealLightBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,0,0,12"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <Style x:Key="FPPrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="FPSecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{DynamicResource TealDarkBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TealLightBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="FPDangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="#C62828"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="FPToolbarButton" TargetType="Button" BasedOn="{StaticResource FPSecondaryButton}">
        <Setter Property="MinWidth" Value="82"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="FPTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Foreground" Value="#1F2937"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TealDarkBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource TealLightBrush}"/>
    </Style>

    <Style x:Key="FPPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Foreground" Value="#1F2937"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TealDarkBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource TealLightBrush}"/>
    </Style>

    <Style x:Key="FPComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Foreground" Value="#1F2937"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D1DCE8"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="FPDataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="MinRowHeight" Value="36"/>
    </Style>

    <Style x:Key="FPStatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource GrayTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FPErrorText" TargetType="TextBlock" BasedOn="{StaticResource FPStatusText}">
        <Setter Property="Foreground" Value="#C62828"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="FPSuccessText" TargetType="TextBlock" BasedOn="{StaticResource FPStatusText}">
        <Setter Property="Foreground" Value="#2E7D32"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Compatibilidade de nomenclatura para Views que usam chaves FP.* -->
    <Style x:Key="FP.PageTitle"
           TargetType="TextBlock"
           BasedOn="{StaticResource FPPageTitle}"/>

    <Style x:Key="FP.PageSubtitle"
           TargetType="TextBlock"
           BasedOn="{StaticResource FPPageSubtitle}"/>

</ResourceDictionary>
